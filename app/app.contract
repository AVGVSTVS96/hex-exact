// hex Exact: the hex voice app, rebuilt in Exact. The Swift shell around it (shell/) holds the live
// call, Siri and the Live Activity; this root holds everything the screens read and write, as
// Exact asks: every resource, mutation and the actions that send them live here, and each screen,
// in its own file, takes what it shows as props. A screen gets data by adding a prop, not a source.
use CallRow, Viewport, Pose, Delivery, Time, CallState, Captions, Activity, Counts, Calls, CallRecord, Tasks, Asks, TaskPage, Chat, Check, Words, Settings, Sent, Reply, Build, Page, Media, Attached, PhonePrefs from "./shapes.contract"
use Home, CallDock, CallWords, linesOf, isElsewhere from "./call.contract"
use CallsList from "./calls.contract"
use PastCall from "./past-call.contract"
use TasksList from "./tasks.contract"
use TaskScreen, TaskBody from "./task.contract"
use Thread from "./thread.contract"
use Steps from "./steps.contract"
use Picks from "./picks.contract"
use Pick from "./pick.contract"
use LastCheck from "./last-check.contract"
use SettingsScreen from "./settings.contract"
use VoicePage from "./voice.contract"
use YourWords from "./words.contract"
use UpdateToast from "./toast.contract"
use stageTopics, entriesOf, homeOf, pageOf from "./inbox.contract"
use Said, Sending, saidLine, saidOf, sendingLine, sendingOf, field, saidFor, withSaid, settledLines from "./said.contract"

// Every screen and sheet. Home is the call; the rest open over it. hexexact://go/<path> opens any
// of them from outside (Siri, scripts/sim).
routes nav
  home "/"
    calls "/calls"
      pastCall "/calls/:id"
    tasks "/tasks"
      task "/tasks/t/:id"
        thread "/tasks/t/:id/messages"
        steps "/tasks/t/:id/steps"
      picks "/tasks/picks"
        pick "/tasks/picks/:id"
      check "/tasks/check"
    settings "/settings"
      voice "/settings/voice"
        words "/settings/voice/words"

component App
  // Bassim's choices on this phone, kept across launches (hex keeps voice, personality, pace and
  // words for every call; the voice is also here so a call can start before hex answers).
  state voice = "marin" persist
  state persona = "opal" persist
  state personaColor = "" persist
  state opalPalette = "original" persist
  state reaction = "subtle" persist
  state sounds = true persist
  state haptics = true persist
  // The build Bassim said "Not now" to; the toast comes back for the next one.
  state skippedBuild = 0 persist
  // The Tasks tab: all | needs | working | done | quiet ("" until Bassim picks one: Needs if anything
  // needs him, else Working).
  state tab = ""
  // The answer on its way from a question: `${askId}|${label}`.
  state answering = ""
  // The page beside the Tasks list when it's wide; "" until Bassim picks one (the first topic).
  state beside = ""
  // What Bassim did with each question and message here, as said.contract's lines, so screens show
  // it at once and say how it went.
  state said = [""].slice(0, 0)
  state sends = [""].slice(0, 0)
  // hex's picks as Bassim leaves them before answering them all: `${askId}\t${label}`, "" for later.
  state picked = [""].slice(0, 0)
  // Unsent words, kept across launches: `${key}\t${text}`, key `thread:<task>` or `ask:<id>`.
  state drafts = [""].slice(0, 0) persist
  state removing = ""
  // Photos and videos added to one composer (attachedTo: `ask:<id>` or `thread:<id>`), uploaded,
  // waiting to go with its next send.
  state attached = [Media(id="", kind="", aspect=0)].slice(0, 0)
  state attachedTo = ""
  // Why the last photo or video added to a composer didn't arrive.
  state addError = ""
  // The live call and what was last tried in it (talk | share), so the call says if it didn't go.
  state tried = ""
  // Apps a link out found missing on this phone, and the one being opened now.
  state missing = [""].slice(0, 0)
  state opening = ""
  // The ask whose original message is open ("From <place>"), read from hex while it is.
  state wordsAsk = ""
  // The live call's agents: those running at hex's last word, and the one that just finished, shown
  // for a moment on the agent line.
  state agentsRunning = [""].slice(0, 0)
  state agentDone = ""
  // On a phone and the cover screen: the call's words pulled up to read, the orb docked.
  state reading = false
  // On a book fold with Tasks open during a call: the call's words on the left screen, beside the page.
  state besideWords = false
  // Milliseconds since launch, a minute at a time: "Today", "3 min ago" and the like move on.
  state tick = 0

  resource viewport = exactViewport() as shape Viewport
  resource pose = devicePose() as shape Pose else empty()
  resource clock = exactTime() as shape Time

  // The live call, as the shell holds it, and its words. These follow the shell, not a timer.
  resource call = callState() as shape CallState else empty()
  resource captions = captions() as shape Captions else empty()

  // hex, kept current: each holds a request open until hex changes (Exact's long poll).
  resource activity = watchActivity() as shape Activity else empty()
  resource liveCounts = watchCounts() as shape Counts else empty()
  resource liveCalls = watchCalls() as shape Calls else empty()
  resource liveTasks = watchTasks() as shape Tasks else empty()
  resource liveAsks = watchAsks() as shape Asks else empty()
  // The same lists kept on the phone: read once at launch, shown until hex answers, and written
  // each time hex changes them.
  resource keptCounts = keptCounts() as shape Counts else empty()
  resource keptCalls = keptCalls() as shape Calls else empty()
  resource keptTasks = keptTasks() as shape Tasks else empty()
  resource keptAsks = keptAsks() as shape Asks else empty()
  derive counts = current(liveCounts) ? liveCounts : keptCounts
  derive calls = liveCalls.version > 0 ? liveCalls : keptCalls
  derive tasks = liveTasks.version > 0 ? liveTasks : keptTasks
  derive asks = liveAsks.version > 0 ? liveAsks : keptAsks
  resource keepingCounts = keep("/tasks/summary", `${liveCounts.needs} ${liveCounts.working} ${liveCounts.yours}`) when current(liveCounts) as shape Reply else empty()
  resource keepingCalls = keep("/calls", `${liveCalls.version}`) when liveCalls.version > 0 as shape Reply else empty()
  resource keepingTasks = keep("/tasks", `${liveTasks.version}`) when liveTasks.version > 0 as shape Reply else empty()
  resource keepingAsks = keep("/asks", `${liveAsks.version}`) when liveAsks.version > 0 as shape Reply else empty()

  // The newest build on the install link, for the update toast, asked again each time the app
  // comes to the front.
  resource page = exactPage() as shape Page
  resource build = checkBuild() when page.visibilityState == "visible" as shape Build else empty()
  // A new screen waits until the app is put away with no call on, so nothing changes under Bassim's
  // hands mid-call or mid-typing.
  resource delivery = exactDelivery() as shape Delivery
  task update when delivery.staged and page.visibilityState == "hidden" and call.status == "idle" key=delivery.seq
    change(applyUpdate)
  action applyUpdate
    deliveryActivate()

  // What the open screens show; asked only while they are open.
  derive names = stack(nav).map(e => e.name)
  derive pastId = match stack(nav).filter(e => e.name == "pastCall").at(-1) { case some(e) => e.params.id, case none => "" }
  derive pastLive = calls.live != "" and pastId == calls.live
  // Tasks beside a page: the Duo opened like a book, or a window wide enough for both.
  derive split = viewport.horizontalViewportSegments == 2 or viewport.width >= 900
  derive firstPage = match stageTopics(entriesOf(tasks, asks, now), shownTab).at(0) { case some(t) => homeOf(pageOf(t), tasks.tasks), case none => "" }
  derive besideId = split and names.includes("tasks") ? (beside != "" ? beside : firstPage) : ""
  derive taskId = match stack(nav).filter(e => e.name == "task").at(-1) { case some(e) => e.params.id, case none => besideId }
  derive chatOpen = names.includes("thread") or names.includes("task") or besideId != ""
  resource record = loadCall(pastId, pastLive) when pastId != "" as shape CallRecord else empty()
  // A topic (`topic:<name>`) or a finished item (`done:<id>`) opens a page made from the lists.
  derive threadId = taskId.startsWith("topic:") or taskId.startsWith("done:") ? "" : taskId
  resource task = watchTask(threadId) when threadId != "" as shape TaskPage else empty()
  resource chat = watchChat(threadId) when threadId != "" and chatOpen as shape Chat else empty()
  resource check = loadCheck() when names.includes("check") as shape Check else empty()
  resource settings = loadSettings() when names.includes("settings") as shape Settings else empty()
  // The message an ask came from: the pick on top of the screen, else the one opened on a card.
  derive pickId = match stack(nav).filter(e => e.name == "pick").at(-1) { case some(e) => e.params.id, case none => "" }
  derive wordsId = top(nav).name == "pick" ? pickId : wordsAsk
  resource words = loadWords(wordsId) when wordsId != "" as shape Words else empty()

  // Writes. Each says how it went in its slot; a screen reads `pending(x)` and the reply.
  mutation commanded as shape Reply
  mutation shared as shape Reply
  mutation retried as shape Reply
  mutation added as shape Attached then gotMedia
  mutation answered as shape Sent queue then settle
  mutation answeredAll as shape Reply queue then settleAll
  mutation noted as shape Sent queue then settleNote
  mutation dismissed as shape Sent queue then settleDismiss
  mutation undone as shape Sent queue then settleUndo
  mutation acted as shape Sent queue then settleAct
  mutation marked as shape Sent queue then settleRead
  mutation talked as shape Reply
  mutation messaged as shape Reply queue then settleMessage
  mutation stopped as shape Sent
  mutation removed as shape Reply queue
  mutation previewed as shape Reply
  mutation saved as shape Reply queue refreshes settings

  derive place = top(nav)
  derive needsYou = counts.yours
  // hexexact://go/tasks?stage=working opens Tasks on a stage; hexexact://go/?update=demo shows the
  // update toast with a made-up build.
  derive linkStage = match stack(nav).filter(e => e.name == "tasks").at(0) { case some(e) => searchParam(e, "stage"), case none => "" }
  derive demoUpdate = match stack(nav).at(0) { case some(e) => searchParam(e, "update") == "demo", case none => false }
  derive shownTab = tab != "" ? tab : linkStage != "" ? linkStage : (needsYou > 0 ? "needs" : "working")
  derive now = clock.epochAtZero + tick
  // Nothing attached: what a send carries until the camera and Photos attach media ids from POST /media.
  derive noMedia = [""].slice(0, 0)
  // What the shell keeps of the phone's choices: the call's sounds and haptics, its Live Activity's orb.
  derive phone = PhonePrefs(sounds=sounds, haptics=haptics, persona=persona, personaColor=personaColor, palette=opalPalette)
  // The live call's record, here or elsewhere (a phone call): hex muting itself, and a call held
  // elsewhere's words and clock.
  derive liveId = call.status != "idle" and call.id != "" and not call.demo ? call.id : (call.status == "idle" ? activity.call : "")
  resource liveRecord = loadCall(liveId, true) when liveId != "" as shape CallRecord else empty()
  // What didn't go, said where it was tried: in the call, under a thread's composer.
  derive talkTrouble = pending(talked) ? "" : match talked { case some(r) => r.ok ? "" : `Not sent · ${r.error}`, case none => "" }
  derive shareTrouble = pending(shared) ? "" : match shared { case some(r) => r.ok ? "" : `Not shared · ${r.error}`, case none => "" }
  derive trouble = call.status != "live" ? "" : tried == `${call.id}|talk` ? talkTrouble : tried == `${call.id}|share` ? shareTrouble : ""
  derive stopFailed = pending(stopped) ? "" : match stopped { case some(r) => r.ok ? "" : r.id, case none => "" }
  derive stopWords = pending(stopped) ? "" : match stopped { case some(r) => r.ok ? "" : `Not stopped · ${r.error}`, case none => "" }
  // The call that just ended here, listed at once, as hex will list it once it has saved it.
  derive endedHere = call.status == "idle" and call.ending != "" and call.ending != "no-connect" and captions.call != "" and captions.call != "demo" and calls.calls.filter(c => c.id == captions.call).length == 0
  derive firstWords = match captions.turns.at(0) { case some(t) => t.at, case none => 0 }
  derive heard = match captions.turns.filter(t => t.who == "you" and t.text != "").at(0) { case some(t) => t.text.trim().slice(0, 160), case none => "" }
  derive callsShown = endedHere ? Calls(calls, calls=[CallRow(id=captions.call, started=firstWords, ended=firstWords + call.seconds * 1000, ending=call.ending, source="app", voice=voice, title="", why="", summary="", waiting=[], seconds=call.seconds, tasks=0, preview=heard, live=false)].concat(calls.calls)) : calls
  // A call on, here or held elsewhere, and a Duo pose with a side column or a band for it.
  derive callOn = call.status != "idle" or isElsewhere(call, activity, liveRecord)
  derive duo = (pose.bar != "" and (viewport.safeAreaLeft > 0 or viewport.safeAreaRight > 0)) or viewport.horizontalViewportSegments == 2 or viewport.verticalViewportSegments == 2
  derive removeError = pending(removed) ? "" : match removed { case some(r) => r.error, case none => "" }

  task minute mount
    every(60000, ticked)
  action ticked
    tick = performanceNow()

  // An agent of the call finishing: its line says done or failed for 2.4 s, with a soft tap.
  task agents key=activity.version
    change(noticeAgents)
  task agentHold when agentDone != "" key=agentDone
    after(2400, letAgentGo)
  action noticeAgents
    match activity.tasks.filter(t => t.state != "running" and agentsRunning.includes(t.id)).at(0)
      case some(t)
        agentDone = t.id
        if haptics
          haptic("impact-soft")
      case none
        agentDone = activity.call == "" ? "" : agentDone
    agentsRunning = activity.tasks.filter(t => t.state == "running").map(t => t.id)
  action letAgentGo
    agentDone = ""

  // A question hex puts on screen brings the words up; a call that ends puts them away, so its
  // wrap-up shows under the orb.
  task askArrives when call.status == "live" and activity.asks.length > 0 key=activity.asks.length
    change(bringWords)
  task callEnds when call.status == "idle" key=call.ending
    change(restWords)
  action bringWords
    reading = true
  action restWords
    reading = false
  action toggleBeside
    besideWords = not besideWords
  action setReading(on: bool)
    reading = on
    if haptics
      haptic("selection")

  // Places
  action follow(url: string)
    nav = go(nav, url)
  action back
    nav = back(nav)
  // Out to the app a thread lives in; the hidden "opened" field hears whether it opened.
  action openOut(link: string, app: string)
    opening = app
    if haptics
      haptic("selection")
    openURL(link, "opened")
  action heardOpen(v: string)
    missing = missing.filter(a => a != opening).concat(v == "failed" ? [opening] : [])
  // Esc closes Tasks, whatever page of it is open.
  action pressed(k: string, e: KeyboardEvent)
    if k == "Escape" and names.includes("tasks")
      nav = go(nav, "/")
  action home
    nav = go(nav, "/")
  action open(location: string)
    nav = push(nav, location)
  action openTasks(t: string)
    tab = t
    nav = go(nav, path("tasks"))
  action openTask(id: string)
    nav = go(nav, path("task", id))
  action besidePage(page: string)
    beside = page
    if haptics
      haptic("selection")
  action pickTab(t: string)
    tab = t
    if haptics
      haptic("selection")

  // The call
  action startCall(about: string)
    send commanded = callCommand("start", voice, about, phone)
  action toggleMute
    send commanded = callCommand("mute", "", "", phone)
  action endCall
    send commanded = callCommand("end", "", "", phone)
  // A call held elsewhere (a phone call), ended from here.
  action hangUpElsewhere(id: string)
    send commanded = hangUp(id)
  // A photo or video into the live call; one that didn't arrive, again.
  action share(source: string)
    tried = `${call.id}|share`
    send shared = shareMedia(source)
  action reshare(key: string)
    send retried = retryShare(key)
  // Photos and videos for a composer, kept until it sends (at most four).
  action attach(to: string, source: string)
    attached = attachedTo == to ? attached : attached.slice(0, 0)
    attachedTo = to
    addError = ""
    send added = attachMedia(source, 4 - (attachedTo == to ? attached.length : 0))
  action gotMedia
    match added
      case some(r)
        attached = attached.concat(r.media).slice(0, 4)
        addError = r.ok ? "" : r.error
      case none
        attached = attached
  action detach(id: string)
    attached = attached.filter(m => m.id != id)
  // Bring a task ("asks": everything that waits) into the live call, or start one about it.
  action talk(about: string)
    if call.status == "live"
      tried = `${call.id}|talk`
      send talked = talkAbout(about)
    else
      send commanded = callCommand("start", voice, about, phone)

  // Asks
  derive saids = said.map(l => saidOf(l))
  // Every question on screen: the lists' and the live call's.
  derive allAsks = asks.asks.concat(activity.asks.map(c => c.ask))
  action answer(id: string, label: string)
    answering = `${id}|${label}`
    said = withSaid(said, saidFor(allAsks, id, "answer", label))
    if haptics
      haptic("selection")
    send answered = answerAsk(id, label == "" ? [] : [label], (attachedTo == `ask:${id}` ? attached.map(m => m.id) : noMedia))
    attached = attachedTo == `ask:${id}` ? attached.slice(0, 0) : attached
  action answerMany(id: string, labels: string[])
    answering = `${id}|${labels.join(", ")}`
    said = withSaid(said, saidFor(allAsks, id, "answers", labels.join(", ")))
    if haptics
      haptic("selection")
    send answered = answerAsk(id, labels, noMedia)
  // hex's picks, all at once: each ask with its answer, in order.
  action answerAll(ids: string[], labels: string[])
    said = said.filter(l => not ids.includes(field(l, 0))).concat(range(ids.length).map(i => saidLine(saidFor(allAsks, match ids.at(i) { case some(x) => x, case none => "" }, "answer", match labels.at(i) { case some(x) => x, case none => "" }))))
    picked = [""].slice(0, 0)
    if haptics
      haptic("success")
    send answeredAll = answerPicks(ids, labels)
  action note(id: string, words: string)
    said = withSaid(said, saidFor(allAsks, id, "note", words))
    send noted = noteAsk(id, words, (attachedTo == `ask:${id}` ? attached.map(m => m.id) : noMedia))
    attached = attachedTo == `ask:${id}` ? attached.slice(0, 0) : attached
  action dismiss(id: string)
    said = withSaid(said, saidFor(allAsks, id, "dismiss", "Not needed"))
    if haptics
      haptic("selection")
    send dismissed = dismissAsk(id)
  action undo(id: string)
    said = said.filter(l => field(l, 0) != id)
    send undone = undoAsk(id)
  // Answer again where a place was out of reach: one label as it was, several (verb "answers") as
  // they were joined.
  action again(id: string)
    match saids.filter(s => s.id == id).at(-1)
      case some(s)
        said = withSaid(said, saidFor(allAsks, id, s.verb, s.label))
        if s.verb == "dismiss"
          send dismissed = dismissAsk(id)
        else
          send answered = answerAsk(id, (s.verb == "answers" ? s.label.split(", ") : [s.label]), noMedia)
      case none
        said = said
  action settle
    match answered
      case some(r)
        said = settledLines(said, r)
        answering = answering.startsWith(`${r.id}|`) ? "" : answering
      case none
        said = said
  action settleDismiss
    match dismissed
      case some(r)
        said = settledLines(said, r)
      case none
        said = said
  action settleNote
    match noted
      case some(r)
        said = settledLines(said, r)
      case none
        said = said
  action settleUndo
    match undone
      case some(r)
        if not r.ok
          said = said.concat([saidLine(Said(id=r.id, verb="undo", label="", status="failed", detail=r.error, missed=0, question="", topic="", task=""))])
      case none
        said = said
  action settleAll
    match answeredAll
      case some(r)
        if not r.ok
          said = said.map(l => field(l, 3) == "sending" ? saidLine(Said(saidOf(l), status="failed", detail=r.error)) : l)
        else
          said = said.map(l => field(l, 3) == "sending" ? saidLine(Said(saidOf(l), status="sent")) : l)
      case none
        said = said
  action pick(id: string, label: string)
    picked = picked.filter(l => field(l, 0) != id).concat([`${id}\t${label}`])
    if haptics
      haptic("selection")
  action keepDraft(key: string, text: string)
    drafts = drafts.filter(l => field(l, 0) != key).concat(text == "" ? [] : [`${key}\t${text.replaceAll("\t", " ")}`])
  action showWords(id: string)
    wordsAsk = wordsAsk == id ? "" : id
  // A stuck run's action and a fresh result's Read: only a failure is kept, under its row.
  action act(id: string)
    said = said.filter(l => field(l, 0) != id or field(l, 3) != "failed")
    send acted = actStuck(id)
  action markRead(id: string)
    said = said.filter(l => field(l, 0) != id or field(l, 3) != "failed")
    send marked = readFresh(id)
  action settleAct
    match acted
      case some(r)
        if not r.ok
          said = said.concat([saidLine(Said(id=r.id, verb="act", label="", status="failed", detail=r.error, missed=0, question="", topic="", task=""))])
      case none
        said = said
  action settleRead
    match marked
      case some(r)
        if not r.ok
          said = said.concat([saidLine(Said(id=r.id, verb="read", label="", status="failed", detail=r.error, missed=0, question="", topic="", task=""))])
      case none
        said = said

  // Threads
  action message(id: string, words: string)
    let key = `app-${round(clock.epochAtZero + performanceNow())}`
    sends = sends.slice(-30).concat([sendingLine(Sending(task=id, key=key, text=words, status="sending", error="", media=(attachedTo == `thread:${id}` ? attached : attached.slice(0, 0))))])
    drafts = drafts.filter(l => field(l, 0) != `thread:${id}`)
    send messaged = sendChat(id, words, key, (attachedTo == `thread:${id}` ? attached.map(m => m.id) : noMedia))
    attached = attachedTo == `thread:${id}` ? attached.slice(0, 0) : attached
  // Try a message again with its own key, so hex doesn't take it twice.
  action resend(key: string)
    match sends.map(l => sendingOf(l)).filter(s => s.key == key).at(0)
      case some(s)
        sends = sends.map(l => field(l, 1) == key ? sendingLine(Sending(s, status="sending", error="")) : l)
        send messaged = sendChat(s.task, s.text, key, s.media.map(m => m.id))
      case none
        sends = sends
  action settleMessage
    match messaged
      case some(r)
        let first = sends.map(l => field(l, 3)).indexOf("sending")
        sends = range(sends.length).map(i => i == first ? sendingLine(Sending(sendingOf(match sends.at(i) { case some(l) => l, case none => "" }), status=(r.ok ? "sent" : "failed"), error=r.error)) : match sends.at(i) { case some(l) => l, case none => "" })
      case none
        sends = sends
  action stop(id: string)
    send stopped = stopTask(id)

  // Calls
  action removeCall(id: string)
    removing = id
    if haptics
      haptic("impact-medium")
    send removed = removeCall(id)

  // Settings, on hex (voice, personality, pace, words) and on this phone
  action setSetting(field: string, value: string)
    if field == "voice"
      voice = value
    send saved = saveSetting(field, value)
  action previewVoice(id: string)
    send previewed = callCommand("preview", id, "", phone)
  action setPersona(p: string)
    persona = p
  action setPersonaColor(c: string)
    personaColor = c
  action setReaction(r: string)
    reaction = r
  action setSounds(on: bool)
    sounds = on
  action setHaptics(on: bool)
    haptics = on
  action setOpalPalette(p: string)
    opalPalette = p
  action skipBuild(n: number)
    skippedBuild = n

  // The voice is hex's, for every call: the phone follows it, and gives hex its own when hex has none.
  task voiceFromHex when not pending(saved) and settings.voice != "" and settings.voice != voice key=settings.voice
    after(1, takeVoice)
  task voiceToHex when current(settings) and settings.voice == "" key=voice
    after(1, giveVoice)
  action takeVoice
    voice = settings.voice
  action giveVoice
    send saved = saveSetting("voice", voice)

  // The Haptics switch, for every screen's taps.
  provide
    haptics
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow key=pressed width="100%" height="100%" testId="app"
      for e in stack(nav) key=e.id
        if e.name == "home"
          Home(entry=e, viewport=viewport, now=now, call=call, captions=captions, activity=activity, counts=counts, calls=callsShown, liveRecord=liveRecord, persona=persona, personaColor=(personaColor == "" ? "#FFFFFF" : personaColor), palette=(opalPalette == "original" ? "" : opalPalette), reaction=reaction, haptics=haptics, start=startCall(""), mute=toggleMute, end=endCall, hangUp=hangUpElsewhere, leaving=pending(commanded), share=share, reshare=reshare, open=open, openTasks=openTasks, openTask=openTask, answer=answer, answerMany=answerMany, said=saids, finished=agentDone, pose=pose, reading=reading, setReading=setReading, trouble=trouble)
        if e.name == "calls"
          CallsList(entry=e, viewport=viewport, now=now, offset=clock.utcOffset, calls=callsShown, loading=(not current(liveCalls)), failed=failed(liveCalls), open=open, remove=removeCall, removing=removing, removeError=removeError, back=back)
        if e.name == "pastCall"
          PastCall(entry=e, viewport=viewport, now=now, offset=clock.utcOffset, record=record, loading=(not current(record)), failed=failed(record), live=pastLive, onCall=(call.status != "idle" and not pastLive), openTasks=openTasks, open=open, remove=removeCall, home=home, back=back)
        if e.name == "tasks"
          TasksList(entry=e, viewport=viewport, now=now, offset=clock.utcOffset, tab=shownTab, pickTab=pickTab, tasks=tasks, asks=asks, counts=counts, loading=(not current(liveTasks) or not current(liveAsks)), failed=(failed(liveTasks) or failed(liveAsks)), inCall=(call.status == "live"), open=open, openTask=openTask, answer=answer, answerMany=answerMany, dismiss=dismiss, undo=undo, act=act, markRead=markRead, talk=talk, answering=answering, said=saids, again=again, split=split, beside=besideId, select=besidePage, back=back)
            TaskBody(id=besideId, pane=true, entry=e, viewport=viewport, now=now, offset=clock.utcOffset, task=task, chat=chat, asks=asks, tasks=tasks, said=saids, drafts=drafts, words=words, wordsAsk=wordsAsk, loading=(not current(task)), failed=failed(task), inCall=(call.status == "live"), open=open, openTask=openTask, answer=answer, answerMany=answerMany, note=note, dismiss=dismiss, undo=undo, again=again, act=act, markRead=markRead, showWords=showWords, keepDraft=keepDraft, talk=talk, message=message, answering=answering, attached=attached, attachedTo=attachedTo, addError=addError, missing=missing, openOut=openOut, attach=attach, detach=detach, back=back)
        if e.name == "task"
          TaskScreen(entry=e, viewport=viewport, now=now, offset=clock.utcOffset, task=task, chat=chat, asks=asks, tasks=tasks, said=saids, drafts=drafts, words=words, wordsAsk=wordsAsk, loading=(not current(task)), failed=failed(task), inCall=(call.status == "live"), open=open, openTask=openTask, answer=answer, answerMany=answerMany, note=note, dismiss=dismiss, undo=undo, again=again, act=act, markRead=markRead, showWords=showWords, keepDraft=keepDraft, talk=talk, message=message, answering=answering, attached=attached, attachedTo=attachedTo, addError=addError, missing=missing, openOut=openOut, attach=attach, detach=detach, back=back)
        if e.name == "thread"
          Thread(entry=e, viewport=viewport, now=now, offset=clock.utcOffset, task=task, chat=chat, sends=sends.map(l => sendingOf(l)), drafts=drafts, keepDraft=keepDraft, resend=resend, loading=(not current(chat)), failed=failed(chat), sending=(pending(messaged)), message=message, stop=stop, attached=(attachedTo == `thread:${task.id}` ? attached : attached.slice(0, 0)), addError=(attachedTo == `thread:${task.id}` ? addError : ""), stopError=(stopFailed == task.id ? stopWords : ""), missing=missing, openOut=openOut, attach=attach, detach=detach, talk=talk, inCall=(call.status == "live"), open=open, back=back)
        if e.name == "steps"
          Steps(entry=e, viewport=viewport, now=now, offset=clock.utcOffset, task=task, loading=(not current(task)), failed=failed(task), back=back)
        if e.name == "picks"
          Picks(entry=e, viewport=viewport, asks=asks, said=saids, picked=picked, open=open, answerAll=answerAll, back=back)
        if e.name == "pick"
          Pick(entry=e, viewport=viewport, now=now, offset=clock.utcOffset, asks=asks, picked=picked, words=words, wordsAsk=wordsId, showWords=showWords, pick=pick, open=open, back=back)
        if e.name == "check"
          LastCheck(entry=e, viewport=viewport, now=now, offset=clock.utcOffset, check=check, loading=(not current(check)), failed=failed(check), back=back)
        if e.name == "settings"
          SettingsScreen(entry=e, viewport=viewport, settings=settings, voice=voice, persona=persona, personaColor=personaColor, opalPalette=opalPalette, reaction=reaction, sounds=sounds, haptics=haptics, setPersona=setPersona, setPersonaColor=setPersonaColor, setOpalPalette=setOpalPalette, setReaction=setReaction, setSounds=setSounds, setHaptics=setHaptics, open=open, back=back)
        if e.name == "voice"
          VoicePage(entry=e, viewport=viewport, settings=settings, voice=voice, inCall=(call.status != "idle"), loading=(not current(settings)), failed=failed(settings), unsaved=(not pending(saved) and (failed(saved) or match saved { case some(r) => not r.ok, case none => false })), set=setSetting, preview=previewVoice, open=open, back=back)
        if e.name == "words"
          YourWords(entry=e, words=settings.words, set=setSetting, back=back)
      input id="opened" display="none" change=heardOpen
      // Over Tasks, Calls and Settings on the Duo during a call: the call, docked in the side column
      // or the band; on a book fold, its words beside Tasks' page.
      if callOn and place.name != "home" and duo
        if besideWords and viewport.horizontalViewportSegments == 2 and names.includes("tasks")
          column position="absolute" top=0 bottom=0 left=0 width="env(viewport-segment-width 0 0)" padding-top=(viewport.safeAreaTop + 12) padding-bottom=(max(viewport.safeAreaBottom, 12) + 12) background-color="-exact-background" z-index=19 testId="words-beside"
            CallWords(lines=linesOf(call, captions, activity, liveRecord, true), asks=activity.asks, said=saids, width=min(viewport.width / 2, 455), live=true, answer=answer, answerMany=answerMany, openTask=openTask, reshare=reshare)
        CallDock(viewport=viewport, pose=pose, call=call, activity=activity, liveRecord=liveRecord, persona=persona, personaColor=(personaColor == "" ? "#FFFFFF" : personaColor), palette=(opalPalette == "original" ? "" : opalPalette), leaving=pending(commanded), tasksOpen=names.includes("tasks"), beside=besideWords, mute=toggleMute, end=endCall, hangUp=hangUpElsewhere, home=home, toggleBeside=toggleBeside)
      // Over every screen: a new build is on the install link. Keyed by whether the app is in front,
      // so coming back from an install that didn't happen offers it again.
      for v in [page.visibilityState] key=v
        UpdateToast(build=(demoUpdate ? Build(latest=max(build.running, 1) + 1, running=max(build.running, 1), install=(build.install != "" ? build.install : "demo")) : build), skipped=skippedBuild, visible=(page.visibilityState == "visible"), live=(call.status != "idle"), place=place.name, viewport=viewport, skip=skipBuild, end=endCall)
