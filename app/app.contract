          else
            TaskScreen(entry=e, room=room, clearTop=belowIn(viewport, pose, room.first), counts=counts, callOn=callOn, viewport=viewport, now=now, offset=clock.utcOffset, task=task, chat=chat, asks=asks, tasks=tasks, said=saids, drafts=drafts, words=words, wordsAsk=wordsAsk, loading=(not current(task)), failed=failed(task), inCall=(call.status == "live"), open=open, openTasks=openTasks, openTask=openTask, answer=answer, answerMany=answerMany, note=note, dismiss=dismiss, undo=undo, again=again, act=act, markRead=markRead, showWords=showWords, keepDraft=keepDraft, talk=talk, message=message, answering=answering, attached=attached, attachedTo=attachedTo, addError=addError, missing=missing, openOut=openOut, attach=attach, detach=detach, back=back)
        if e.name == "thread"
          Thread(entry=e, room=room, clearTop=belowIn(viewport, pose, room.first), counts=counts, callOn=callOn, openTasks=openTasks, viewport=viewport, now=now, offset=clock.utcOffset, task=task, chat=chat, sends=sends.map(l => sendingOf(l)), drafts=drafts, keepDraft=keepDraft, resend=resend, loading=(not current(chat)), failed=failed(chat), sending=(pending(messaged)), message=message, stop=stop, attached=(attachedTo == `thread:${task.id}` ? attached : attached.slice(0, 0)), addError=(attachedTo == `thread:${task.id}` ? addError : ""), stopError=(stopFailed == task.id ? stopWords : ""), missing=missing, openOut=openOut, attach=attach, detach=detach, talk=talk, inCall=(call.status == "live"), open=open, back=back)
            if split
              TaskBody(id=e.params.id, pane=true, room=room, clearTop=0, foot=(callOn ? room.foot + 64 + 12 : room.foot), entry=e, viewport=viewport, now=now, offset=clock.utcOffset, task=task, chat=chat, asks=asks, tasks=tasks, said=saids, drafts=drafts, words=words, wordsAsk=wordsAsk, loading=(not current(task)), failed=failed(task), inCall=(call.status == "live"), open=open, openTask=openTask, answer=answer, answerMany=answerMany, note=note, dismiss=dismiss, undo=undo, again=again, act=act, markRead=markRead, showWords=showWords, keepDraft=keepDraft, talk=talk, message=message, answering=answering, attached=attached, attachedTo=attachedTo, addError=addError, missing=missing, openOut=openOut, attach=attach, detach=detach, back=back)
        if e.name == "steps"
          Steps(entry=e, room=room, clearTop=belowIn(viewport, pose, room.first), counts=counts, callOn=callOn, viewport=viewport, now=now, offset=clock.utcOffset, task=task, loading=(not current(task)), failed=failed(task), open=open, openTasks=openTasks, back=back)
            if split
              TaskBody(id=e.params.id, pane=true, room=room, clearTop=0, foot=(callOn ? room.foot + 64 + 12 : room.foot), entry=e, viewport=viewport, now=now, offset=clock.utcOffset, task=task, chat=chat, asks=asks, tasks=tasks, said=saids, drafts=drafts, words=words, wordsAsk=wordsAsk, loading=(not current(task)), failed=failed(task), inCall=(call.status == "live"), open=open, openTask=openTask, answer=answer, answerMany=answerMany, note=note, dismiss=dismiss, undo=undo, again=again, act=act, markRead=markRead, showWords=showWords, keepDraft=keepDraft, talk=talk, message=message, answering=answering, attached=attached, attachedTo=attachedTo, addError=addError, missing=missing, openOut=openOut, attach=attach, detach=detach, back=back)
        if e.name == "picks"
          Picks(entry=e, viewport=viewport, room=room, needsYou=counts.yours, working=counts.working, openTasks=openTasks, asks=asks, said=saids, picked=picked, now=now, offset=clock.utcOffset, words=words, wordsAsk=wordsId, pick=pick, open=open, answerAll=answerAll, back=back)
        if e.name == "pick"
          Pick(entry=e, viewport=viewport, room=room, needsYou=counts.yours, working=counts.working, openTasks=openTasks, now=now, offset=clock.utcOffset, asks=asks, picked=picked, words=words, wordsAsk=wordsId, showWords=showWords, pick=pick, open=open, back=back)
        if e.name == "check"
          LastCheck(entry=e, viewport=viewport, room=room, needsYou=counts.yours, working=counts.working, open=open, openTasks=openTasks, now=now, offset=clock.utcOffset, check=check, loading=(not current(check)), failed=failed(check), back=back)
        if e.name == "settings"
          SettingsScreen(entry=e, room=room, settings=settings, counts=counts, voice=voice, persona=persona, personaColor=personaColor, opalPalette=opalPalette, reaction=reaction, sounds=sounds, still=still, docked=callOn, setPersona=setPersona, setPersonaColor=setPersonaColor, setOpalPalette=setOpalPalette, setReaction=setReaction, setSounds=setSounds, setHaptics=setHaptics, preview=previewVoice, open=open, openTasks=openTasks, back=back)
        if e.name == "voice"
          VoicePage(entry=e, room=room, settings=settings, counts=counts, voice=voice, inCall=(call.status != "idle"), docked=callOn, loading=(not current(settings)), failed=failed(settings), unsaved=(not pending(saved) and (failed(saved) or match saved { case some(r) => not r.ok, case none => false })), set=setSetting, preview=previewVoice, open=open, openTasks=openTasks, back=back)
        if e.name == "words"
          YourWords(entry=e, room=room, counts=counts, words=settings.words, set=setSetting, open=open, openTasks=openTasks, back=back)
      input id="opened" display="none" change=heardOpen
      // Over every page during a call: the call, docked at the foot; with two columns, its words
      // beside Tasks' page.
      if callOn and place.name != "home"
        if besideWords and room.columns == 2 and names.includes("tasks")
          column position="absolute" top=0 bottom=0 left=0 width=(room.first.x + room.first.width) padding-top=(room.below) padding-left=room.first.x padding-bottom=(room.foot + 76) box-sizing="border-box" background-color="-exact-background" z-index=19 testId="words-beside"
            CallWords(lines=linesOf(call, captions, activity, liveRecord, true), asks=activity.asks, said=saids, width=room.first.width, live=true, answer=answer, answerMany=answerMany, openTask=openTask, reshare=reshare)
        CallDock(viewport=viewport, room=room, call=call, activity=activity, liveRecord=liveRecord, persona=persona, personaColor=(personaColor == "" ? "#FFFFFF" : personaColor), palette=(opalPalette == "original" ? "" : opalPalette), leaving=pending(commanded), tasksOpen=names.includes("tasks"), beside=besideWords, mute=toggleMute, end=endCall, hangUp=hangUpElsewhere, home=home, toggleBeside=toggleBeside)
      // On Home's chrome row: a new build is on the install link. Keyed by whether the app is in front,
      // so coming back from an install that didn't happen offers it again.
      for v in [page.visibilityState] key=v
        UpdateToast(build=offered, skipped=skippedBuild, visible=(page.visibilityState == "visible"), live=(call.status != "idle"), place=place.name, room=room, skip=skipBuild, end=endCall)
