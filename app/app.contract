        if e.name == "watch"
          WatchPage(entry=e, room=room, id=e.params.id, goals=goals, now=now, offset=clock.utcOffset, needsYou=counts.yours, working=counts.working, loading=(not current(liveGoals)), changes=goalChanges, change=changeGoal, undo=undoGoal, openTask=openTask, open=open, openTasks=openTasks, back=back)
        if e.name == "calls"
