// A question from hex (§9.3), flat on the page: no card and no box inside it. Which question it is
// and when, the question, what it's about in reading text, and "Why", which opens its whole
// background in one tap: the message it came from and why hex picks what it does. Then every
// answer as one kind of row, hex's pick marked in mint, and "Not needed" last. One tap answers: the
// row confirms in place with Undo and the rest stay where they are, so nothing jumps. His own
// words go in the reply box docked at the page's foot (ReplyComposer).
use Ask, Words, Media, Place from "./shapes.contract"
use Pictures, Thumb, AddMedia, Waiting, shapeOf, rowHeight from "./media.contract"
use Mark, PlaceTile, whenOf, springOf, PillTap, Tap, PillFace, Composer, ComposerField from "./parts.contract"
use Said, unreached, failedWords from "./said.contract"

fn questionWord(n: number, of: number): string = of > 1 ? `Question ${n} of ${of}` : "Question"

// One answer to a question, the same row everywhere a question shows: a ring (filled when chosen,
// mint for hex's pick), its words and what they mean, and "✦ hex’s pick" at its end.
component AnswerRow
  inject
    haptics: bool
  props
    label: string
    detail: string
    pick: bool
    chosen: bool
    // radio: one answer; check: one of several; "" for a row that only shows.
    role: string
    disabled: bool
    id: string
    press: action
  view
    button press=press disabled=disabled class=Tap display="flex" flex-direction="row" gap=12 align-items="center" padding="12px 0" border-bottom="0.5px solid -exact-separator" text-align="left" -exact-press-haptic=(haptics ? "selection" : "none") role=(role == "check" ? "checkbox" : role == "radio" ? "radio" : "button") aria-checked=chosen aria-label=(pick ? `${label}, hex’s pick` : label) testId=id
      box width=22 height=22 border-radius=11 flex-shrink=0 box-sizing="border-box" border=(chosen ? "none" : pick ? "1.5px solid hex.accent" : "1.5px solid -exact-tertiary-label") background-color=(chosen ? "AccentColor" : "transparent") display="flex" align-items="center" justify-content="center" aria-hidden=true
        if chosen
          image "symbol:checkmark" width=11 height=11 object-fit="contain" color="ink.on-accent"
      column flex=1 min-width=0 gap=2
        text label font="-exact-body" color="-exact-label"
        if detail != ""
          text detail font="-exact-subheadline" color="-exact-secondary-label"
      if pick
        text "✦ hex’s pick" font="-exact-footnote" font-weight=500 color="hex.accent" white-space="nowrap"

component AskCard
  inject
    haptics: bool
    still: bool
  props
    ask: Ask
    // Which of the page's questions this is, and how many it has.
    n: number
    of: number
    now: number
    offset: number
    said: Said
    draft: string
    words: Words
    wordsOpen: bool
    showWords: action
    answer: action
    answerMany: action
    dismiss: action
    undo: action
    again: action
    reply: action
    open: action
    width: number
  state chosen = [""].slice(0, 0)
  // What Bassim did with it here: answered (one label, several, or Not needed), on its way or sent.
  derive mine = said.id == ask.id and said.verb != "note" and said.verb != "undo"
  derive settled = mine and said.status != "failed"
  derive gone = settled and said.verb == "dismiss"
  derive picks = mine and said.verb == "answers" ? said.label.split(", ") : mine and said.verb == "answer" ? [said.label] : [""].slice(0, 0)
  // His own words as the answer: no row of the question says them, so they show as a row of their own.
  derive ownWords = mine and said.verb == "answer" and ask.options.filter(o => o.label == said.label).length == 0
  derive noted = said.id == ask.id and said.verb == "note" and said.status == "sent"
  derive shots = ask.options.filter(o => o.shot >= 0)
  // The screenshots side by side at their own shapes, 300 tall at most; past 140 they scroll.
  derive shotsTall = max(140, rowHeight(shots.map(o => Media(id="", kind="photo", aspect=o.aspect)), width, 300))
  derive place = match ask.places.at(0) { case some(p) => p, case none => Place(app=ask.app, place=ask.topic, task=ask.task, call="", link="") }
  derive from = place.place != "" ? place.place : ask.topic
  derive pickLabel = match ask.options.filter(o => o.pick).at(0) { case some(o) => o.label, case none => "" }
  // Where his answer went, or that it's on its way.
  derive status = said.status == "sending" ? "Sending…" : said.detail != "" ? `Sent to ${said.detail}` : "Sent"
  action choose(label: string)
    if ask.multiple
      chosen = chosen.includes(label) ? chosen.filter(c => c != label) : chosen.concat([label])
    else
      answer(ask.id, label)
  action takeBack
    chosen = [""].slice(0, 0)
    undo(ask.id)
  view
    column gap=10 padding="10px 0 14px" testId=`ask-card-${ask.id}`
      row gap=8 align-items="center" min-height=20
        box width=8 height=8 border-radius=4 background-color=(settled ? "-exact-tertiary-label" : "hex.ask") flex-shrink=0 aria-hidden=true
        text `${questionWord(n, of)}${ask.at > 0 ? ` · ${whenOf(ask.at, now, offset)}` : ""}` font="-exact-subheadline" color="-exact-secondary-label" font-variant-numeric="tabular-nums" line-clamp=1
        if ask.tag != ""
          text `· ${ask.tag}` font="-exact-subheadline" font-weight=600 color="hex.ask" white-space="nowrap"
      text ask.question font="-exact-title2" font-weight=700 role="heading" aria-level=2 user-select="text"
      if ask.context != ""
        text ask.context markup="markdown" font="-exact-body" color="-exact-label" user-select="text"
      if ask.pictures.length > 0
        Pictures(media=ask.pictures.map(p => Media(id=p.id, kind="photo", aspect=p.aspect)), width=width, height=300)
      button press=showWords(ask.id) class=Tap display="flex" flex-direction="row" gap=6 align-items="center" min-height=44 aria-expanded=wordsOpen aria-label=(wordsOpen ? "Why: hide the background" : `Why: the message from ${from}${pickLabel != "" and ask.why != "" ? " and why hex picks it" : ""}`) testId=`ask-from-${ask.id}`
        text "Why" font="-exact-subheadline" font-weight=600 color="-exact-label"
        text `· from ${from}${ask.at > 0 ? `, ${whenOf(ask.at, now, offset)}` : ""}` font="-exact-subheadline" color="-exact-secondary-label" line-clamp=1 flex-shrink=1
        image "symbol:sf/chevron.right" width=11 height=11 object-fit="contain" color="-exact-tertiary-label" rotate=(wordsOpen ? "90deg" : "0deg") transition=springOf(still, "rotate")
      if wordsOpen
        column gap=10 padding="0 0 4px 12px" border-left="2px solid -exact-separator" testId=`ask-why-${ask.id}`
          row gap=8 align-items="center"
            PlaceTile(place=place, size=22)
            text (words.place != "" ? words.place : from) font="-exact-subheadline" font-weight=600 color="-exact-label" flex=1 line-clamp=1
            if words.at > 0
              text whenOf(words.at, now, offset) font="-exact-footnote" color="-exact-tertiary-label" font-variant-numeric="tabular-nums"
          if words.text == ""
            progress aria-label="Loading the message"
          else
            text words.text markup="markdown" font="-exact-subheadline" color="-exact-secondary-label" user-select="text"
          if ask.why != "" and pickLabel != ""
            column gap=2
              text `✦ Why hex picks ${pickLabel}` font="-exact-subheadline" font-weight=600 color="hex.accent"
              text ask.why font="-exact-subheadline" color="-exact-secondary-label" user-select="text"
      if ask.links.length > 0
        row gap=16 flex-wrap="wrap"
          for l in ask.links key=l.url
            link href=l.url min-height=44 display="flex" flex-direction="row" align-items="center" gap=4 testId=`ask-link-${l.label}`
              text l.label font="-exact-subheadline" font-weight=600
              image "symbol:sf/arrow.up.right" width=11 height=11 object-fit="contain" color="-exact-secondary-label" aria-hidden=true
      if shots.length > 0
        scroll overflow-x="auto" overflow-y="hidden" scrollbar-width="none"
          row gap=10 padding="2px 0"
            for o in shots key=o.label
              column gap=6 align-items="center" width=(shotsTall * shapeOf(o.aspect)) flex-shrink=0
                Thumb(media=Media(id=`/asks/${encodeURIComponent(ask.id)}/shots/${o.shot}`, kind="photo", aspect=o.aspect), width=(shotsTall * shapeOf(o.aspect)), square=false)
                text o.label font="-exact-footnote" color="-exact-secondary-label" line-clamp=1
      column border-top="0.5px solid -exact-separator" role=(ask.multiple ? "group" : "radiogroup") aria-label="Answers"
        for o in ask.options key=o.label
          if mine and picks.includes(o.label)
            Confirmed(label=o.label, detail=status, failed=(said.status == "failed" ? failedWords(said) : ""), missed=said.missed, id=`ask-option-${ask.id}-${o.label}`, undo=takeBack, again=again(ask.id))
          else
            AnswerRow(label=o.label, detail=o.detail, pick=o.pick, chosen=chosen.includes(o.label), role=(ask.multiple ? "check" : "radio"), disabled=settled, id=`ask-option-${ask.id}-${o.label}`, press=choose(o.label))
        if ownWords
          Confirmed(label=said.label, detail=status, failed=(said.status == "failed" ? failedWords(said) : ""), missed=said.missed, id=`ask-own-${ask.id}`, undo=takeBack, again=again(ask.id))
        if mine and said.verb == "dismiss"
          Confirmed(label="Not needed", detail=(said.status == "sending" ? "Taking it off your list…" : "Off your list"), failed=(said.status == "failed" ? failedWords(said) : ""), missed=said.missed, id=`ask-dismiss-${ask.id}`, undo=takeBack, again=again(ask.id))
        else
          NotNeeded(disabled=settled, id=`ask-dismiss-${ask.id}`, press=dismiss(ask.id))
      if ask.multiple and not settled
        button press=answerMany(ask.id, chosen) buttonStyle="filled" disabled=(chosen.length == 0) min-height=44 testId=`ask-answer-${ask.id}`
          text (chosen.length == 0 ? "Check one or more" : `Answer with ${chosen.length}`)
      if noted
        text `Sent to ${said.detail != "" ? said.detail : ask.topic} as a note. The question is still open.` font="-exact-footnote" color="-exact-secondary-label"
      if said.id == ask.id and said.status == "failed" and (said.verb == "note" or said.verb == "undo")
        row gap=8 align-items="center" flex-wrap="wrap"
          text failedWords(said) font="-exact-footnote" color="hex.danger" flex=1 testId=`ask-failed-${ask.id}`
          if said.verb == "undo"
            button press=takeBack class=PillTap testId=`ask-retry-${ask.id}`
              box class=PillFace padding="4px 10px"
                text "Try again" font="-exact-footnote" font-weight=600

// An answer Bassim gave here, confirmed on its own row: a filled ring, what he said, where it went,
// and Undo; a failure says why under it, with Try again.
component Confirmed
  inject
    haptics: bool
  props
    label: string
    detail: string
    failed: string
    missed: number
    id: string
    undo: action
    again: action
  view
    column border-bottom="0.5px solid -exact-separator" testId=id
      row gap=12 align-items="center" min-height=44 padding="10px 0"
        box width=22 height=22 border-radius=11 flex-shrink=0 background-color=(failed != "" ? "hex.danger" : "-exact-label") display="flex" align-items="center" justify-content="center" aria-hidden=true
          image (failed != "" ? "symbol:sf/exclamationmark" : "symbol:checkmark") width=11 height=11 object-fit="contain" color="-exact-background"
        column flex=1 min-width=0 gap=2
          text label font="-exact-body" font-weight=600 color="-exact-label"
          if failed == ""
            text detail font="-exact-subheadline" color="-exact-secondary-label" aria-live="polite"
        if failed == ""
          button press=undo class=PillTap -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`Undo ${label}` testId=`${id}-undo`
            box class=PillFace
              text "Undo" font="-exact-subheadline" font-weight=600
      if failed != ""
        row gap=8 align-items="center" padding="0 0 10px 34px" flex-wrap="wrap"
          text failed font="-exact-footnote" color="hex.danger" flex=1 testId=`${id}-failed`
          button press=again class=PillTap testId=`${id}-again`
            box class=PillFace padding="4px 10px"
              text "Try again" font="-exact-footnote" font-weight=600
      else if missed > 0
        row gap=8 align-items="center" padding="0 0 10px 34px" flex-wrap="wrap"
          text unreached(missed) font="-exact-footnote" color="hex.ask" flex=1
          button press=again class=PillTap testId=`${id}-again`
            box class=PillFace padding="4px 10px"
              text "Send again" font="-exact-footnote" font-weight=600

// The last row of every question: take it off the list without answering.
component NotNeeded
  inject
    haptics: bool
  props
    disabled: bool
    id: string
    press: action
  view
    button press=press disabled=disabled class=Tap display="flex" flex-direction="row" gap=12 align-items="center" padding="12px 0" min-height=44 border-bottom="0.5px solid -exact-separator" text-align="left" opacity=(disabled ? 0.5 : 1) -exact-press-haptic=(haptics ? "selection" : "none") aria-label="Not needed, take it off your list" testId=id
      box width=22 height=22 border-radius=11 flex-shrink=0 box-sizing="border-box" border="1.5px dashed -exact-tertiary-label" aria-hidden=true
      column flex=1 min-width=0 gap=2
        text "Not needed" font="-exact-body" color="-exact-secondary-label"
        text "Take it off your list" font="-exact-subheadline" color="-exact-tertiary-label"

// A question hex took off Bassim's list to decide itself, on its thread's page: when, the question,
// why it's hex's call, and Undo, which puts it back on his list.
component DecidedCard
  inject
    haptics: bool
  props
    ask: Ask
    now: number
    offset: number
    failed: string
    undo: action
  view
    column gap=8 padding="10px 0 14px" testId=`decided-card-${ask.id}`
      row gap=8 align-items="center"
        box width=8 height=8 border-radius=4 background-color="hex.accent" flex-shrink=0 aria-hidden=true
        text `hex decided${ask.decided > 0 ? ` · ${whenOf(ask.decided, now, offset)}` : ""}` font="-exact-footnote" color="hex.accent" font-variant-numeric="tabular-nums" flex=1 line-clamp=1
        button press=undo(ask.id) class=PillTap -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`Undo, put “${ask.question}” back on your list` testId=`decided-card-undo-${ask.id}`
          box class=PillFace padding="4px 11px"
            text "Undo" font="-exact-footnote" font-weight=600
      text ask.question font="-exact-title3" font-weight=600
      if ask.took != ""
        text `✦ ${ask.took}` font="-exact-headline" color="hex.accent"
      if ask.why != ""
        text ask.why font="-exact-body" color="-exact-label" user-select="text"
      if failed != ""
        text failed font="-exact-footnote" color="hex.danger"

// Bassim's own words to a question, docked at the page's foot: + adds a photo, and the words go as
// his answer. The keyboard stays up after a send, and a draft is kept if he leaves.
component ReplyComposer
  props
    ask: Ask
    draft: string
    keep: action
    dismissed: action
    note: action
    answer: action
    attached: Media[]
    addError: string
    attach: action
    detach: action
  state text = ""
  state started = false
  derive words = started ? text : draft
  derive empty = words.trim() == "" and attached.length == 0
  action add(source: string)
    attach(`ask:${ask.id}`, source)
  action edit(v: string)
    text = v
    started = true
    keep(`ask:${ask.id}`, v)
  action send
    answer(ask.id, words.trim())
    text = ""
    started = true
    keep(`ask:${ask.id}`, "")
  view
    column gap=4 padding="6px 12px 8px" testId="reply"
      Waiting(media=attached, error=addError, remove=detach)
      row gap=8 align-items="flex-end"
        AddMedia(menu="reply-add", label="Add a photo or video", glass=false, size=44, disabled=(attached.length >= 4), add=add)
        row class=Composer flex=1 min-width=0
          textarea id="reply-field" class=ComposerField value=words input=edit rows=1 field-sizing="content" max-height=130 placeholder="Reply in your own words" aria-label=`Your answer to ${ask.question}` testId="reply-field"
          button press=send disabled=empty buttonStyle="filled" retainFocus=true margin="4px 0" aria-label="Answer with these words" testId="reply-answer"
            image "symbol:send"
