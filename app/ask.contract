// A question from hex (§9.3), flat on the page: no card and no box inside it. Which question it is
// and when, the question, what it's about in reading text, and a small "Why" that opens the message
// it came from; then every answer as one kind of row, hex's pick marked in mint, and his own words
// as the last row. Once answered it folds to what he said, with Undo.
use Ask, Words, Media from "./shapes.contract"
use Pictures, Thumb, AddMedia, Waiting, shapeOf, rowHeight from "./media.contract"
use Mark, whenOf from "./parts.contract"
use Said, unreached, failedWords from "./said.contract"

fn questionWord(n: number, of: number): string = of > 1 ? `Question ${n} of ${of}` : "Question"

// One answer to a question, the same row everywhere a question shows: a ring (filled when chosen,
// mint for hex's pick), its words and what they mean, and "✦ hex’s pick" at its end.
component AnswerRow
  inject
    haptics: bool
  props
    label: string
    detail: string
    pick: bool
    chosen: bool
    // radio: one answer; check: one of several; "" for a row that only shows.
    role: string
    disabled: bool
    id: string
    press: action
  view
    button press=press disabled=disabled appearance="none" display="flex" flex-direction="row" gap=12 align-items="center" padding="12px 0" border-bottom="0.5px solid -exact-separator" text-align="left" -exact-press-haptic=(haptics ? "selection" : "none") role=(role == "check" ? "checkbox" : role == "radio" ? "radio" : "button") aria-checked=chosen aria-label=(pick ? `${label}, hex’s pick` : label) testId=id
      box width=22 height=22 border-radius=11 flex-shrink=0 box-sizing="border-box" border=(chosen ? "none" : pick ? "1.5px solid hex.accent" : "1.5px solid -exact-tertiary-label") background-color=(chosen ? "AccentColor" : "transparent") display="flex" align-items="center" justify-content="center" aria-hidden=true
        if chosen
          image "symbol:checkmark" width=11 height=11 object-fit="contain" color="ink.on-accent"
      column flex=1 min-width=0 gap=2
        text label font="-exact-body" color="-exact-label"
        if detail != ""
          text detail font="-exact-subheadline" color="-exact-secondary-label"
      if pick
        text "✦ hex’s pick" font="-exact-footnote" font-weight=500 color="hex.accent" white-space="nowrap"

component AskCard
  inject
    haptics: bool
  props
    ask: Ask
    // Which of the page's questions this is, and how many it has.
    n: number
    of: number
    now: number
    offset: number
    said: Said
    draft: string
    words: Words
    wordsOpen: bool
    showWords: action
    answer: action
    answerMany: action
    dismiss: action
    undo: action
    again: action
    reply: action
    open: action
    width: number
  state chosen = [""].slice(0, 0)
  state folded = false
  derive answered = said.id == ask.id and said.verb != "note" and said.status != "failed"
  derive noted = said.id == ask.id and said.verb == "note" and said.status == "sent"
  derive shots = ask.options.filter(o => o.shot >= 0)
  // The screenshots side by side at their own shapes, 300 tall at most; past 140 they scroll.
  derive shotsTall = max(140, rowHeight(shots.map(o => Media(id="", kind="photo", aspect=o.aspect)), width, 300))
  derive from = match ask.places.at(0) { case some(p) => p.place, case none => ask.topic }
  action choose(label: string)
    if ask.multiple
      chosen = chosen.includes(label) ? chosen.filter(c => c != label) : chosen.concat([label])
    else
      answer(ask.id, label)
  action fold
    folded = not folded
  view
    column gap=8 padding="10px 0 14px" testId=`ask-card-${ask.id}`
      if answered
        row gap=12 align-items="flex-start"
          Mark(state="done", size=22)
          column flex=1 min-width=0 gap=2
            text ask.question font="-exact-subheadline" color="-exact-secondary-label" line-clamp=2
            text (said.verb == "dismiss" ? "Not needed" : said.label) font="-exact-body" font-weight=600 opacity=(said.status == "sending" ? 0.6 : 1)
            if said.missed > 0
              row gap=8 align-items="center" flex-wrap="wrap" padding-top=2
                text unreached(said.missed) font="-exact-footnote" color="hex.ask"
                button press=again(ask.id) appearance="none" padding="4px 10px" border-radius=999 background-color="-exact-tertiary-fill" testId=`card-again-${ask.id}`
                  text "Send again" font="-exact-footnote" font-weight=600
          button press=undo(ask.id) appearance="none" padding="6px 12px" border-radius=999 background-color="-exact-tertiary-fill" -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`Undo ${said.label}` testId=`card-undo-${ask.id}`
            text "Undo" font="-exact-subheadline" font-weight=600
      else
        row gap=8 align-items="center"
          box width=8 height=8 border-radius=4 background-color="hex.ask" flex-shrink=0 aria-hidden=true
          text `${questionWord(n, of)}${ask.at > 0 ? ` · ${whenOf(ask.at, now, offset)}` : ""}` font="-exact-footnote" color="-exact-secondary-label" font-variant-numeric="tabular-nums" line-clamp=1
          if ask.tag != ""
            text `· ${ask.tag}` font="-exact-footnote" font-weight=600 color="hex.ask" white-space="nowrap"
          box flex=1
          button press=dismiss(ask.id) appearance="none" padding="4px 11px" border-radius=999 background-color="-exact-tertiary-fill" -exact-press-haptic=(haptics ? "selection" : "none") testId=`ask-dismiss-${ask.id}`
            text "Not needed" font="-exact-footnote" font-weight=600
        button press=fold appearance="none" text-align="left" aria-expanded=(not folded) testId=`ask-fold-${ask.id}`
          text ask.question font="-exact-title3" font-weight=600 line-clamp=(folded ? 2 : 0)
        if not folded
          if ask.context != ""
            text ask.context font="-exact-body" color="-exact-label" user-select="text"
          button press=showWords(ask.id) appearance="none" display="flex" flex-direction="row" gap=6 align-items="center" padding="2px 0" aria-expanded=wordsOpen aria-label=`Why: the message from ${from}` testId=`ask-from-${ask.id}`
            text "Why" font="-exact-subheadline" font-weight=600 color="-exact-label"
            text `· from ${from}${ask.at > 0 ? `, ${whenOf(ask.at, now, offset)}` : ""}` font="-exact-subheadline" color="-exact-secondary-label" line-clamp=1 flex-shrink=1
            image "symbol:forward-chevron" width=10 height=10 object-fit="contain" color="-exact-tertiary-label" rotate=(wordsOpen ? "90deg" : "0deg") transition="rotate 200ms ease"
          if wordsOpen
            column gap=4 padding="2px 0 4px 12px" border-left="2px solid -exact-separator"
              if words.text == ""
                progress aria-label="Loading the message"
              else
                text words.text markup="markdown" font="-exact-subheadline" color="-exact-secondary-label" user-select="text"
          if ask.links.length > 0
            row gap=14 flex-wrap="wrap"
              for l in ask.links key=l.url
                link href=l.url testId=`ask-link-${l.label}`
                  text `${l.label} ↗` font="-exact-subheadline" font-weight=600
        if ask.pictures.length > 0 and not folded
          Pictures(media=ask.pictures.map(p => Media(id=p.id, kind="photo", aspect=p.aspect)), width=width, height=300)
        if shots.length > 0
          scroll overflow-x="auto" overflow-y="hidden" scrollbar-width="none"
            row gap=10 padding="2px 0"
              for o in shots key=o.label
                column gap=6 align-items="center" width=(shotsTall * shapeOf(o.aspect)) flex-shrink=0
                  Thumb(media=Media(id=`/asks/${encodeURIComponent(ask.id)}/shots/${o.shot}`, kind="photo", aspect=o.aspect), width=(shotsTall * shapeOf(o.aspect)), square=false)
                  text o.label font="-exact-footnote" color="-exact-secondary-label" line-clamp=1
        column border-top="0.5px solid -exact-separator" margin-top=4
          for o in ask.options key=o.label
            AnswerRow(label=o.label, detail=o.detail, pick=o.pick, chosen=chosen.includes(o.label), role=(ask.multiple ? "check" : "radio"), disabled=false, id=`ask-option-${ask.id}-${o.label}`, press=choose(o.label))
          button press=reply(ask.id) appearance="none" display="flex" flex-direction="row" gap=12 align-items="center" padding="12px 0" border-bottom="0.5px solid -exact-separator" text-align="left" -exact-press-haptic=(haptics ? "selection" : "none") testId=`ask-own-${ask.id}`
            box width=22 height=22 flex-shrink=0 display="flex" align-items="center" justify-content="center" aria-hidden=true
              image "symbol:pencil" width=17 height=17 object-fit="contain" color="-exact-secondary-label"
            text (draft != "" ? draft : "In your own words") font="-exact-body" color=(draft != "" ? "-exact-label" : "-exact-secondary-label") line-clamp=1 flex=1
        if ask.multiple
          button press=answerMany(ask.id, chosen) buttonStyle="filled" disabled=(chosen.length == 0) margin-top=4 testId=`ask-answer-${ask.id}`
            text (chosen.length == 0 ? "Pick one or more" : `Answer with ${chosen.length}`)
        if noted
          text `Sent to ${said.detail != "" ? said.detail : ask.topic} as a note. The question is still open.` font="-exact-footnote" color="-exact-secondary-label"
        if said.id == ask.id and said.status == "failed"
          text failedWords(said) font="-exact-footnote" color="hex.danger" testId=`ask-failed-${ask.id}`

// A question hex took off Bassim's list to decide itself, on its thread's page: when, the question,
// why it's hex's call, and Undo, which puts it back on his list.
component DecidedCard
  inject
    haptics: bool
  props
    ask: Ask
    now: number
    offset: number
    failed: string
    undo: action
  view
    column gap=8 padding="10px 0 14px" testId=`decided-card-${ask.id}`
      row gap=8 align-items="center"
        box width=8 height=8 border-radius=4 background-color="hex.accent" flex-shrink=0 aria-hidden=true
        text `hex decided${ask.decided > 0 ? ` · ${whenOf(ask.decided, now, offset)}` : ""}` font="-exact-footnote" color="hex.accent" font-variant-numeric="tabular-nums" flex=1 line-clamp=1
        button press=undo(ask.id) appearance="none" padding="4px 11px" border-radius=999 background-color="-exact-tertiary-fill" -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`Undo, put “${ask.question}” back on your list` testId=`decided-card-undo-${ask.id}`
          text "Undo" font="-exact-footnote" font-weight=600
      text ask.question font="-exact-title3" font-weight=600
      if ask.took != ""
        text `✦ ${ask.took}` font="-exact-headline" color="hex.accent"
      if ask.why != ""
        text ask.why font="-exact-body" color="-exact-label" user-select="text"
      if failed != ""
        text failed font="-exact-footnote" color="hex.danger"

// Bassim's own words to a question, at the page's foot: send them as a note (the question stays
// open) or as the answer. Closing it keeps the draft.
component ReplyComposer
  props
    ask: Ask
    draft: string
    keep: action
    dismissed: action
    note: action
    answer: action
    attached: Media[]
    addError: string
    attach: action
    detach: action
  state text = ""
  state started = false
  derive words = started ? text : draft
  derive empty = words.trim() == "" and attached.length == 0
  action add(source: string)
    attach(`ask:${ask.id}`, source)
  action edit(v: string)
    text = v
    started = true
    keep(`ask:${ask.id}`, v)
  action sendNote
    note(ask.id, words.trim())
    keep(`ask:${ask.id}`, "")
    dismissed()
  action sendAnswer
    answer(ask.id, words.trim())
    keep(`ask:${ask.id}`, "")
    dismissed()
  action leave
    if empty
      dismissed()
  view
    column gap=8 padding="10px 16px" testId="reply"
      row gap=8 align-items="center"
        text `Replying to ${ask.question}` font="-exact-footnote" color="-exact-secondary-label" line-clamp=1 flex=1
        button press=dismissed aria-label="Close, keep the draft" testId="reply-close"
          image "symbol:close"
      Waiting(media=attached, error=addError, remove=detach)
      textarea id="reply-field" value=words input=edit blur=leave autofocus=true rows=3 field-sizing="content" max-height=130 placeholder="Your answer" aria-label="Your answer" testId="reply-field"
      row gap=8 align-items="center"
        AddMedia(menu="reply-add", label="Add a photo or video", glass=false, size=36, disabled=(attached.length >= 4), add=add)
        box flex=1
        button press=sendNote disabled=empty buttonStyle="bordered" testId="reply-note"
          text "Send as note"
        button press=sendAnswer disabled=empty buttonStyle="filled" testId="reply-answer"
          text "Answer"
