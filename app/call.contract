// Home: hex itself while no call is on (home.contract), and the call with hex (§1–4, 7). In a call,
// the orb in the middle, what each side says as it's said, the questions hex puts on screen during
// the call, what hex is doing for it, and the controls. The toolbar opens Calls, Tasks and Settings
// over it.
//
// It follows the room: with two columns the orb and controls take the first and the words the
// second; with one, the orb rises to make room for the words.
use Viewport, CallState, Captions, Activity, Counts, Calls, CallRow, CallRecord, CallAsk, Ask, AgentLine, Media, Tasks, Asks from "./shapes.contract"
use endingOf, badEnding, lengthOf, Tap, HexTabs, Mark, springOf from "./parts.contract"
use WrapUp from "./wrap-up.contract"
use Album, AddMedia from "./media.contract"
use Said, failedWords, unreached from "./said.contract"
use HexHome, faceOf from "./home.contract"
use AnswerRow from "./ask.contract"
use Room, Chrome from "./room.contract"
use FeedView from "./feed.contract"

// How an answer from the call went out, as the stable app says it: " and cleared its Telegram
// buttons", or which places were out of reach.
fn reachedBy(ask: Ask, settled: number, missed: number): string = `${settled > 0 ? ` and cleared its ${missed > 0 ? "" : ["telegram", "discord"].filter(app => ask.places.filter(p => p.app == app).length > 0).map(app => app == "telegram" ? "Telegram " : "Discord ").join("and ")}buttons` : ""}${missed > 0 ? `. ${unreached(missed)}` : ""}`

// One line of the live transcript: a caption, photos and videos Bassim sent (media, and note:
// "sending", why not, or ""), or the call's ask at index `ask` (-1 for anything else).
shape Line
  id: string
  at: number
  who: string
  text: string
  ask: number
  media: Media[]
  note: string

// Where a call held elsewhere is, and how it started, as the stable app says it.
fn whereOf(source: string): string = source == "web" ? "On the web page" : source == "phone-in" or source == "phone-out" ? "On your phone" : "In the app"
fn startedOf(source: string): string = source == "web" ? "You called from the web page" : source == "phone-in" ? "You called hex" : source == "phone-out" ? "hex called you" : "You called from the app"

component Home
  inject
    still: bool
  props
    entry: Entry
    viewport: Viewport
    now: number
    call: CallState
    captions: Captions
    activity: Activity
    counts: Counts
    calls: Calls
    // The live call's record (here or elsewhere): hex muting itself, a call elsewhere's words.
    liveRecord: CallRecord
    persona: string
    personaColor: string
    palette: string
    reaction: string
    haptics: bool
    start: action
    mute: action
    end: action
    hangUp: action
    leaving: bool
    share: action
    reshare: action
    open: action
    openTasks: action
    openTask: action
    answer: action
    answerMany: action
    // What Bassim did with each question here, newest last, and the agent that just finished.
    said: Said[]
    finished: string
    // Why bringing a task into the call, or sharing into it, didn't go ("Not sent · …").
    trouble: string
    // Where everything sits (room.contract); whether the words are pulled up to read.
    room: Room
    reading: bool
    setReading: action
    // hex's own pages (room.contract's tabs), the one under its face, and the switch.
    pages: string[]
    page: string
    pickPage: action
    feedFresh: bool
    feed: FeedView
    openFeed: action
    discuss: action
    undo: action
    moreFeed: action
    retryFeed: action
    // hex as the home whenever no call is on: what needs Bassim and what hex is doing; with two columns
    // the page a row opens shows beside (the slot), `beside` its id.
    offset: number
    tasks: Tasks
    asks: Asks
    listsLoading: bool
    listsFailed: bool
    beside: string
    select: action
  slot

  // A call hex holds that isn't this phone's (a phone call): shown live, ended from here.
  derive elsewhere = isElsewhere(call, activity, liveRecord)
  derive status = elsewhere ? (leaving ? "ending" : "live") : call.status
  derive live = status == "live"
  derive here = live and not elsewhere
  derive busy = status == "connecting" or status == "reconnecting" or status == "ending"
  // hex muted itself: the last mute or unmute in the call's record says so.
  derive hushed = live and match liveRecord.moments.filter(m => m.kind == "muted" or m.kind == "unmuted").at(-1) { case some(m) => m.kind == "muted", case none => false }
  derive micOff = call.muted or call.interrupted
  derive two = room.columns == 2
  derive single = not two
  derive top = room.clear.y
  derive bottom = room.foot
  // No call on: hex is the home. A phone shows the last call's words over it while they're read.
  derive homeMode = status == "idle" and not elsewhere and not (single and reading)

  // The call's words and its asks, in the order they came. The last call's stay until the next. The
  // shell stamps its words in epoch ms and hex its asks in ms into the call, as it does a call's
  // record.
  derive lines = linesOf(call, captions, activity, liveRecord, live)
  derive talking = lines.length > 0
  derive elapsed = elsewhere ? liveRecord.call.started : call.started

  // The wrap-up of the call that just ended here (the call its words are from), once hex has
  // written one.
  derive last = match calls.calls.filter(c => c.id == captions.call).at(0) { case some(c) => c, case none => CallRow(id="", started=0, ended=0, ending="", source="", voice="", title="", why="", summary="", waiting=[], seconds=0, tasks=0, preview="", live=false) }
  derive wrapped = status == "idle" and call.ending != "" and last.id != "" and not last.live and (last.title != "" or last.summary != "" or last.waiting.length > 0)

  // What hex is doing for the call: the first running task, or for a moment the one that just
  // finished.
  derive running = activity.tasks.filter(t => t.state == "running")
  derive agent = match running.at(0) { case some(t) => t, case none => match activity.tasks.filter(t => t.id == finished).at(0) { case some(t) => t, case none => AgentLine(id="", state="", text="", to="", line="") } }
  derive agentText = agent.state == "running" ? (agent.line != "" ? agent.line : agent.text) : agent.state == "failed" and agent.line != "" ? agent.line : agent.text
  derive agentWhere = agent.state == "running" ? `${agent.to}${running.length > 1 ? `  +${running.length - 1}` : ""}` : agent.state

  derive label = status == "connecting" ? "Connecting" : status == "reconnecting" ? "Reconnecting" : status == "ending" ? "Ending conversation" : elsewhere ? `${startedOf(liveRecord.call.source)}, ${whereOf(liveRecord.call.source).toLowerCase()}` : live ? (micOff and hushed ? "Microphone and hex muted" : micOff ? "Microphone muted" : hushed ? "hex muted" : "Conversation active") : "Ready to start a conversation"
  derive footer = call.error != "" ? call.error : trouble != "" ? trouble : hushed ? (call.muted ? "hex muted" : "hex muted · say “unmute”") : elsewhere ? `${whereOf(liveRecord.call.source)} · ${startedOf(liveRecord.call.source)}` : call.interrupted and live ? "Paused while another app has the audio" : status == "idle" and call.ending != "" ? (call.ending == "no-connect" ? endingOf(call.ending) : `${endingOf(call.ending)} · ${lengthOf(call.seconds)}`) : ""
  derive footerBad = call.error != "" or trouble != "" or (status == "idle" and badEnding(call.ending))
  action primary
    if elsewhere
      hangUp(activity.call)
    else if status == "idle"
      start()
    else
      end()

  // Where things go, from the room: the chrome row beside the status icons, hex's column (the
  // whole clear width with one column, the first with two) with Call at its foot, and with two
  // columns the words or the page a row opens in the second. There is one orb: at rest it is hex's
  // face at the head of the column (home.contract faceOf); a call grows it from there in one motion,
  // with hex's name, the call's clock and what hex is doing under it, and the words below (one
  // column) or beside (two). Pulling the words up gives them the whole column.
  derive W = viewport.width
  derive H = viewport.height
  derive left = room.first.x
  derive hexW = room.first.width
  derive right = W - room.clear.x - room.clear.width
  // hex's column's trailing inset, and the second column's edges.
  derive hexRight = W - room.first.x - room.first.width
  derive secondLeft = room.second.x
  derive below = room.below
  derive compact = H < W
  derive face = faceOf(hexW, compact)
  // With more than one of hex's pages, its tabs take the foot at rest and Call stands beside them.
  derive tabbed = pages.length > 1 and status == "idle" and homeMode
  // The foot of hex's column: the tabs and Call at rest (room.tabs), Mute, End and Camera with their
  // names in a call. A list in the column ends above them.
  derive callSize = 64
  derive endSize = 68
  derive sideSize = 58
  derive controlsTop = H - bottom - 4 - endSize - 22
  derive footTop = homeMode ? H - room.tabs.top : H - controlsTop

  // The orb: hex's face at rest; in a call at the head of the column (one) or the middle of the
  // first (two), its name, clock and agent line under it.
  derive agentShown = live and agent.id != ""
  derive bigOrb = round(single ? max(min(min(hexW * 0.42, H * 0.2), 150), 60) : max(min(min(hexW - 96, (controlsTop - below) * 0.5), 260), 80))
  derive under = 8 + 24 + 22 + (agentShown ? 36 : 0) + 8
  derive callOrbY = single ? below + 14 + bigOrb / 2 : below + (controlsTop - below) / 2 - (bigOrb + under) / 2 + bigOrb / 2
  // It stands where the call puts it, and at rest is moved and scaled onto the face: a transform,
  // so it springs between the two without laying anything out.
  derive orbX = left + hexW / 2
  derive restShift = `${left + face.x - orbX}px ${below + face.y - callOrbY}px`
  derive glide = still ? "none" : "translate -exact-spring(380, 34, 1), scale -exact-spring(380, 34, 1)"

  // One column: the words fill the column under the orb's lines down to the controls (`rest`), or,
  // pulled up, the whole column (`full`). The handle drags the panel's height natively; a release
  // carries on at the finger's speed to the nearer end.
  derive wordsTop = callOrbY + bigOrb / 2 + under
  derive restHeight = max(controlsTop - 8 - wordsTop, 96)
  derive fullHeight = controlsTop - 8 - below
  derive wordsHeight = reading ? fullHeight : restHeight
  derive readable = talking or live
  action letGo(height: number, velocity: number)
    setReading(height + velocity * 0.15 > (restHeight + fullHeight) / 2)
  action flip
    setReading(not reading)
  derive wordsLeft = two ? secondLeft : left
  derive wordsRight = two ? right : hexRight
  // With two columns at rest, the last call's words stay beside the home until Bassim opens a page
  // or puts them away: `away` is the call whose words he put away.
  state away = ""
  derive wordsShown = talking and away != captions.call
  action choose(page: string)
    away = captions.call
    select(page)
  action toggleWords
    away = wordsShown ? captions.call : ""

  // A swipe in from the left edge opens Calls, as the stable app's drawer does.
  state edgeX = 0
  action edgeDrag(dx: number, dy: number)
    edgeX = edgeX + dx
  action edgeRelease(vx: number, vy: number)
    let far = edgeX > 60 or vx > 500
    edgeX = 0
    if far
      open(path("calls"))

  view
    column navigationKey=`${entry.id}` navigationBar="none" -exact-safe-area="none" position="absolute" inset=0 background-color="-exact-background" testId="home"
      box position="absolute" top=below bottom=footTop left=left width=20 touch-action="none" pan=edgeDrag panrelease=edgeRelease z-index=1 aria-hidden=true testId="calls-edge"

      Chrome(room=room, on="", needsYou=counts.yours, working=counts.working, open=open, openTasks=openTasks, back=open("/"))

      // hex as the home: in hex's column under the chrome, down to the tabs and Call; with two columns
      // the page a row opens beside it.
      column position="absolute" top=below bottom=footTop left=left right=hexRight opacity=(homeMode ? 1 : 0) pointer-events=(homeMode ? "auto" : "none") transition=springOf(still, "opacity") z-index=1 testId="hex-home"
        HexHome(width=hexW, height=(H - footTop - below), compact=compact, face=false, persona=persona, personaColor=personaColor, palette=palette, reaction=reaction, still=still, pages=pages, page=page, now=now, offset=offset, tasks=tasks, asks=asks, said=said, needing=counts.yours, workingOn=counts.working, loading=listsLoading, failed=listsFailed, split=two, beside=(wordsShown ? "" : beside), select=choose, openTask=openTask, openTasks=openTasks, open=open, feed=feed, openFeed=openFeed, discuss=discuss, undo=undo, moreFeed=moreFeed, retryFeed=retryFeed)
          column align-items="center" gap=8 padding="12px 0 0"
            CallLines(status=status, call=call, elapsed=elapsed, liveRecord=liveRecord, footer=footer, footerBad=footerBad)
            if wrapped
              box padding="0 10px" display="flex" justify-content="center" width="100%" box-sizing="border-box"
                WrapUp(call=last, whole=false, more=0, openTasks=openTasks, open=open)
      if two and homeMode and not wordsShown
        column position="absolute" top=room.secondBelow bottom=0 left=secondLeft right=right z-index=1 testId="home-beside"
          children

      // The orb: hex's face at rest, grown into the call.
      box position="absolute" left=(orbX - bigOrb / 2) top=(callOrbY - bigOrb / 2) width=bigOrb height=bigOrb translate=(homeMode ? restShift : "0px 0px") scale=(homeMode ? face.size / bigOrb : 1) transition=glide z-index=2 pointer-events="none" testId="orb-spot"
        hex-orb state=status silenced=(micOff or hushed ? "true" : "false") persona=persona tint=personaColor palette=palette reaction=reaction still=(still ? "true" : "false") width="100%" height="100%" role="img" aria-label=label testId="orb"

      // Under the orb in a call: hex, the clock or how it's connecting, and what hex is doing for it.
      column position="absolute" top=(callOrbY + bigOrb / 2 + 8) left=left right=hexRight align-items="center" gap=2 padding="0 20px" box-sizing="border-box" opacity=(homeMode ? 0 : 1) pointer-events=(homeMode ? "none" : "auto") transition=springOf(still, "opacity") z-index=2 testId="stage"
        text "hex" font="-exact-title3" font-weight=600 color="-exact-label"
        CallLines(status=status, call=call, elapsed=elapsed, liveRecord=liveRecord, footer=footer, footerBad=footerBad)
        if agentShown
          button press=openTasks("working") class=Tap display="flex" flex-direction="row" align-items="center" justify-content="center" gap=8 min-height=36 max-width="100%" margin-top=6 aria-live="polite" aria-label=`hex is ${agent.state == "running" ? "working" : agent.state}: ${agentText}${agentWhere != "" ? `, ${agentWhere}` : ""}` testId="agent-line"
            Mark(state=(agent.state == "running" ? "working" : agent.state == "failed" ? "failed" : "done"), size=18)
            text agentText font="-exact-subheadline" color=(agent.state == "failed" ? "hex.danger" : "hex.progress") white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0

      // The words: one column, a panel under the orb's lines that pulls up over them; two, the
      // second column.
      if single
        column id="words" position="absolute" bottom=(H - controlsTop + 8) left=left right=hexRight height=wordsHeight max-height=fullHeight box-sizing="border-box" overflow="hidden" background-color="-exact-background" opacity=(homeMode ? 0 : 1) pointer-events=(homeMode ? "none" : "auto") transition=springOf(still, "height") z-index=3 testId="words"
          box heightDragFor="words" heightrelease=letGo press=flip touch-action="none" height=28 flex-shrink=0 display="flex" align-items="center" justify-content="center" aria-label=(reading ? "Put the words down" : "Pull the words up") testId="words-handle"
            box width=36 height=5 border-radius=3 background-color="-exact-tertiary-label"
          if live and not talking
            text "Your conversation will appear here." color="-exact-tertiary-label" text-align="center" padding="24px 20px" testId="transcript-empty"
          CallWords(lines=lines, asks=activity.asks, said=said, width=hexW, live=live, answer=answer, answerMany=answerMany, openTask=openTask, reshare=reshare)
      else
        column position="absolute" top=room.secondBelow bottom=bottom left=wordsLeft right=wordsRight opacity=(homeMode ? (wordsShown ? 1 : 0) : readable ? 1 : 0) pointer-events=(homeMode and not wordsShown ? "none" : "auto") transition=springOf(still, "opacity") z-index=1 testId="words"
          if live and not talking
            text "Your conversation will appear here." color="-exact-tertiary-label" text-align="center" padding="24px 20px" testId="transcript-empty"
          CallWords(lines=lines, asks=activity.asks, said=said, width=room.second.width, live=live, answer=answer, answerMany=answerMany, openTask=openTask, reshare=reshare)

      // The foot of hex's column. At rest: Call, with hex's tabs beside it once there are more pages
      // than Now (room.contract places the pair). In a call: Mute, End and Camera, where a thumb reaches.
      if homeMode
        row position="absolute" left=room.tabs.x width=room.tabs.width top=room.tabs.top height=callSize justify-content="center" align-items="center" z-index=4 testId="controls"
          if tabbed
            HexTabs(current=page, fresh=feedFresh, pick=pickPage)
              CallButton(size=callSize, status=status, busy=busy, retry=(call.error != ""), primary=primary)
          else
            if two and talking
              box position="absolute" left=24
                WordsButton(size=52, shown=wordsShown, single=false, show=toggleWords)
            CallButton(size=callSize, status=status, busy=busy, retry=(call.error != ""), primary=primary)
      else
        row position="absolute" top=controlsTop left=left width=hexW justify-content="center" align-items="flex-start" gap=30 z-index=4 testId="controls"
          Labeled(text=(micOff ? "Unmute" : "Mute"))
            MuteButton(size=sideSize, mute=mute, micOff=micOff, hushed=hushed, disabled=(not here or not call.shell))
          Labeled(text=(status == "idle" ? "Call" : "End"))
            CallButton(size=endSize, status=status, busy=busy, retry=(call.error != ""), primary=primary)
          Labeled(text="Camera")
            if here and call.shell
              AddMedia(menu="call-add", label="Send a photo or video", glass=true, size=sideSize, disabled=false, add=share)
            else
              box width=sideSize height=sideSize border-radius=(sideSize / 2) backgroundMaterial="glass" opacity=0.4 aria-hidden=true

// A call control with its name under it.
component Labeled
  props
    text: string
  slot
  view
    column align-items="center" gap=6 min-width=58
      children
      text text font="-exact-footnote" color="-exact-secondary-label" white-space="nowrap" aria-hidden=true

// A call hex holds that isn't this phone's (a phone call): shown live, ended from here.
fn isElsewhere(call: CallState, activity: Activity, liveRecord: CallRecord): bool = call.status == "idle" and activity.call != "" and liveRecord.call.id == activity.call and liveRecord.call.ended == 0
// The call's words and its asks, in the order they came. The last call's stay until the next. The
// shell stamps its words in epoch ms and hex its asks in ms into the call, as it does a call's
// record.
fn linesOf(call: CallState, captions: Captions, activity: Activity, liveRecord: CallRecord, live: bool): Line[] = sortBy((isElsewhere(call, activity, liveRecord) ? liveRecord.turns.map((t, i) => Line(id=`r${i}`, at=t.at, who=(t.who == "you" ? "you" : "hex"), text=t.text, ask=-1, media=[Media(id="", kind="", aspect=0)].slice(0, 0), note="")) : captions.turns.map(t => Line(id=`t${t.id}`, at=t.at, who=t.who, text=t.text, ask=-1, media=t.media, note=t.note))).concat(live ? activity.asks.map((c, i) => Line(id=`a${c.ask.id}`, at=(isElsewhere(call, activity, liveRecord) ? c.at : call.started + c.at), who="hex", text="", ask=i, media=[Media(id="", kind="", aspect=0)].slice(0, 0), note="")) : []), l => l.at)

// What was said, as it was said: hex's words large, Bassim's in a bubble, photos and videos he sent,
// and the questions hex put on screen. The last two lines read at full strength, earlier ones a
// step back.
component CallWords
  inject
    haptics: bool
  props
    lines: Line[]
    asks: CallAsk[]
    said: Said[]
    width: number
    live: bool
    answer: action
    answerMany: action
    openTask: action
    reshare: action
  view
    list id="transcript" appearance="none" virtualized=true scroll-start="end" scrollFollowEnd=true flex=1 min-height=0 padding="0 20px" mask-image="linear-gradient(to bottom, transparent 0, #000 24px, #000 94%, transparent 100%)"
      for l, i in lines key=l.id
        column
          if l.ask >= 0
            for c in asks.slice(l.ask, l.ask + 1) key=c.ask.id
              CallAskCard(card=c, said=said.filter(s => s.id == c.ask.id and s.verb == "answer"), haptics=haptics, answer=answer, answerMany=answerMany, openTask=openTask)
          else if l.media.length > 0
            column align-items="flex-end" gap=4 padding="4px 0" testId=`line-${l.id}`
              box opacity=(l.note == "sending" ? 0.6 : 1)
                Album(media=l.media, width=min(width * 0.6, 260))
              if l.note == "sending"
                text "Sending" font="-exact-caption1" color="-exact-secondary-label"
              else if l.note != ""
                button press=reshare(l.id.slice(1)) disabled=(not live) class=Tap testId=`reshare-${l.id}`
                  text `Not sent · ${l.note}${live ? " · Tap to try again" : ""}` font="-exact-caption1" color="-exact-system-red" text-align="end"
          else
            row justify-content=(l.who == "you" ? "flex-end" : "flex-start") padding="4px 0"
              text l.text user-select="text" max-width=(l.who == "you" ? "82%" : "100%") font=(l.who == "you" ? "-exact-body" : "-exact-title3") font-weight=(l.who == "you" ? 400 : 500) color=(i >= lines.length - 2 ? "-exact-label" : "-exact-secondary-label") padding=(l.who == "you" ? "8px 14px" : "2px 0") border-radius=18 background-color=(l.who == "you" ? "-exact-tertiary-fill" : "transparent") overflow-wrap="break-word" testId=`line-${l.id}`

// The call while a page covers Home: a bar at the foot of the clear rectangle with hex's orb, its
// clock, Mute and End. A tap on the orb or its name goes back to the call. With two columns and Tasks
// open, Words puts the call's words in the first column, beside the page.
component CallDock
  inject
    haptics: bool
  props
    viewport: Viewport
    room: Room
    call: CallState
    activity: Activity
    liveRecord: CallRecord
    persona: string
    personaColor: string
    palette: string
    leaving: bool
    tasksOpen: bool
    beside: bool
    mute: action
    end: action
    hangUp: action
    home: action
    toggleBeside: action
  derive elsewhere = isElsewhere(call, activity, liveRecord)
  derive status = elsewhere ? (leaving ? "ending" : "live") : call.status
  derive started = elsewhere ? liveRecord.call.started : call.started
  derive micOff = call.muted or call.interrupted
  action stop
    if elsewhere
      hangUp(activity.call)
    else
      end()
  view
    row position="absolute" bottom=room.foot left=(room.clear.x + 12) width=(min(room.clear.width - 24, 440)) height=64 padding="0 8px" box-sizing="border-box" gap=10 align-items="center" border-radius=32 backgroundMaterial="glass" box-shadow="0 6px 24px rgba(0,0,0,0.18)" z-index=20 testId="call-dock"
      button press=home class=Tap flex=1 min-width=0 height=56 display="flex" flex-direction="row" align-items="center" gap=10 aria-label="Back to the call" -exact-press-haptic=(haptics ? "selection" : "none") testId="dock-orb"
        hex-orb state=status silenced=(micOff ? "true" : "false") persona=persona tint=personaColor palette=palette reaction="off" still=(viewport.prefersReducedMotion ? "true" : "false") width=44 height=44
        column min-width=0 align-items="flex-start"
          text "hex" font="-exact-headline" color="-exact-label"
          if status == "live"
            row gap=4
              text (micOff ? "Muted ·" : "On a call ·") font="-exact-subheadline" color="-exact-secondary-label" white-space="nowrap"
              time datetime=started format="timer" font="-exact-subheadline" font-variant-numeric="tabular-nums" color="-exact-secondary-label"
          else
            text (status == "ending" ? "Ending…" : status == "reconnecting" ? "Reconnecting…" : "Calling…") font="-exact-subheadline" color="-exact-secondary-label" white-space="nowrap"
      if room.columns == 2 and tasksOpen
        button press=toggleBeside class=Tap width=48 height=48 border-radius=24 background-color=(beside ? "-exact-tertiary-fill" : "transparent") display="flex" align-items="center" justify-content="center" aria-label=(beside ? "Show Tasks beside the page" : "Show the transcript beside Tasks") aria-pressed=beside -exact-press-haptic=(haptics ? "selection" : "none") testId="dock-beside"
          image "symbol:sf/text.bubble" width=18 height=18 object-fit="contain" color=(beside ? "AccentColor" : "-exact-label")
      if not elsewhere
        MuteButton(size=48, mute=mute, micOff=micOff, hushed=false, disabled=(status != "live" or not call.shell))
      CallButton(size=48, status=status, busy=(status != "live"), retry=false, primary=stop)

// Under the orb: the call's clock, its connecting, and how it went.
component CallLines
  props
    status: string
    call: CallState
    elapsed: number
    liveRecord: CallRecord
    footer: string
    footerBad: bool
  view
    if status == "live"
      row gap=6 align-items="center" testId="elapsed"
        if call.muted
          image "symbol:sf/mic.slash.fill" width=13 height=13 object-fit="contain" color="-exact-secondary-label" aria-hidden=true
        time datetime=elapsed format="timer" font="-exact-subheadline" font-variant-numeric="tabular-nums" color="-exact-secondary-label"
    if status == "connecting" or status == "reconnecting"
      text (status == "reconnecting" ? "Reconnecting…" : "Calling hex…") font="-exact-subheadline" color="-exact-secondary-label" testId="connecting"
    if footer != ""
      text footer font="-exact-subheadline" color=(footerBad ? "-exact-system-red" : "-exact-secondary-label") text-align="center" padding="0 32px" testId="footer"

// The last call's words: on a phone brought up over the home, on a fold shown or put away beside it.
component WordsButton
  inject
    haptics: bool
  props
    size: number
    shown: bool
    single: bool
    show: action
  view
    button press=show class=Tap width=size height=size border-radius=(size / 2) backgroundMaterial="glass" background-color=(shown ? "-exact-tertiary-fill" : "transparent") display="flex" align-items="center" justify-content="center" aria-label=(single ? "Show transcript" : shown ? "Put the transcript away" : "Show the transcript") aria-pressed=(single ? false : shown) -exact-press-haptic=(haptics ? "selection" : "none") testId="home-words"
      image "symbol:sf/text.bubble" width=(size * 0.36) height=(size * 0.36) object-fit="contain" color=(shown ? "AccentColor" : "-exact-label")

component MuteButton
  inject
    haptics: bool
  props
    size: number
    micOff: bool
    hushed: bool
    disabled: bool
    mute: action
  view
    button press=mute disabled=disabled class=Tap width=size height=size border-radius=(size / 2) backgroundMaterial="glass" display="flex" align-items="center" justify-content="center" -exact-press-haptic=(haptics ? "selection" : "none") aria-label=(micOff ? "Unmute microphone" : hushed ? "hex muted, mute microphone" : "Mute microphone") testId="mute"
      image (micOff ? "symbol:sf/mic.slash.fill" : hushed ? "symbol:sf/speaker.slash.fill" : "symbol:sf/mic.fill") width=(size * 0.37) height=(size * 0.37) object-fit="contain" color=(micOff ? "-exact-system-red" : "-exact-label")

component CallButton
  inject
    haptics: bool
  props
    size: number
    status: string
    busy: bool
    retry: bool
    primary: action
  view
    button press=primary disabled=(status == "ending") class=Tap width=size height=size border-radius=(size / 2) background-color=(status == "idle" ? "-exact-label" : "-exact-system-red") display="flex" align-items="center" justify-content="center" -exact-press-haptic=(haptics ? "impact-light" : "none") aria-label=(status == "idle" ? (retry ? "Retry conversation" : "Start conversation") : status == "connecting" or status == "reconnecting" ? "Cancel connection" : status == "ending" ? "Ending conversation" : "End conversation") testId="call"
      if busy
        progress width=(size / 3) height=(size / 3) color="#FFFFFF" aria-label="Connecting"
      else
        image (status == "idle" ? "symbol:waveform" : "symbol:sf/phone.down.fill") width=(size * 0.36) height=(size * 0.36) object-fit="contain" color=(status == "idle" ? "-exact-background" : "#FFFFFF")

// A question hex put on screen during the call (§7): tap an answer, or say it. hex's pick wears
// the mint wash with ✦, as everywhere; what Bassim chose fills with the accent.
component CallAskCard
  props
    card: CallAsk
    // This phone's answers to it, newest last.
    said: Said[]
    haptics: bool
    answer: action
    answerMany: action
    openTask: action
  state chosen = []
  derive ask = card.ask
  derive mine = match said.at(-1) { case some(s) => s, case none => Said(id="", verb="", label="", status="", detail="", missed=0, question="", topic="", task="") }
  derive sending = mine.status == "sending"
  derive sent = card.answered ? card.answer : mine.status == "sent" ? mine.label : ""
  action choose(label: string)
    if ask.multiple
      chosen = chosen.includes(label) ? chosen.filter(c => c != label) : chosen.concat([label])
    else
      answer(ask.id, label)
  view
    column gap=6 margin="8px 0" padding-top=10 border-top="0.5px solid -exact-separator" testId=`call-ask-${ask.id}`
      if sent != ""
        row gap=8 align-items="center"
          image "symbol:select-fill" width=18 height=18 object-fit="contain" color="hex.accent" aria-hidden=true
          text `Sent “${sent}” to ${ask.topic}${reachedBy(ask, card.settled, card.missed)}` font="-exact-subheadline" flex=1
      else
        row gap=8 align-items="center"
          box width=8 height=8 border-radius=4 background-color="hex.ask" flex-shrink=0 aria-hidden=true
          button press=openTask(ask.task) class=Tap testId=`call-ask-topic-${ask.id}`
            text `${ask.topic} ›` font="-exact-footnote" font-weight=600 color="-exact-secondary-label"
          if ask.tag != ""
            text `· ${ask.tag}` font="-exact-footnote" font-weight=600 color="hex.ask" white-space="nowrap"
        text ask.question font="-exact-headline" user-select="text"
        column border-top="0.5px solid -exact-separator" margin-top=2
          for o in ask.options key=o.label
            AnswerRow(label=o.label, detail="", pick=o.pick, chosen=(chosen.includes(o.label) or (sending and mine.label == o.label)), role=(ask.multiple ? "check" : "radio"), disabled=sending, id=`call-ask-option-${o.label}`, press=choose(o.label))
        if ask.links.length > 0
          row gap=14 flex-wrap="wrap" padding-top=4
            for l in ask.links key=l.url
              link href=l.url
                text `${l.label} ↗` font="-exact-subheadline" font-weight=600
        if ask.multiple and chosen.length > 0
          button press=answerMany(ask.id, chosen) buttonStyle="filled" disabled=sending testId=`call-ask-answer-${ask.id}`
            text `Answer with ${chosen.length}`
        if mine.status == "failed"
          text failedWords(mine) font="-exact-caption1" color="hex.danger" role="alert" testId=`call-ask-failed-${ask.id}`
        else
          text (sending ? `Sending ${mine.label}…` : ask.multiple ? "Pick one or more, or just say it" : "Tap, or just say it") font="-exact-caption1" color="-exact-secondary-label"
