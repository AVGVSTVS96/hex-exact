// Home: the call with hex (§1–4, 7). The orb in the middle, what each side says as it's said, the
// questions hex puts on screen during the call, what hex is doing for it, and the controls. The
// toolbar opens Calls, Tasks and Settings over it.
//
// On the Duo it follows the fold: folded like a book, the orb and controls take the left screen and
// the words the right; like a laptop, the orb sits above the fold and the words below; folded shut,
// or on a phone, one column, the orb rising to make room for the words.
use Viewport, Pose, Rect, CallState, Captions, Activity, Counts, Calls, CallRow, CallRecord, CallAsk, Ask, AgentLine, Media from "./shapes.contract"
use Glass, Surface, endingOf, badEnding, lengthOf from "./parts.contract"
use WrapUp from "./wrap-up.contract"
use Album, AddMedia from "./media.contract"
use Said, failedWords, unreached from "./said.contract"

// How an answer from the call went out, as the stable app says it: " and cleared its Telegram
// buttons", or which places were out of reach.
fn reachedBy(ask: Ask, settled: number, missed: number): string = `${settled > 0 ? ` and cleared its ${missed > 0 ? "" : ["telegram", "discord"].filter(app => ask.places.filter(p => p.app == app).length > 0).map(app => app == "telegram" ? "Telegram " : "Discord ").join("and ")}buttons` : ""}${missed > 0 ? `. ${unreached(missed)}` : ""}`

// One line of the live transcript: a caption, photos and videos Bassim sent (media, and note:
// "sending", why not, or ""), or the call's ask at index `ask` (-1 for anything else).
shape Line
  id: string
  at: number
  who: string
  text: string
  ask: number
  media: Media[]
  note: string

// Where a call held elsewhere is, and how it started, as the stable app says it.
fn whereOf(source: string): string = source == "web" ? "On the web page" : source == "phone-in" or source == "phone-out" ? "On your phone" : "In the app"
fn startedOf(source: string): string = source == "web" ? "You called from the web page" : source == "phone-in" ? "You called hex" : source == "phone-out" ? "hex called you" : "You called from the app"

component Home
  props
    entry: Entry
    viewport: Viewport
    now: number
    call: CallState
    captions: Captions
    activity: Activity
    counts: Counts
    calls: Calls
    // The live call's record (here or elsewhere): hex muting itself, a call elsewhere's words.
    liveRecord: CallRecord
    persona: string
    personaColor: string
    palette: string
    reaction: string
    haptics: bool
    start: action
    mute: action
    end: action
    hangUp: action
    leaving: bool
    share: action
    reshare: action
    open: action
    openTasks: action
    openTask: action
    answer: action
    answerMany: action
    // What Bassim did with each question here, newest last, and the agent that just finished.
    said: Said[]
    finished: string
    // Why bringing a task into the call, or sharing into it, didn't go ("Not sent · …").
    trouble: string
    // The Duo's side column, fold and cutouts; whether the words are pulled up to read.
    pose: Pose
    reading: bool
    setReading: action

  // A call hex holds that isn't this phone's (a phone call): shown live, ended from here.
  derive elsewhere = isElsewhere(call, activity, liveRecord)
  derive status = elsewhere ? (leaving ? "ending" : "live") : call.status
  derive live = status == "live"
  derive here = live and not elsewhere
  derive busy = status == "connecting" or status == "reconnecting" or status == "ending"
  // hex muted itself: the last mute or unmute in the call's record says so.
  derive hushed = live and match liveRecord.moments.filter(m => m.kind == "muted" or m.kind == "unmuted").at(-1) { case some(m) => m.kind == "muted", case none => false }
  derive micOff = call.muted or call.interrupted
  derive book = viewport.horizontalViewportSegments == 2
  derive laptop = viewport.verticalViewportSegments == 2
  derive single = not book and not laptop
  derive top = viewport.safeAreaTop
  derive bottom = max(viewport.safeAreaBottom, 12)

  // The call's words and its asks, in the order they came. The last call's stay until the next. The
  // shell stamps its words in epoch ms and hex its asks in ms into the call, as it does a call's
  // record.
  derive lines = linesOf(call, captions, activity, liveRecord, live)
  derive talking = lines.length > 0
  derive elapsed = elsewhere ? liveRecord.call.started : call.started

  // The wrap-up of the call that just ended here (the call its words are from), once hex has
  // written one.
  derive last = match calls.calls.filter(c => c.id == captions.call).at(0) { case some(c) => c, case none => CallRow(id="", started=0, ended=0, ending="", source="", voice="", title="", why="", summary="", waiting=[], seconds=0, tasks=0, preview="", live=false) }
  derive wrapped = status == "idle" and call.ending != "" and last.id != "" and not last.live and (last.title != "" or last.summary != "" or last.waiting.length > 0)

  // What hex is doing for the call: the first running task, or for a moment the one that just
  // finished.
  derive running = activity.tasks.filter(t => t.state == "running")
  derive agent = match running.at(0) { case some(t) => t, case none => match activity.tasks.filter(t => t.id == finished).at(0) { case some(t) => t, case none => AgentLine(id="", state="", text="", to="", line="") } }
  derive agentText = agent.state == "running" ? (agent.line != "" ? agent.line : agent.text) : agent.state == "failed" and agent.line != "" ? agent.line : agent.text
  derive agentWhere = agent.state == "running" ? `${agent.to}${running.length > 1 ? `  +${running.length - 1}` : ""}` : agent.state

  derive label = status == "connecting" ? "Connecting" : status == "reconnecting" ? "Reconnecting" : status == "ending" ? "Ending conversation" : elsewhere ? `${startedOf(liveRecord.call.source)}, ${whereOf(liveRecord.call.source).toLowerCase()}` : live ? (micOff and hushed ? "Microphone and hex muted" : micOff ? "Microphone muted" : hushed ? "hex muted" : "Conversation active") : "Ready to start a conversation"
  derive footer = call.error != "" ? call.error : trouble != "" ? trouble : hushed ? (call.muted ? "hex muted" : "hex muted · say “unmute”") : elsewhere ? `${whereOf(liveRecord.call.source)} · ${startedOf(liveRecord.call.source)}` : call.interrupted and live ? "Paused while another app has the audio" : status == "idle" and call.ending != "" ? (call.ending == "no-connect" ? endingOf(call.ending) : `${endingOf(call.ending)} · ${lengthOf(call.seconds)}`) : ""
  derive footerBad = call.error != "" or trouble != "" or (status == "idle" and badEnding(call.ending))
  action primary
    if elsewhere
      hangUp(activity.call)
    else if status == "idle"
      start()
    else
      end()

  // Where things go. The Duo's cover screen and its book fold keep the system bars in a column down
  // one side, under or over a camera: the toolbar and the call's buttons go in it, as the system
  // places its own. Its laptop fold has a band along the top instead, beside its camera, which
  // takes the toolbar. A phone, and the cover screen, rest the orb in the middle; a drag down (or
  // the transcript button) docks it at the bottom and brings up the words, and a tap on it puts them
  // away. A book fold has the orb on its left screen and the words on its right; a laptop fold the
  // orb above the fold and the words below.
  derive W = viewport.width
  derive H = viewport.height
  derive barSide = barOf(viewport, pose)
  derive columned = barSide != ""
  derive columnW = columnWidth(viewport, pose)
  derive columnX = barSide == "left" ? 0 : W - columnW
  derive columnTop = columnTopOf(viewport, pose)
  derive columnFoot = columnFootOf(viewport, pose)
  derive columnMid = columnMidOf(viewport, pose)
  derive tight = H < 520
  derive muteSize = columned and tight ? 48 : 60
  derive callSize = columned and tight ? 56 : columned ? 64 : 72
  derive banded = (book or laptop) and not columned
  // The band's widest stretch clear of the camera.
  derive bandSpan = bandOf(viewport, pose)
  derive left = barSide == "left" ? columnW : 0
  derive right = barSide == "right" ? columnW : 0
  derive contentW = W - left - right
  // Below the toolbar, where the content starts.
  derive below = columned ? top + 12 : banded ? top + 8 : top + 56

  // Phone and cover screen: the orb at rest, or docked as the words are read (pull 0 to 1).
  derive restSize = min(min(contentW * 0.62, H * 0.34), 280)
  derive restX = left + contentW / 2
  derive restY = columned ? (top + H - viewport.safeAreaBottom) / 2 : H / 2
  derive dockX = left + 50
  derive dockY = columned ? H - viewport.safeAreaBottom - 8 - 26 : H - bottom - 12 - callSize / 2
  derive travel = max(dockY - restY, 1)
  state pullY = 0
  state pulling = false
  derive pull = single ? min(max((reading ? 1 : 0) + pullY / travel, 0), 1) : 1
  derive orbX = restX + (dockX - restX) * pull
  derive orbY = restY + (dockY - restY) * pull
  derive orbSize = single ? restSize + (52 - restSize) * pull : book ? min(viewport.width / 2 - right - 64, viewport.height - top - 200) : min(viewport.height / 2 - top - 48, contentW - 120)
  derive glide = pulling ? "0ms linear" : "420ms cubic-bezier(0.2, 0.8, 0.2, 1)"
  derive agentShown = live and agent.id != ""
  // Above the docked orb and the buttons: the agent line, then the words.
  derive agentBottom = single ? (columned ? H - dockY + 26 + 10 : bottom + 12 + callSize + 10) : (laptop ? bottom + 88 : columned ? columnFoot : bottom + 12)
  derive wordsBottom = agentBottom + (agentShown ? 44 : 0)
  derive wordsLeft = book ? "env(viewport-segment-left 1 0)" : `${left}px`
  derive wordsTop = book ? `${below}px` : laptop ? "env(viewport-segment-top 0 1)" : `${below}px`
  derive readable = talking or live

  action drag(dx: number, dy: number)
    pulling = true
    pullY = pullY + dy
  action release(vx: number, vy: number)
    let moved = pullY / travel
    pulling = false
    pullY = 0
    setReading(vy > 500 ? true : vy < -500 ? false : reading ? moved > -0.35 : moved >= 0.35)
  // A swipe in from the left edge opens Calls, as the stable app's drawer does.
  state edgeX = 0
  action edgeDrag(dx: number, dy: number)
    edgeX = edgeX + dx
  action edgeRelease(vx: number, vy: number)
    let far = edgeX > 60 or vx > 500
    edgeX = 0
    if far
      open(path("calls"))
  action orbTap
    if single and reading
      setReading(false)

  view
    column navigationKey=`${entry.id}` navigationBar="none" position="absolute" inset=0 background-color="-exact-background" testId="home"
      // At rest on a phone, a drag anywhere on the screen pulls the words down.
      if single and not reading and readable
        box position="absolute" top=below bottom=0 left=left right=right touch-action="none" pan=drag panrelease=release testId="pull"

      box position="absolute" top=below bottom=0 left=left width=20 touch-action="none" pan=edgeDrag panrelease=edgeRelease z-index=1 aria-hidden=true testId="calls-edge"

      // Toolbar: down the side column; across the band beside the camera; else a row at the top,
      // Calls on the leading edge and Tasks and Settings in one capsule on the trailing one.
      if columned
        column position="absolute" top=columnTop left=(columnMid - 22) width=44 gap=(tight ? 8 : 12) align-items="center" z-index=2 testId="toolbar"
          Tools(axis="column", counts=counts, open=open, openTasks=openTasks)
      else
        row position="absolute" top=(banded ? max(top / 2 + 7 - 22, 4) : top + 6) left=(banded ? bandSpan.x : 16) width=(banded ? `${bandSpan.width}px` : book ? "calc(env(viewport-segment-width 0 0) - 32px)" : "calc(100% - 32px)") justify-content="space-between" align-items="center" z-index=2 testId="toolbar"
          Tools(axis="row", counts=counts, open=open, openTasks=openTasks)

      // The orb: in the middle at rest, docked as the words are read (phone, cover screen); on the
      // left screen of a book fold; above a laptop fold.
      if single
        box position="absolute" left=(orbX - orbSize / 2) top=(orbY - orbSize / 2) width=orbSize height=orbSize touch-action="none" pan=drag panrelease=release press=orbTap aria-label=(reading ? `${label}. Put the words away` : label) -exact-layout-transition=glide testId="orb-spot"
          hex-orb state=status silenced=(micOff or hushed ? "true" : "false") persona=persona tint=personaColor palette=palette reaction=reaction still=(viewport.prefersReducedMotion ? "true" : "false") width=orbSize height=orbSize role="img" aria-label=label -exact-layout-transition=glide testId="orb"
        column position="absolute" top=(restY + restSize / 2 + 12) left=left right=right align-items="center" gap=10 opacity=(1 - pull) pointer-events=(pull > 0.5 ? "none" : "auto") testId="stage"
          CallLines(status=status, call=call, elapsed=elapsed, liveRecord=liveRecord, footer=footer, footerBad=footerBad)
          if wrapped
            box padding="8px 32px" width="100%" box-sizing="border-box" display="flex" justify-content="center"
              WrapUp(call=last, whole=false, more=0, openTasks=openTasks, open=open)
        if readable
          box position="absolute" left=(dockX - 26) top=(dockY - 26) opacity=(1 - pull) pointer-events=(pull > 0 ? "none" : "auto") testId="transcript-dock"
            button press=setReading(true) appearance="auto" buttonStyle="glass" width=52 height=52 aria-label="Show transcript" testId="show-transcript"
              image "symbol:sf/text.bubble"
      else
        column position="absolute" top=below bottom=(laptop ? "calc(100% - env(viewport-segment-bottom 0 0))" : `${columned ? columnFoot : bottom + 12 + callSize + 16}px`) left=0 right=(book ? "calc(100% - env(viewport-segment-right 0 0))" : `${right}px`) align-items="center" justify-content="center" gap=10 testId="stage"
          hex-orb state=status silenced=(micOff or hushed ? "true" : "false") persona=persona tint=personaColor palette=palette reaction=reaction still=(viewport.prefersReducedMotion ? "true" : "false") width=orbSize height=orbSize role="img" aria-label=label testId="orb"
          CallLines(status=status, call=call, elapsed=elapsed, liveRecord=liveRecord, footer=footer, footerBad=footerBad)
          if wrapped and not talking
            box padding="8px 32px"
              WrapUp(call=last, whole=false, more=0, openTasks=openTasks, open=open)

      // The words: under the toolbar as they're read, on the right screen of a book fold, below a
      // laptop fold.
      column position="absolute" top=wordsTop bottom=wordsBottom left=wordsLeft right=right opacity=(single ? pull : readable ? 1 : 0) pointer-events=(single and pull < 1 ? "none" : "auto") transition=(pulling ? "none" : "opacity 300ms") testId="words"
        if live and not talking
          text "Your conversation will appear here." color="-exact-tertiary-label" text-align="center" padding="24px 20px" testId="transcript-empty"
        if single and footerBad
          text footer font="-exact-footnote" color="-exact-system-red" text-align="center" padding="0 20px 6px" testId="words-trouble"
        CallWords(lines=lines, asks=activity.asks, said=said, width=contentW, live=live, answer=answer, answerMany=answerMany, openTask=openTask, reshare=reshare)

      // The agent line: what hex is doing for this call; tap for the Working tab.
      if agentShown
        button press=openTasks("working") appearance="none" position="absolute" bottom=agentBottom left=(book ? "env(viewport-segment-left 1 0)" : `${left}px`) right=right height=36 margin="0 20px" padding="0 14px" border-radius=18 background-color="-exact-tertiary-fill" display="flex" flex-direction="row" align-items="center" gap=8 aria-live="polite" aria-label=`hex is ${agent.state == "running" ? "working" : agent.state}: ${agentText}${agentWhere != "" ? `, ${agentWhere}` : ""}` testId="agent-line"
          if agent.state == "running"
            progress width=14 height=14 aria-hidden=true
          else
            image (agent.state == "failed" ? "symbol:sf/exclamationmark" : "symbol:sf/checkmark") width=12 height=12 object-fit="contain" color=(agent.state == "failed" ? "hex.danger" : "-exact-secondary-label") aria-hidden=true
          text agentText font="-exact-footnote" font-weight=500 flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color=(agent.state == "running" and agent.line == "" ? "-exact-secondary-label" : "-exact-label")
          if agentWhere != ""
            text agentWhere font="-exact-caption1" font-variant-numeric="tabular-nums" color=(agent.state == "failed" ? "hex.danger" : agent.state == "done" ? "-exact-label" : "-exact-tertiary-label") white-space="nowrap"

      // The call's buttons: down the side column above its foot; else in a row at the foot of the
      // orb's side, mute and the photo menu either side of the call button.
      if columned
        column position="absolute" bottom=columnFoot left=(columnMid - callSize / 2) width=callSize gap=(tight ? 10 : 14) align-items="center" z-index=2 testId="controls"
          if here and call.shell
            AddMedia(menu="call-add", label="Send a photo or video", glass=true, size=muteSize, disabled=false, add=share)
          if status != "idle"
            MuteButton(size=muteSize, mute=mute, micOff=micOff, hushed=hushed, disabled=(not here or not call.shell))
          CallButton(size=callSize, status=status, busy=busy, retry=(call.error != ""), primary=primary)
      else
        row position="absolute" bottom=(bottom + 12) left=(book ? "env(viewport-segment-left 0 0)" : "0px") width=(book ? "env(viewport-segment-width 0 0)" : "100%") justify-content="center" align-items="center" gap=28 testId="controls"
          if status == "idle"
            box width=60 height=60
          else
            MuteButton(size=60, mute=mute, micOff=micOff, hushed=hushed, disabled=(not here or not call.shell))
          CallButton(size=callSize, status=status, busy=busy, retry=(call.error != ""), primary=primary)
          if here and call.shell
            AddMedia(menu="call-add", label="Send a photo or video", glass=true, size=60, disabled=false, add=share)
          else
            box width=60 height=60

// A call hex holds that isn't this phone's (a phone call): shown live, ended from here.
fn isElsewhere(call: CallState, activity: Activity, liveRecord: CallRecord): bool = call.status == "idle" and activity.call != "" and liveRecord.call.id == activity.call and liveRecord.call.ended == 0
// The call's words and its asks, in the order they came. The last call's stay until the next. The
// shell stamps its words in epoch ms and hex its asks in ms into the call, as it does a call's
// record.
fn linesOf(call: CallState, captions: Captions, activity: Activity, liveRecord: CallRecord, live: bool): Line[] = sortBy((isElsewhere(call, activity, liveRecord) ? liveRecord.turns.map((t, i) => Line(id=`r${i}`, at=t.at, who=(t.who == "you" ? "you" : "hex"), text=t.text, ask=-1, media=[Media(id="", kind="", aspect=0)].slice(0, 0), note="")) : captions.turns.map(t => Line(id=`t${t.id}`, at=t.at, who=t.who, text=t.text, ask=-1, media=t.media, note=t.note))).concat(live ? activity.asks.map((c, i) => Line(id=`a${c.ask.id}`, at=(isElsewhere(call, activity, liveRecord) ? c.at : call.started + c.at), who="hex", text="", ask=i, media=[Media(id="", kind="", aspect=0)].slice(0, 0), note="")) : []), l => l.at)

// What was said, as it was said: hex's words large, Bassim's in a bubble, photos and videos he sent,
// and the questions hex put on screen.
component CallWords
  inject
    haptics: bool
  props
    lines: Line[]
    asks: CallAsk[]
    said: Said[]
    width: number
    live: bool
    answer: action
    answerMany: action
    openTask: action
    reshare: action
  view
    list id="transcript" appearance="none" virtualized=true scroll-start="end" scrollFollowEnd=true flex=1 min-height=0 padding="0 20px" mask-image="linear-gradient(to bottom, transparent 0, #000 24px, #000 94%, transparent 100%)"
      for l in lines key=l.id
        column
          if l.ask >= 0
            for c in asks.slice(l.ask, l.ask + 1) key=c.ask.id
              CallAskCard(card=c, said=said.filter(s => s.id == c.ask.id and s.verb == "answer"), haptics=haptics, answer=answer, answerMany=answerMany, openTask=openTask)
          else if l.media.length > 0
            column align-items="flex-end" gap=4 padding="4px 0" testId=`line-${l.id}`
              box opacity=(l.note == "sending" ? 0.6 : 1)
                Album(media=l.media, width=min(width * 0.6, 260))
              if l.note == "sending"
                text "Sending" font="-exact-caption1" color="-exact-secondary-label"
              else if l.note != ""
                button press=reshare(l.id.slice(1)) disabled=(not live) appearance="none" testId=`reshare-${l.id}`
                  text `Not sent · ${l.note}${live ? " · Tap to try again" : ""}` font="-exact-caption1" color="-exact-system-red" text-align="end"
          else
            row justify-content=(l.who == "you" ? "flex-end" : "flex-start") padding="4px 0"
              text l.text user-select="text" max-width=(l.who == "you" ? "82%" : "100%") font=(l.who == "you" ? "-exact-body" : "-exact-title3") font-weight=(l.who == "you" ? 400 : 500) color=(l.who == "you" ? "-exact-secondary-label" : "-exact-label") padding=(l.who == "you" ? "8px 14px" : "2px 0") border-radius=18 background-color=(l.who == "you" ? "-exact-tertiary-fill" : "transparent") overflow-wrap="break-word" testId=`line-${l.id}`

// The call while Tasks, Calls or Settings cover Home on the Duo: hex's orb small, the call's clock
// and its buttons, down the side column or across the band beside the camera. A tap on the orb goes
// back to the call. On a book fold with Tasks open, Words puts the call's words on the left screen,
// beside the page.
component CallDock
  inject
    haptics: bool
  props
    viewport: Viewport
    pose: Pose
    call: CallState
    activity: Activity
    liveRecord: CallRecord
    persona: string
    personaColor: string
    palette: string
    leaving: bool
    tasksOpen: bool
    beside: bool
    mute: action
    end: action
    hangUp: action
    home: action
    toggleBeside: action
  derive elsewhere = isElsewhere(call, activity, liveRecord)
  derive status = elsewhere ? (leaving ? "ending" : "live") : call.status
  derive columned = barOf(viewport, pose) != ""
  derive mid = columnMidOf(viewport, pose)
  derive tight = viewport.height < 520
  derive band = bandOf(viewport, pose)
  derive started = elsewhere ? liveRecord.call.started : call.started
  derive micOff = call.muted or call.interrupted
  derive book = viewport.horizontalViewportSegments == 2
  action stop
    if elsewhere
      hangUp(activity.call)
    else
      end()
  view
    if columned
      column position="absolute" top=columnTopOf(viewport, pose) bottom=columnFootOf(viewport, pose) left=(mid - 28) width=56 align-items="center" justify-content="space-between" z-index=20 testId="call-dock"
        column align-items="center" gap=8
          button press=home appearance="none" width=44 height=44 display="flex" align-items="center" justify-content="center" aria-label="Back to the call" testId="dock-orb"
            hex-orb state=status silenced=(micOff ? "true" : "false") persona=persona tint=personaColor palette=palette reaction="off" still=(viewport.prefersReducedMotion ? "true" : "false") width=34 height=34
          if status == "live"
            time datetime=started format="timer" font="-exact-caption1" font-variant-numeric="tabular-nums" color="-exact-secondary-label"
          if book and tasksOpen
            button press=toggleBeside appearance="none" width=44 height=44 border-radius=22 backgroundMaterial="glass" background-color=(beside ? "-exact-tertiary-fill" : "transparent") display="flex" align-items="center" justify-content="center" aria-label=(beside ? "Show Tasks beside the page" : "Show the transcript beside Tasks") aria-pressed=beside -exact-press-haptic=(haptics ? "selection" : "none") testId="dock-beside"
              image "symbol:sf/text.bubble" width=18 height=18 object-fit="contain" color=(beside ? "AccentColor" : "-exact-label")
        column align-items="center" gap=(tight ? 10 : 14)
          if not elsewhere
            MuteButton(size=48, mute=mute, micOff=micOff, hushed=false, disabled=(status != "live" or not call.shell))
          CallButton(size=(tight ? 48 : 56), status=status, busy=(status != "live"), retry=false, primary=stop)
    else
      row position="absolute" top=max(viewport.safeAreaTop / 2 + 7 - 22, 4) right=(viewport.width - band.x - band.width) gap=10 align-items="center" z-index=20 testId="call-dock"
        button press=home appearance="none" width=44 height=44 display="flex" align-items="center" justify-content="center" aria-label="Back to the call" testId="dock-orb"
          hex-orb state=status silenced=(micOff ? "true" : "false") persona=persona tint=personaColor palette=palette reaction="off" still=(viewport.prefersReducedMotion ? "true" : "false") width=34 height=34
        if status == "live"
          time datetime=started format="timer" font="-exact-footnote" font-variant-numeric="tabular-nums" color="-exact-secondary-label" min-width=44
        if not elsewhere
          MuteButton(size=44, mute=mute, micOff=micOff, hushed=false, disabled=(status != "live" or not call.shell))
        CallButton(size=44, status=status, busy=(status != "live"), retry=false, primary=stop)

// The widest stretch of [from, to] clear of every box in `taken`, 12 points off each.
fn widestClear(from: number, to: number, taken: Rect[]): Span = match sortBy(range(taken.length + 1).map(i => Span(x=(i == 0 ? from : match sortBy(taken, t => t.x).at(i - 1) { case some(t) => t.x + t.width + 12, case none => from }), width=((i == taken.length ? to : match sortBy(taken, t => t.x).at(i) { case some(t) => t.x - 12, case none => to }) - (i == 0 ? from : match sortBy(taken, t => t.x).at(i - 1) { case some(t) => t.x + t.width + 12, case none => from })))), s => s.width, "desc").at(0) { case some(s) => s, case none => Span(x=from, width=to - from) }
// The Duo's side column: the side the system bars take ("" when none), how wide, where its tools
// start below a camera, where its buttons end above one, and its middle, the system's own: its status
// items' (the camera's ring), else the column's.
fn barOf(v: Viewport, p: Pose): string = p.bar == "left" and v.safeAreaLeft > 0 ? "left" : p.bar == "right" and v.safeAreaRight > 0 ? "right" : ""
fn columnWidth(v: Viewport, p: Pose): number = barOf(v, p) == "left" ? v.safeAreaLeft : barOf(v, p) == "right" ? v.safeAreaRight : 0
fn coversOf(v: Viewport, p: Pose): Rect[] = p.occlusions.filter(o => o.x < (barOf(v, p) == "left" ? 0 : v.width - columnWidth(v, p)) + columnWidth(v, p) and o.x + o.width > (barOf(v, p) == "left" ? 0 : v.width - columnWidth(v, p)))
fn columnTopOf(v: Viewport, p: Pose): number = max(max(v.safeAreaTop, 16), largest(coversOf(v, p).filter(o => o.y + o.height / 2 < v.height / 2).map(o => o.y + o.height + 8)))
fn columnFootOf(v: Viewport, p: Pose): number = max(max(v.safeAreaBottom, 12), largest(coversOf(v, p).filter(o => o.y + o.height / 2 >= v.height / 2).map(o => v.height - o.y + 8)))
fn columnMidOf(v: Viewport, p: Pose): number = match coversOf(v, p).filter(o => o.width < columnWidth(v, p)).at(0) { case some(o) => o.x + o.width / 2, case none => (barOf(v, p) == "left" ? 0 : v.width - columnWidth(v, p)) + columnWidth(v, p) / 2 }
// The top band of a fold with no side column, clear of its camera.
fn bandOf(v: Viewport, p: Pose): Span = widestClear(16, v.width - 16, p.occlusions.filter(o => o.y + o.height / 2 < v.safeAreaTop))
fn largest(xs: number[]): number = match sortBy(xs, x => x, "desc").at(0) { case some(x) => x, case none => 0 }

shape Span
  x: number
  width: number

// Calls, Tasks (a dot when something needs Bassim) and Settings, in a row or down the side column.
component Tools
  inject
    haptics: bool
  props
    axis: string
    counts: Counts
    open: action
    openTasks: action
  view
    button press=open(path("calls")) class=Glass aria-label="Calls" testId="open-calls"
      image "symbol:sf/clock.arrow.circlepath"
    box flex-direction=axis display="flex" backgroundMaterial="glass" border-radius=22 width=(axis == "row" ? "auto" : "44px") height=(axis == "row" ? "44px" : "auto") align-items="center" padding=(axis == "row" ? "0 4px" : "4px 0") gap=2 position="relative"
      button press=openTasks("") appearance="none" width=44 height=44 display="flex" align-items="center" justify-content="center" aria-label=`Tasks, ${counts.yours} need you, ${counts.working} working` -exact-press-haptic=(haptics ? "selection" : "none") testId="open-tasks"
        image "symbol:list" width=20 height=20 object-fit="contain" color="-exact-label"
      button press=open(path("settings")) appearance="none" width=44 height=44 display="flex" align-items="center" justify-content="center" aria-label="Voice and appearance settings" -exact-press-haptic=(haptics ? "selection" : "none") testId="open-settings"
        image "symbol:adjust" width=20 height=20 object-fit="contain" color="-exact-label"
      if counts.yours > 0
        box position="absolute" top=(axis == "row" ? -2 : 2) left=(axis == "row" ? 34 : 32) width=10 height=10 border-radius=5 background-color="AccentColor" border="2px solid -exact-background" aria-hidden=true testId="needs-dot"

// Under the orb: the call's clock, its connecting, and how it went.
component CallLines
  props
    status: string
    call: CallState
    elapsed: number
    liveRecord: CallRecord
    footer: string
    footerBad: bool
  view
    if status == "live"
      row gap=6 align-items="center" testId="elapsed"
        if call.muted
          image "symbol:sf/mic.slash.fill" width=13 height=13 object-fit="contain" color="-exact-secondary-label" aria-hidden=true
        time datetime=elapsed format="timer" font="-exact-subheadline" font-variant-numeric="tabular-nums" color="-exact-secondary-label"
    if status == "connecting" or status == "reconnecting"
      text (status == "reconnecting" ? "Reconnecting…" : "Calling hex…") font="-exact-subheadline" color="-exact-secondary-label" testId="connecting"
    if footer != ""
      text footer font="-exact-subheadline" color=(footerBad ? "-exact-system-red" : "-exact-secondary-label") text-align="center" padding="0 32px" testId="footer"

component MuteButton
  inject
    haptics: bool
  props
    size: number
    micOff: bool
    hushed: bool
    disabled: bool
    mute: action
  view
    button press=mute disabled=disabled appearance="none" width=size height=size border-radius=(size / 2) backgroundMaterial="glass" display="flex" align-items="center" justify-content="center" -exact-press-haptic=(haptics ? "selection" : "none") aria-label=(micOff ? "Unmute microphone" : hushed ? "hex muted, mute microphone" : "Mute microphone") testId="mute"
      image (micOff ? "symbol:sf/mic.slash.fill" : hushed ? "symbol:sf/speaker.slash.fill" : "symbol:sf/mic.fill") width=(size * 0.37) height=(size * 0.37) object-fit="contain" color=(micOff ? "-exact-system-red" : "-exact-label")

component CallButton
  inject
    haptics: bool
  props
    size: number
    status: string
    busy: bool
    retry: bool
    primary: action
  view
    button press=primary disabled=(status == "ending") appearance="none" width=size height=size border-radius=(size / 2) background-color=(status == "idle" ? "-exact-label" : "-exact-system-red") display="flex" align-items="center" justify-content="center" -exact-press-haptic=(haptics ? "impact-light" : "none") aria-label=(status == "idle" ? (retry ? "Retry conversation" : "Start conversation") : status == "connecting" or status == "reconnecting" ? "Cancel connection" : status == "ending" ? "Ending conversation" : "End conversation") testId="call"
      if busy
        progress width=(size / 3) height=(size / 3) color="#FFFFFF" aria-label="Connecting"
      else
        image (status == "idle" ? "symbol:waveform" : "symbol:close") width=(size * 0.36) height=(size * 0.36) object-fit="contain" color=(status == "idle" ? "-exact-background" : "#FFFFFF")

// A question hex put on screen during the call (§7): tap an answer, or say it. hex's pick wears
// the mint wash with ✦, as everywhere; what Bassim chose fills with the accent.
component CallAskCard
  props
    card: CallAsk
    // This phone's answers to it, newest last.
    said: Said[]
    haptics: bool
    answer: action
    answerMany: action
    openTask: action
  state chosen = []
  derive ask = card.ask
  derive mine = match said.at(-1) { case some(s) => s, case none => Said(id="", verb="", label="", status="", detail="", missed=0, question="", topic="", task="") }
  derive sending = mine.status == "sending"
  derive sent = card.answered ? card.answer : mine.status == "sent" ? mine.label : ""
  action choose(label: string)
    if ask.multiple
      chosen = chosen.includes(label) ? chosen.filter(c => c != label) : chosen.concat([label])
    else
      answer(ask.id, label)
  view
    column class=Surface gap=10 margin="8px 0" testId=`call-ask-${ask.id}`
      if sent != ""
        row gap=8 align-items="center"
          image "symbol:select-fill" width=18 height=18 object-fit="contain" color="hex.accent" aria-hidden=true
          text `Sent “${sent}” to ${ask.topic}${reachedBy(ask, card.settled, card.missed)}` font="-exact-subheadline" flex=1
      else
        row gap=8 align-items="center"
          button press=openTask(ask.task) appearance="none" testId=`call-ask-topic-${ask.id}`
            text `${ask.topic} ›` font="-exact-footnote" font-weight=600 color="-exact-secondary-label"
          if ask.tag != ""
            text ask.tag font="-exact-caption1" padding="2px 8px" border-radius=999 background-color="-exact-tertiary-fill" color="-exact-secondary-label"
        text ask.question font="-exact-headline" user-select="text"
        row gap=8 flex-wrap="wrap"
          for o in ask.options key=o.label
            button press=choose(o.label) disabled=sending appearance="none" padding="8px 14px" border-radius=999 background-color=(chosen.includes(o.label) or (sending and mine.label == o.label) ? "AccentColor" : o.pick ? "hex.accent.wash" : "-exact-tertiary-fill") opacity=(sending and mine.label != o.label ? 0.45 : 1) -exact-press-haptic=(haptics ? "selection" : "none") aria-label=(o.pick ? `${o.label}, hex’s pick` : o.label) aria-checked=(ask.multiple ? chosen.includes(o.label) : false) role=(ask.multiple ? "checkbox" : "button") testId=`call-ask-option-${o.label}`
              text (o.pick ? `✦ ${o.label}` : o.label) font="-exact-subheadline" font-weight=(o.pick ? 600 : 400) color=(chosen.includes(o.label) or (sending and mine.label == o.label) ? "ink.on-accent" : o.pick ? "hex.accent" : "-exact-label")
          for l in ask.links key=l.url
            link href=l.url padding="8px 14px" border-radius=999 background-color="-exact-tertiary-fill"
              text `${l.label} ↗` font="-exact-subheadline"
        if ask.multiple and chosen.length > 0
          button press=answerMany(ask.id, chosen) buttonStyle="filled" disabled=sending testId=`call-ask-answer-${ask.id}`
            text `Answer with ${chosen.length}`
        if mine.status == "failed"
          text failedWords(mine) font="-exact-caption1" color="hex.danger" role="alert" testId=`call-ask-failed-${ask.id}`
        else
          text (sending ? `Sending ${mine.label}…` : ask.multiple ? "Pick one or more, or just say it" : "Tap, or just say it") font="-exact-caption1" color="-exact-secondary-label"
