// Calls (§5): every call with hex, newest first, under the day it happened. A row opens the call:
// over Home in one column, beside the list in two. A swipe deletes one (not the live one) and leaves
// Undo in its place for a few seconds before hex hears of it; a delete hex refuses comes back with why.
use Calls, CallRow, Counts from "./shapes.contract"
use Mark, Note, RowTap, PillTap, PillFace, dayOf from "./parts.contract"
use Room, Chrome from "./room.contract"

fn nameOf(c: CallRow): string = c.title != "" ? c.title : c.preview != "" ? c.preview : "A quiet call"
// Today, Yesterday, then the weekday this week, then the date.
fn dayHead(at: number, now: number, offset: number): string = dayOf(at, offset) == dayOf(now, offset) ? "Today" : dayOf(at, offset) == dayOf(now, offset) - 1 ? "Yesterday" : formatDay(at, now, offset, "list")
fn naming(c: CallRow, now: number): bool = c.title == "" and c.ended > 0 and now - c.ended < 600000
// How long, as a clock: 4:12, 1:02:40.
fn clockOf(seconds: number): string = seconds >= 3600 ? `${floor(seconds / 3600)}:${floor((seconds % 3600) / 60) < 10 ? "0" : ""}${floor((seconds % 3600) / 60)}:${floor(seconds % 60) < 10 ? "0" : ""}${floor(seconds % 60)}` : `${floor(seconds / 60)}:${floor(seconds % 60) < 10 ? "0" : ""}${floor(seconds % 60)}`
// How a call ended, short, where it wasn't simply hung up by Bassim.
fn endShort(kind: string): string = kind == "hex" ? "hex hung up" : kind == "dropped" ? "Dropped" : kind == "expired" ? "Time ran out" : kind == "no-connect" ? "Didn't connect" : kind == "no-answer" ? "No answer" : kind == "busy" ? "Busy" : ""
fn endBad(kind: string): bool = kind == "dropped" or kind == "no-connect"
fn sourceSymbol(source: string): string = source == "web" ? "symbol:sf/globe" : source == "phone-in" ? "symbol:sf/phone.arrow.down.left" : source == "phone-out" ? "symbol:sf/phone.arrow.up.right" : source == "discord" ? "symbol:sf/headphones" : "symbol:waveform"
// The grey line under a call's name: when, then what came of it.
fn detailOf(c: CallRow, now: number, offset: number): string = [formatTime(c.started, offset, "short")].concat(naming(c, now) ? ["naming…"] : []).concat(c.tasks > 0 ? [`${c.tasks} ${c.tasks == 1 ? "task" : "tasks"}`] : []).join(" · ")

// The page's title, under the chrome, kept clear of the status icons on its trailing side.
component PageTitle
  props
    text: string
    room: Room
    left: number
    id: string
  view
    text text role="heading" aria-level=1 font="-exact-large-title" font-weight=700 color="-exact-label" line-clamp=2 padding=`0 ${max(room.width - room.bar.end, 20)}px 0 ${left}px` testId=id

component CallsList
  inject
    haptics: bool
  props
    entry: Entry
    room: Room
    now: number
    offset: number
    calls: Calls
    counts: Counts
    loading: bool
    failed: bool
    // A call is on: its bar sits at the foot, so the list ends above it.
    docked: bool
    // With two columns, the call open beside the list.
    selected: string
    select: action
    open: action
    openTasks: action
    remove: action
    undoRemove: action
    // The call that can still be taken back, and the one hex is deleting.
    undoable: string
    removing: string
    removeError: string
    back: action
  derive two = room.columns == 2
  derive shown = calls.calls.filter(c => c.id != removing or removeError != "")
  derive dayOfEach = shown.map(c => dayHead(c.started, now, offset))
  derive days = dayOfEach.filter((d, i) => dayOfEach.indexOf(d) == i)
  derive pad = room.clear.x + 20
  derive listLeft = two ? room.first.x : 0
  derive listWidth = two ? room.first.width : room.width
  view
    column navigationKey=`${entry.id}` navigationBar="none" -exact-safe-area="none" navigationScroll="calls-list" position="absolute" inset=0 background-color="-exact-background" testId="calls"
      Chrome(room=room, on="calls", needsYou=counts.yours, working=counts.working, open=open, openTasks=openTasks, back=back)
      scroll id="calls-list" position="absolute" top=room.below bottom=0 left=listLeft width=listWidth padding-bottom=(room.foot + (docked ? 88 : 24)) box-sizing="border-box" mask-image="linear-gradient(to bottom, transparent 0, #000 12px, #000 100%)" testId="calls-scroll"
        PageTitle(text="Calls", room=room, left=(two ? 20 : pad), id="calls-title")
        column padding=(two ? "8px 8px 0" : `8px ${max(room.width - room.clear.x - room.clear.width, 0) + 8}px 0 ${room.clear.x + 8}px`) gap=0
          if shown.length == 0
            Note(kind=(failed ? "failed" : loading ? "loading" : "empty"), text=(failed ? "Can't reach hex. Check that Tailscale is on." : loading ? "Loading your calls" : "No calls yet. When a call ends, it lands here with what was said."), pad="24px 12px", id=(failed ? "calls-offline" : loading ? "calls-loading" : "calls-empty"))
          else
            if failed
              Note(kind="failed", text="Can't reach hex. These are the calls it last sent.", pad="8px 12px", id="calls-stale")
            for d in days key=d
              text d role="heading" aria-level=2 font="-exact-subheadline" font-weight=600 color="-exact-secondary-label" padding="18px 12px 6px" testId=`calls-day-${d}`
              for c in shown.filter(x => dayHead(x.started, now, offset) == d) key=c.id
                if c.id == undoable
                  DeletedRow(c=c, undo=undoRemove)
                else
                  CallRowView(c=c, now=now, offset=offset, two=two, selected=(two and c.id == selected), select=select, remove=remove, removing=removing, removeError=removeError)

// One call: a disc with how it came in, its name, when and what came of it, and how long.
// Swiped from the right, Delete.
component CallRowView
  inject
    haptics: bool
  props
    c: CallRow
    now: number
    offset: number
    two: bool
    selected: bool
    select: action
    remove: action
    removing: string
    removeError: string
  view
    // Under each row a hairline from its disc to its length, as drawn.
    column
      scroll swipeContent=`${c.id}-row` swipeTrailing=(c.live ? "" : `${c.id}-delete`) display="flex" overflow-x="scroll" overflow-y="hidden" scrollbar-width="none" scroll-snap-type="x mandatory" testId=`call-${c.id}`
        link id=`${c.id}-row` href=(two ? "" : path("pastCall", c.id)) press=select(c.id) class=RowTap width="100%" flex-shrink=0 scroll-snap-align="start" gap=14 align-items="center" padding="10px 12px" background-color=(selected ? "-exact-tertiary-fill" : "transparent") aria-current=selected aria-label=`${nameOf(c)}, ${c.live ? "live now" : `${detailOf(c, now, offset)}, ${clockOf(c.seconds)} long`}` -exact-press-haptic=(haptics ? "selection" : "none") testId=`call-open-${c.id}`
          box width=40 height=40 border-radius=20 flex-shrink=0 background-color=(c.live ? "hex.progress.wash" : "-exact-tertiary-fill") display="flex" align-items="center" justify-content="center" aria-hidden=true
            image sourceSymbol(c.source) width=18 height=18 object-fit="contain" color=(c.live ? "hex.progress" : "-exact-label")
          column flex=1 min-width=0 gap=2
            text nameOf(c) font="-exact-body" color="-exact-label" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId=`call-name-${c.id}`
            row gap=4 align-items="baseline" min-width=0
              if c.live
                text "Live now" font="-exact-subheadline" color="hex.progress"
              else
                text detailOf(c, now, offset) font="-exact-subheadline" color="-exact-secondary-label" white-space="nowrap" flex-shrink=0
                if endShort(c.ending) != ""
                  text `· ${endShort(c.ending)}` font="-exact-subheadline" color=(endBad(c.ending) ? "hex.danger" : "-exact-secondary-label") white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
            if c.id == removing and removeError != ""
              text `Not deleted · ${removeError}` font="-exact-footnote" color="hex.danger" testId=`call-error-${c.id}`
          if not c.live
            text clockOf(c.seconds) font="-exact-body" font-variant-numeric="tabular-nums" color="-exact-secondary-label" flex-shrink=0
        if not c.live
          button id=`${c.id}-delete` press=remove(c.id) destructive=true flex-shrink=0 scroll-snap-align="start" testId=`delete-${c.id}`
            image "symbol:delete"
            text "Delete"

      box height=0.5 margin="0 12px" background-color="-exact-separator" aria-hidden=true

// A call just deleted: what it was, and Undo, until hex is told.
component DeletedRow
  inject
    haptics: bool
  props
    c: CallRow
    undo: action
  view
    row gap=14 align-items="center" padding="10px 12px" min-height=60 box-sizing="border-box" aria-live="polite" testId=`deleted-${c.id}`
      box width=40 height=40 flex-shrink=0 display="flex" align-items="center" justify-content="center" aria-hidden=true
        image "symbol:delete" width=18 height=18 object-fit="contain" color="-exact-tertiary-label"
      text `Deleted “${nameOf(c)}”` font="-exact-subheadline" color="-exact-secondary-label" flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
      button press=undo class=PillTap -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`Undo, keep “${nameOf(c)}”` testId=`undo-delete-${c.id}`
        box class=PillFace
          text "Undo" font="-exact-subheadline" font-weight=600 color="-exact-label"
