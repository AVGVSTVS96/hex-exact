// hex decided: what hex took off Bassim's list in the last week to decide itself. Each row is the
// topic and the question; a tap opens its whole story in place: what hex picked, why, and what
// the other answers gave up. Undo puts it back in Needs you. A page over Home, or with two columns
// the page beside it; `/decided?open=<id>` opens with that one open and in view.
use Ask, AskOption, Asks, Tasks from "./shapes.contract"
use Mark, Note, RowTap, PillTap, PillFace, Tap, whenOf, springOf, Prose from "./parts.contract"
use Room, Chrome from "./room.contract"
use PageTitle from "./calls.contract"
use Said, failedWords from "./said.contract"
use homeOf from "./inbox.contract"

// The answer hex took, as the question words it: hex names it short ("Send it") where the answer
// runs on ("Send it: asks for your free months back"), so the one it starts is the answer.
fn tookOf(a: Ask): string = a.took != "" ? match a.options.filter(o => o.label == a.took or o.label.startsWith(a.took)).at(0) { case some(o) => o.label, case none => a.took } : match a.options.filter(o => o.pick).at(0) { case some(o) => o.label, case none => "" }
fn tookDetail(a: Ask): string = match a.options.filter(o => o.label == tookOf(a)).at(0) { case some(o) => o.detail, case none => "" }
fn othersOf(a: Ask): AskOption[] = a.options.filter(o => o.label != tookOf(a))
fn decidedPath(id: string): string = id == "" ? path("decided") : `${path("decided")}?open=${encodeURIComponent(id)}`

component DecidedPage
  props
    entry: Entry
    room: Room
    now: number
    offset: number
    asks: Asks
    tasks: Tasks
    said: Said[]
    needsYou: number
    working: number
    loading: bool
    failed: bool
    undo: action
    openTask: action
    open: action
    openTasks: action
    back: action
  view
    column navigationKey=`${entry.id}` navigationBar="none" -exact-safe-area="none" position="absolute" inset=0 background-color="-exact-background" testId="decided"
      Chrome(room=room, on="decided", needsYou=needsYou, working=working, open=open, openTasks=openTasks, back=back)
      DecidedList(room=room, opened=searchParam(entry, "open"), now=now, offset=offset, asks=asks, tasks=tasks, said=said, loading=loading, failed=failed, undo=undo, openTask=openTask)

component DecidedList
  inject
    haptics: bool
  props
    // The one to open first and bring into view ("" for none).
    opened: string
    room: Room
    now: number
    offset: number
    asks: Asks
    tasks: Tasks
    said: Said[]
    loading: bool
    failed: bool
    undo: action
    openTask: action
  // The one open in place; "-" once Bassim has shut the one he came to.
  state toggled = ""
  derive shown = toggled == "" ? opened : toggled
  derive decided = asks.decided
  derive known = asks.version > 0
  action choose(id: string)
    toggled = two ? id : shown == id ? "-" : id
  // With two columns the list is in hex's column and the story beside it, the first until he picks.
  derive two = room.columns == 2
  derive beside = match decided.filter(a => a.id == shown).at(0) { case some(a) => a.id, case none => match decided.at(0) { case some(a) => a.id, case none => "" } }
  view
    scroll id="decided-list" position="absolute" top=room.below bottom=0 left=(two ? room.first.x : 0) width=(two ? room.first.width : room.width) padding-bottom=(room.foot + 24) scroll-padding-top=max(room.headBottom + 8 - room.below, 0) box-sizing="border-box" mask-image="linear-gradient(to bottom, transparent 0, #000 12px, #000 100%)" testId="decided-list"
      PageTitle(text="hex decided", room=room, left=(two ? 20 : room.clear.x + 20), id="decided-title")
      column padding=(two ? "0 10px" : `0 ${max(room.width - room.clear.x - room.clear.width, 0) + 10}px 0 ${room.clear.x + 10}px`)
        text (known ? `${decided.length} this week · Undo puts it back to you` : " ") font="-exact-subheadline" color="-exact-secondary-label" padding="2px 10px 14px"
        if known and decided.length == 0
          Note(kind="empty", text="Nothing this week. What hex decides for you shows here.", pad="24px 12px", id="decided-empty")
        if failed and not known
          Note(kind="failed", text="Can't reach hex. Trying again…", pad="24px 10px", id="decided-offline")
        if loading and not known and not failed
          Note(kind="loading", text="Loading what hex decided", pad="24px 10px", id="decided-loading")
        for a in decided key=a.id
          DecidedStory(ask=a, open=(two ? beside == a.id : shown == a.id), inline=(not two), now=now, offset=offset, failure=match said.filter(s => s.id == a.id and s.status == "failed").at(-1) { case some(s) => failedWords(s), case none => "" }, toggle=choose(a.id), undo=undo(a.id), openTopic=openTask(homeOf(a.task, tasks.tasks)))
    if two
      scroll position="absolute" top=room.secondBelow bottom=0 left=room.second.x width=room.second.width padding=`8px 20px ${room.foot + 24}px` box-sizing="border-box" testId="decided-beside"
        for a in decided.filter(x => x.id == beside) key=a.id
          column gap=10
            text a.topic font="-exact-subheadline" color="-exact-secondary-label"
            text a.question font="-exact-title2" font-weight=700 role="heading" aria-level=2 user-select="text"
            DecidedBody(ask=a, openTopic=openTask(homeOf(a.task, tasks.tasks)))

// One thing hex decided, opened from Feed with two columns: beside Feed, as an idea or a goal is.
component DecidedPane
  inject
    haptics: bool
  props
    id: string
    asks: Asks
    tasks: Tasks
    loading: bool
    failed: bool
    // How far the heading stays off the column's trailing edge, and its least height (as IdeaBody).
    inset: number
    head: number
    foot: number
    undo: action
    openTask: action
  derive known = asks.version > 0
  view
    scroll flex=1 min-height=0 padding=`4px 16px ${foot + 24}px` box-sizing="border-box" testId="decided-pane"
      if not known and failed
        Note(kind="failed", text="Can't reach hex. Trying again…", pad="24px 0", id="decided-pane-offline")
      if not known and not failed
        Note(kind="loading", text="Loading what hex decided", pad="24px 0", id="decided-pane-loading")
      if known and asks.decided.filter(a => a.id == id).length == 0
        Note(kind="empty", text="Put back to you. It's in Needs you.", pad="24px 0", id="decided-pane-gone")
      for a in asks.decided.filter(x => x.id == id) key=a.id
        column gap=14
          column gap=4 padding-right=inset min-height=head box-sizing="border-box"
            text a.question font=(head > 0 ? "-exact-title2" : "-exact-title1") font-weight=700 color="-exact-label" line-clamp=(head > 0 ? 3 : 4) overflow-wrap="break-word" role="heading" aria-level=2 user-select="text" testId="decided-pane-title"
            text `hex decided · ${a.topic}` font="-exact-subheadline" color="-exact-secondary-label" line-clamp=1
          row
            button press=undo(a.id) class=PillTap -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`Undo, put “${a.question}” back in Needs you` testId=`decided-pane-undo-${a.id}`
              box class=PillFace
                text "Undo" font="-exact-subheadline" font-weight=600
          DecidedBody(ask=a, openTopic=openTask(homeOf(a.task, tasks.tasks)))

// One thing hex decided: its topic and question, Undo, and a chevron that says it opens in place;
// open, the whole story under it.
component DecidedStory
  inject
    haptics: bool
    still: bool
  props
    ask: Ask
    open: bool
    // One column: the story opens under the row. Two: it shows beside, and the row is marked.
    inline: bool
    now: number
    offset: number
    failure: string
    toggle: action
    undo: action
    openTopic: action
  derive took = tookOf(ask)
  derive others = othersOf(ask)
  view
    column id=`decided-${ask.id}` border-bottom="0.5px solid -exact-separator" testId=`decided-story-${ask.id}`
      row align-items="center" gap=0
        button press=toggle class=RowTap flex=1 min-width=0 width="auto" background-color=(open and not inline ? "-exact-tertiary-fill" : "transparent") aria-current=(open and not inline) aria-expanded=(inline ? open : false) aria-label=`hex decided, ${ask.topic}: ${ask.question}` -exact-press-haptic=(haptics ? "selection" : "none") testId=`decided-open-${ask.id}`
          box padding-top=1 flex-shrink=0
            Mark(state="decided", size=22)
          column flex=1 min-width=0 gap=2
            row gap=8 align-items="baseline"
              text ask.topic font="-exact-headline" color="-exact-label" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" flex-shrink=1 min-width=0
              box flex=1
              text whenOf(ask.decided, now, offset) font="-exact-caption1" font-variant-numeric="tabular-nums" color="-exact-tertiary-label" white-space="nowrap"
            text (took != "" ? took : ask.question) font="-exact-subheadline" color="-exact-secondary-label" line-clamp=2
        button press=undo class=PillTap -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`Undo, put “${ask.question}” back in Needs you` testId=`decided-undo-${ask.id}`
          box class=PillFace
            text "Undo" font="-exact-subheadline" font-weight=600
        button press=toggle class=Tap width=36 min-height=44 display="flex" align-items="center" justify-content="center" aria-hidden=true testId=`decided-chevron-${ask.id}`
          image "symbol:sf/chevron.right" width=12 height=12 object-fit="contain" color="-exact-tertiary-label" rotate=(open and inline ? "90deg" : "0deg") transition=springOf(still, "rotate")
      if failure != ""
        row gap=8 align-items="center" padding="0 10px 8px 44px" flex-wrap="wrap"
          text failure font="-exact-footnote" color="hex.danger" flex=1 testId=`decided-failed-${ask.id}`
          button press=undo class=PillTap testId=`decided-retry-${ask.id}`
            box class=PillFace padding="4px 10px"
              text "Try again" font="-exact-footnote" font-weight=600
      if open and inline
        column gap=14 padding="2px 10px 16px 44px"
          // The row's line is the question when hex gave no short answer; it isn't said twice.
          if took != ""
            text ask.question font="-exact-headline" color="-exact-label" user-select="text"
          DecidedBody(ask=ask, openTopic=openTopic)

// The whole story of one: what it was about, what hex picked, why, what the others gave up, and
// its topic one tap away.
component DecidedBody
  props
    ask: Ask
    openTopic: action
  derive took = tookOf(ask)
  derive others = othersOf(ask)
  view
    column gap=14 testId=`decided-body-${ask.id}`
      if ask.context != ""
        Prose(text=ask.context, font="-exact-subheadline", color="-exact-secondary-label")
      if took != ""
        column gap=4
          Label(text="hex picked")
          text took font="-exact-headline" color="hex.accent" user-select="text"
          if tookDetail(ask) != ""
            text tookDetail(ask) font="-exact-subheadline" color="-exact-secondary-label"
      if ask.why != ""
        column gap=4
          Label(text="Why")
          Prose(text=ask.why, font="-exact-body", color="-exact-label")
      if others.length > 0
        column gap=6
          Label(text=(took == "" ? "The answers it had" : others.length == 1 ? "What the other answer gave up" : "What the other answers gave up"))
          for o in others key=o.label
            column gap=1
              text o.label font="-exact-body" color="-exact-label"
              if o.detail != ""
                text o.detail font="-exact-subheadline" color="-exact-secondary-label"
      button press=openTopic class=Tap display="flex" flex-direction="row" gap=6 align-items="center" min-height=44 aria-label=`Open ${ask.topic}` testId=`decided-topic-${ask.id}`
        text `Open ${ask.topic}` font="-exact-subheadline" font-weight=600 color="-exact-label"
        image "symbol:sf/chevron.right" width=10 height=10 object-fit="contain" color="-exact-tertiary-label"

// A small head inside a story.
component Label
  props
    text: string
  view
    text text font="-exact-caption1" font-weight=600 color="-exact-secondary-label" text-transform="uppercase" letter-spacing=0.6
