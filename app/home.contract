// hex as the home (the Muse review's first change): hex's face and one live line of what it's doing,
// then the list of the page under it. Now is the few things that need Bassim, what hex is working
// on and what it decided for him; Feed, Ideas and Goals join it as tabs at the foot of hex's column.
// Home shows it whenever no call is on; Tasks has the rest.
use Tasks, Ask, Asks, TaskRow, Goals from "./shapes.contract"
use Mark, StageHead, ShowMore, Row, Note, RowTap, whenOf, dayOf, Tap, springOf from "./parts.contract"
use Said from "./said.contract"
use FeedList, FeedView from "./feed.contract"
use IdeasList, Ideas, Idea from "./ideas.contract"
use GoalsList from "./goals.contract"
use Item, entriesOf, homeOf, problemOf from "./inbox.contract"

// hex's face in its column: stacked (the orb over its name and live line) when the window is
// taller than wide, else one row (the orb beside them). `x`, `y` are the orb's centre from the
// column's top left, so the call's orb (call.contract) rests exactly where the face is drawn and
// grows out of it.
shape Face
  compact: bool
  height: number
  x: number
  y: number
  size: number

fn faceOf(width: number, compact: bool): Face = compact ? Face(compact=true, height=72, x=44, y=36, size=56) : Face(compact=false, height=140, x=width / 2, y=40, size=72)

// What Bassim put away here leaves at once, as in Tasks.
fn awayOf(said: Said[]): string[] = said.filter(s => s.verb != "note" and s.status != "failed").map(s => s.id)
// What waits for Bassim's answer, as Tasks lists it: questions (a pick of hex's still waits on
// him), threads that wait on him and stuck runs. A result he hasn't seen is new in Feed, not here;
// what hex decided itself has left already (asks.decided).
fn needsOf(tasks: Tasks, asks: Asks, said: Said[], now: number): Item[] = entriesOf(tasks, asks, now).filter(e => e.stage == "needs" and e.kind != "fresh" and not awayOf(said).includes(e.id))
// The page a row opens: its thread's main page, "" for what has none (a stuck run).
fn pageFor(e: Item, tasks: Tasks): string = e.page == "" ? "" : homeOf(e.page, tasks.tasks)
// The page beside Home with two columns until Bassim picks one: the first thing that needs him.
fn firstNeed(tasks: Tasks, asks: Asks, said: Said[], now: number): string = match needsOf(tasks, asks, said, now).filter(e => e.page != "").at(0) { case some(e) => homeOf(e.page, tasks.tasks), case none => "" }
// What hex is doing right now: the thread that moved last of those running.
fn liveOf(tasks: Tasks): option<TaskRow> = sortBy(tasks.tasks.filter(t => t.state == "working" and t.running), t => t.at, "desc").at(0)
fn lineOf(t: TaskRow): string = t.line != "" ? t.line : match t.agents.filter(a => a.state == "working" and a.line != "").at(0) { case some(a) => a.line, case none => "" }
// A row's mark, as Tasks draws its topic's.
fn markOf(e: Item): string = e.stage == "needs" ? (e.kind == "task" ? "needs" : e.mark) : problemOf(e.title) != "" ? "failed" : e.mark
fn lineFor(e: Item): string = problemOf(e.title) != "" ? problemOf(e.title) : e.title

keyframes liveDot
  50% opacity=0.25

component HexHome
  props
    // The column's size; the window's shape picks the face (faceOf).
    width: number
    height: number
    compact: bool
    // Whether to draw hex's orb here; where the call's own orb rests in its place, only its room.
    face: bool
    persona: string
    personaColor: string
    palette: string
    reaction: string
    still: bool
    // How far in from the column's trailing edge, and down from its top, the status icons beside
    // the band under the chrome reach (room.headEnd, room.headBottom); the face's one row keeps
    // clear of them.
    headRight: number
    headDown: number
    // hex's pages that are built, and the one under the face.
    pages: string[]
    page: string
    now: number
    offset: number
    tasks: Tasks
    asks: Asks
    said: Said[]
    // hex's counts of what needs Bassim and what's working.
    needing: number
    workingOn: number
    loading: bool
    failed: bool
    // With two columns rows open beside; the page that's there, "" when the call's words are.
    split: bool
    beside: string
    select: action
    openTask: action
    openTasks: action
    open: action
    feed: FeedView
    openFeed: action
    discuss: action
    undo: action
    moreFeed: action
    retryFeed: action
    ideas: Ideas
    heldIdea: Idea
    ideasFailed: bool
    openIdea: action
    retryIdeas: action
    goals: Goals
    goalsOpened: string[]
    goalsChosen: bool
    goalsFailed: bool
    goalsWhy: string
    toggleProject: action
    openGoal: action
    openWatch: action
    retryGoals: action
  // What the call just left (how it ended, its wrap-up), at the top of Now.
  slot
  derive known = tasks.version > 0 or asks.version > 0
  derive f = faceOf(width, compact)
  derive live = liveOf(tasks)
  derive liveId = match live { case some(t) => t.id, case none => "" }
  derive liveLine = match live { case some(t) => (lineOf(t) != "" ? lineOf(t) : `Working on ${t.name}`), case none => "" }
  derive liveTopic = match live { case some(t) => t.name, case none => "" }
  derive lineText = not known ? " " : liveId == "" ? "Nothing running" : liveLine
  // Each tab's list starts under the face and ends at the column's foot, above the tabs and Call;
  // what scrolls there fades over its last 26pt, and on Now over its first 12, under the face.
  derive listHeight = max(height - f.height, 1)
  // Now's lists, worked out here, once, rather than inside the per-tab loop.
  derive needs = needsOf(tasks, asks, said, now)
  derive working = sortBy(entriesOf(tasks, asks, now).filter(e => e.stage == "working"), e => e.at, "desc")
  derive fade = max(100 - 26 * 100 / listHeight, 0)
  derive wholeFade = max(100 - 26 * 100 / max(height, 1), 0)
  // The face in one row, as it heads Feed, Ideas and Goals scrolled: its live line on one line.
  derive row = Face(compact=true, height=max(76, headDown + 8), x=37, y=38, size=54)
  // The pages scrolled past hex's face, where its one row shows at the top; written only when a
  // page crosses that line, so nothing redraws while a list scrolls.
  state past: string[] = []
  action moved(p: string, x: number, y: number)
    let over = y > f.height - 40
    if over != past.includes(p)
      past = over ? past.concat([p]) : past.filter(q => q != p)
  action goLive
    if split
      select(homeOf(liveId, tasks.tasks))
    else
      openTask(homeOf(liveId, tasks.tasks))
  view
    column flex=1 min-height=0 position="relative" testId="home-all"
      // hex pages: each tab keeps its own scroll, mounted while another shows, so it keeps its place.
      // On Now hex's face stays over the list, the call's orb resting on it (call.contract); on the
      // others it heads the list with its own orb and scrolls away with it, and the face in one row
      // takes its place at the top.
      if page == "now"
        box position="absolute" top=0 left=0 right=0 padding=`0 ${f.compact ? 6 + headRight : 6}px 0 6px` testId="hex-face"
          HexFace(f=f, face=face, inset=headRight, persona=persona, personaColor=personaColor, palette=palette, reaction=reaction, still=still, known=known, liveId=liveId, liveTopic=liveTopic, lineText=lineText, goLive=goLive)
      for p in pages key=p
        scroll position="absolute" top=(p == "now" ? f.height : 0) left=0 right=0 bottom=0 padding="0 6px 34px" box-sizing="border-box" scroll=moved(p) opacity=(p == page ? 1 : 0) pointer-events=(p == page ? "auto" : "none") aria-hidden=(p != page) mask-image=`linear-gradient(to bottom, ${p == "now" ? "transparent 0, #000 12px" : "#000 0"}, #000 ${p == "now" ? fade : wholeFade}%, transparent 100%)` testId=`home-list-${p}`
          if p == "now"
            children
            NowList(wide=(width > height), now=now, offset=offset, tasks=tasks, needs=needs, working=working, decided=asks.decided, known=known, failed=failed, split=split, beside=beside, select=select, openTask=openTask, openTasks=openTasks, open=open)
          else
            HexFace(f=f, face=true, inset=headRight, persona=persona, personaColor=personaColor, palette=palette, reaction=reaction, still=still, known=known, liveId=liveId, liveTopic=liveTopic, lineText=lineText, goLive=goLive)
            if p == "feed"
              FeedList(feed=feed, now=now, offset=offset, width=(width - 12), beside=beside, open=openFeed, discuss=discuss, undo=undo, older=moreFeed, retry=retryFeed)
            else if p == "ideas"
              IdeasList(ideas=ideas, held=heldIdea, failed=ideasFailed, now=now, offset=offset, selected=(beside.startsWith("idea:") ? beside.slice(5) : ""), open=openIdea, retry=retryIdeas)
            else if p == "goals"
              GoalsList(goals=goals, now=now, offset=offset, failed=goalsFailed, why=goalsWhy, opened=goalsOpened, chosen=goalsChosen, beside=(split ? beside : ""), toggle=toggleProject, openGoal=openGoal, openWatch=openWatch, retry=retryGoals)
      // Its foot fades out over the list, so a row passing under it never shows cut in half.
      if page != "now"
        box position="absolute" top=0 left=0 right=0 height=(row.height + 20) background-color="-exact-background" mask-image="linear-gradient(to top, transparent 0, #000 20px)" opacity=(past.includes(page) ? 1 : 0) pointer-events=(past.includes(page) ? "auto" : "none") aria-hidden=(not past.includes(page)) transition=springOf(still, "opacity") testId="hex-bar"
          box padding-right=headRight
            HexFace(f=row, face=true, inset=0, persona=persona, personaColor=personaColor, palette=palette, reaction=reaction, still=still, known=known, liveId=liveId, liveTopic=liveTopic, lineText=lineText, goLive=goLive)

// hex's face at the head of a page: stacked (orb, name, live line) or one row with the window wider
// than tall; the orb only where Home draws it itself.
component HexFace
  props
    f: Face
    face: bool
    // Stacked, the live line keeps this far in from both edges, centred and clear of the status
    // icons beside it (headRight).
    inset: number
    persona: string
    personaColor: string
    palette: string
    reaction: string
    still: bool
    known: bool
    liveId: string
    liveTopic: string
    lineText: string
    goLive: action
  view
    if f.compact
      row gap=14 align-items="center" padding="0 10px" height=f.height box-sizing="border-box" flex-shrink=0 testId="hex"
        box width=f.size height=f.size flex-shrink=0
          if face
            hex-orb state="idle" silenced="false" persona=persona tint=personaColor palette=palette reaction=reaction still=(still ? "true" : "false") width=f.size height=f.size role="img" aria-label="hex"
        column flex=1 min-width=0 gap=2
          text "hex" font="-exact-headline" color="-exact-label"
          LiveLine(known=known, id=liveId, topic=liveTopic, line=lineText, still=still, center=false, lines=(f.size < 56 ? 1 : 2), press=goLive)
    else
      column align-items="center" padding="4px 10px 0" height=f.height box-sizing="border-box" flex-shrink=0 testId="hex"
        box width=f.size height=f.size flex-shrink=0
          if face
            hex-orb state="idle" silenced="false" persona=persona tint=personaColor palette=palette reaction=reaction still=(still ? "true" : "false") width=f.size height=f.size role="img" aria-label="hex"
        text "hex" font="-exact-headline" color="-exact-label" margin-top=6
        box align-self="stretch" display="flex" justify-content="center" padding=`0 ${inset}px` box-sizing="border-box"
          LiveLine(known=known, id=liveId, topic=liveTopic, line=lineText, still=still, center=true, lines=2, press=goLive)

// hex's live line: what it's doing, two lines at most, ending in an ellipsis; a tap opens that work.
component LiveLine
  props
    known: bool
    id: string
    topic: string
    line: string
    still: bool
    center: bool
    lines: number
    press: action
  view
    button press=press disabled=(id == "") class=Tap display="flex" flex-direction="row" align-items="flex-start" justify-content=(center ? "center" : "flex-start") gap=7 max-width="100%" min-width=44 min-height=44 margin-top=(center ? -2 : -12) padding=(center ? "2px 0 0" : "12px 0 0") box-sizing="border-box" aria-live="polite" aria-label=(id == "" ? "Nothing running" : `hex is working on ${topic}: ${line}`) testId="live-line"
      if id != ""
        row gap=3 flex-shrink=0 padding-top=8 aria-hidden=true
          for i in [0, 1, 2] key=i
            box width=4 height=4 border-radius=2 background-color="hex.progress" animation=(still ? "none" : `liveDot 1.2s ease-in-out ${i * 0.2}s infinite`)
      text line font="-exact-subheadline" color=(id == "" ? "-exact-tertiary-label" : "-exact-secondary-label") text-align=(center ? "center" : "left") line-clamp=lines min-width=0 flex-shrink=1

// Now: the first three things that need Bassim, then what hex decided for him this week, a bar a
// day; then the first three hex is working on, each with a pip per agent in it. Each head and "Show
// N more" opens its whole list. A room wider than tall holds the two side by side.
fn shownRows(): number = 3
fn agentsIn(e: Item, tasks: TaskRow[]): number = match tasks.filter(t => t.id == e.id).at(0) { case some(t) => t.agents.filter(a => a.state == "working").length, case none => 0 }
// The last seven days, oldest first: how many hex decided on each.
fn decidedWeek(decided: Ask[], now: number, offset: number): number[] = range(7).map(i => decided.filter(d => dayOf(d.decided, offset) == dayOf(now, offset) - 6 + i).length)

component NowList
  inject
    haptics: bool
  props
    wide: bool
    now: number
    offset: number
    tasks: Tasks
    needs: Item[]
    working: Item[]
    decided: Ask[]
    known: bool
    failed: bool
    split: bool
    beside: string
    select: action
    openTask: action
    openTasks: action
    open: action
  derive shownNeeds = needs.slice(0, shownRows())
  derive shownWork = working.slice(0, shownRows())
  derive week = decidedWeek(decided, now, offset)
  derive most = match sortBy(week, n => n, "desc").at(0) { case some(n) => max(1, n), case none => 1 }
  derive thisWeek = sum(week)
  // Questions of one topic open the same page beside; only one of its rows is marked: the one
  // tapped, else the first.
  state tapped = ""
  derive lit = split and beside != "" ? match sortBy(shownNeeds.concat(shownWork).filter(e => pageFor(e, tasks) == beside), e => (e.id == tapped ? 0 : 1)).at(0) { case some(e) => e.id, case none => "" } : ""
  action go(e: Item)
    if pageFor(e, tasks) == ""
      openTasks(e.stage)
    else if split
      tapped = e.id
      select(pageFor(e, tasks))
    else
      openTask(pageFor(e, tasks))
  view
    column testId="home-now"
      if failed and not known
        Note(kind="failed", text="Can't reach hex. Trying again…", pad="24px 10px", id="home-offline")
      row flex-direction=(wide ? "row" : "column") align-items=(wide ? "flex-start" : "stretch")
        column flex=(wide ? 1 : 0) min-width=0 testId="home-needs"
          StageHead(state="asks", label="Needs you", n=needs.length, known=known, opens=true, pad="9px 10px", id="home-head-asks", press=openTasks("needs"))
          for e in shownNeeds key=e.id
            Row(mark=markOf(e), title=e.topic, line=lineFor(e), lines=2, failed=(problemOf(e.title) != ""), stamp=whenOf(e.at, now, offset), n=0, pips=0, selected=(e.id == lit), href="", label=`${e.topic}: ${lineFor(e)}`, id=`home-row-${e.id}`, press=go(e))
          if known and needs.length == 0
            Note(kind="empty", text="Nothing waits on you", pad="6px 10px 6px 42px", id="home-empty-needs")
          if needs.length > shownNeeds.length
            ShowMore(n=needs.length - shownNeeds.length, shown=false, pad="8px 10px 10px", id="home-more-needs", press=openTasks("needs"))
          if decided.length > 0
            button press=open(path("decided")) class=RowTap align-items="center" gap=10 -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`hex decided ${thisWeek} this week` testId="home-decided"
              Mark(state="decided", size=22)
              text font="-exact-headline" color="-exact-label" flex=1 min-width=0 text-align="left" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                text "hex decided"
                text ` ${thisWeek} this week` font-weight=400 color="-exact-secondary-label"
              row gap=3 align-items="flex-end" height=22 flex-shrink=0 aria-hidden=true testId="home-decided-week"
                for n, i in week key=i
                  box width=5 height=max(2, round(n / most * 22)) border-radius=2 background-color="hex.accent" opacity=(i == 6 ? 1 : 0.55)
              image "symbol:sf/chevron.right" width=12 height=12 object-fit="contain" color="-exact-tertiary-label" margin-left=4 aria-hidden=true
        if not wide
          box height=0 margin="5px -6px 5px 42px" border-top="0.5px solid -exact-separator"
        column flex=(wide ? 1 : 0) min-width=0 border-left=(wide ? "0.5px solid -exact-separator" : "none") testId="home-working"
          StageHead(state="working", label="Working on", n=working.length, known=known, opens=true, pad="9px 10px", id="home-head-working", press=openTasks("working"))
          for e in shownWork key=e.id
            Row(mark=markOf(e), title=e.topic, line=lineFor(e), lines=2, failed=(problemOf(e.title) != ""), stamp=whenOf(e.at, now, offset), n=0, pips=agentsIn(e, tasks.tasks), selected=(e.id == lit), href="", label=`${e.topic}: ${lineFor(e)}`, id=`home-row-${e.id}`, press=go(e))
          if known and working.length == 0
            Note(kind="empty", text="Nothing is working", pad="6px 10px 6px 42px", id="home-empty-working")
          if working.length > shownWork.length
            ShowMore(n=working.length - shownWork.length, shown=false, pad="8px 10px 10px", id="home-more-working", press=openTasks("working"))
