// The design system every screen shares: one set of surfaces, radii, marks and words, so hex
// Exact reads as one app. Colours name the platform's roles; the accent is hex's.
use Place from "./shapes.contract"

// A grouped surface on the stage (an ask card, a wrap-up, a stats card).
style Surface
  background-color="-exact-secondary-background" border-radius=22 padding=16

// The platform's glass circle, for a toolbar's or the call's icon buttons.
style Glass
  appearance="auto" buttonStyle="glass" width=44 height=44 flex-shrink=0

// A small capsule of text: an option, a count, a tag.
style Pill
  padding="7px 14px" border-radius=999 background-color="-exact-tertiary-fill"

// Where Bassim writes (a thread's message, his own answer to a question): one filled capsule with
// the field and its send inside, the same in both, visible in light mode without a border.
style Composer
  flex-direction="row" align-items="flex-end" gap=4 padding="0 4px 0 14px" min-height=44 border-radius=22 background-color="-exact-tertiary-fill" position="relative"

// A composer's words while it's empty, drawn as page text: iOS draws a field's own placeholder once
// and stretches that drawing when the Duo turns.
component FieldHint
  props
    text: string
  view
    text text position="absolute" left=14 top=11 right=48 font="-exact-body" color="-exact-placeholder" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" pointer-events="none" aria-hidden=true

// The field inside a Composer.
style ComposerField
  border="none" background-color="transparent" padding="11px 0" flex=1 min-width=0 font="-exact-body" color="-exact-label"

// Every control of ours shows a press the moment it's touched. A row's whole width greys under the
// finger; a capsule button (Undo, Send again, an inline answer, Discuss) dims and gives a little.
// Every target is at least 44pt each way: a capsule is drawn smaller (PillFace) inside its 44pt
// button (PillTap).
style RowTap
  appearance="none" display="flex" flex-direction="row" gap=12 align-items="flex-start" width="100%" box-sizing="border-box" text-align="left" padding="9px 10px" border-radius=12
  :active
    background-color="-exact-tertiary-fill"
style PillTap
  appearance="none" display="flex" align-items="center" justify-content="center" min-width=44 min-height=44 flex-shrink=0
  :active
    opacity=0.6
    -exact-press-scale=0.96
style PillFace
  display="flex" flex-direction="row" align-items="center" justify-content="center" padding="6px 12px" border-radius=999 background-color="-exact-tertiary-fill"
// A page's main action (Answer, Answer with 2): ink on the page, black in light and white in dark, as
// Muse's are, not the platform's filled tint, which keeps its label white and so can't be ink in
// dark. Switched off, it greys like any field.
style Primary
  appearance="none" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" justify-content="center" gap=6 min-height=44 padding="0 20px" border-radius=999 background-color="-exact-label" color="-exact-background" font="-exact-body" font-weight=600
  :active
    opacity=0.75
    -exact-press-scale=0.97
  :disabled
    background-color="-exact-tertiary-fill"
    color="-exact-tertiary-label"

// The send circle at the end of a Composer, the same ink as Primary.
style Send
  appearance="none" display="flex" align-items="center" justify-content="center" flex-shrink=0 width=36 height=36 margin="4px 0" border-radius=999 background-color="-exact-label" color="-exact-background"
  :active
    opacity=0.75
    -exact-press-scale=0.92
  :disabled
    background-color="-exact-tertiary-fill"
    color="-exact-tertiary-label"

// A plain tap target with no box of its own (an icon, a line of text): it dims under the finger.
style Tap
  appearance="none"
  :active
    opacity=0.5

// The one motion everything that moves shares, and none with Reduce Motion on. Anything dragged
// (a swiped row, the call's words pulled up, a sheet) is a native scroll with snap points, as
// rows.contract's swipes are: UIKit moves it with nothing re-rendered, a release carries on at the
// finger's speed, turning back before lifting springs it home, and state follows the snap.
fn springOf(still: bool, property: string): string = still ? "none" : `${property} -exact-spring(380, 34, 1)`

// The colour a state is drawn in, everywhere, each with one job: mint is hex's own choice (its pick,
// what it decided), amber a question or anything that waits on Bassim, blue work going on, red a
// failure or ending the call, grey the settled (app.tamber).
fn tintOf(state: string): string = state == "pick" or state == "decided" ? "hex.accent" : state == "needs" or state == "asks" ? "hex.ask" : state == "working" or state == "running" ? "hex.progress" : state == "failed" ? "hex.danger" : "-exact-secondary-label"
fn washOf(state: string): string = state == "pick" or state == "decided" ? "hex.accent.wash" : state == "needs" or state == "asks" ? "hex.ask.wash" : state == "working" or state == "running" ? "hex.progress.wash" : state == "failed" ? "hex.danger.wash" : "-exact-tertiary-fill"

fn symbolOf(state: string): string = state == "asks" ? "symbol:icon.ask" : state == "pick" ? "symbol:icon.pick" : state == "done" ? "symbol:icon.done" : state == "failed" ? "symbol:icon.failed" : state == "paused" ? "symbol:icon.paused" : ""

// Where a thread lives, as its tile: Telegram, T3 Code, Buzz, Discord, the server, a call, a link.
fn appName(app: string): string = app == "telegram" ? "Telegram" : app == "t3" ? "T3 Code" : app == "buzz" ? "Buzz" : app == "discord" ? "Discord" : app == "server" ? "Server" : app == "voice" or app == "call" ? "Call" : app == "link" ? "Link" : app
fn appSymbol(app: string): string = app == "telegram" ? "symbol:sf/paperplane.fill" : app == "t3" ? "symbol:sf/chevron.left.forwardslash.chevron.right" : app == "buzz" ? "symbol:sf/bolt.fill" : app == "discord" ? "symbol:sf/bubble.left.and.bubble.right.fill" : app == "server" ? "symbol:sf/terminal.fill" : app == "voice" or app == "call" ? "symbol:waveform" : "symbol:sf/arrow.up.right"
fn appTint(app: string): string = app == "telegram" ? "tile.telegram" : app == "t3" ? "tile.t3" : app == "buzz" ? "tile.buzz" : app == "discord" ? "tile.discord" : app == "server" ? "tile.server" : app == "voice" or app == "call" ? "hex.accent.solid" : "tile.link"

// When something happened, as the phone's own lists say it: the time today, "Yesterday", the
// weekday this week, the day this year ("Nov 14"), else the date with its year.
fn dayOf(at: number, offset: number): number = floor((at + offset * 60000) / 86400000)
fn weekdayOf(at: number, offset: number): string = match ["Thu", "Fri", "Sat", "Sun", "Mon", "Tue", "Wed"].at(dayOf(at, offset) % 7) { case some(d) => d, case none => "" }
fn whenOf(at: number, now: number, offset: number): string = at == 0 ? "" : dayOf(at, offset) == dayOf(now, offset) ? formatTime(at, offset, "short") : dayOf(at, offset) == dayOf(now, offset) - 1 ? "Yesterday" : dayOf(at, offset) > dayOf(now, offset) - 7 and dayOf(at, offset) < dayOf(now, offset) ? weekdayOf(at, offset) : formatDate(at, offset, "iso").slice(0, 4) == formatDate(now, offset, "iso").slice(0, 4) ? match formatDate(at, offset, "medium").split(", ").at(0) { case some(d) => d, case none => "" } : formatDate(at, offset, "medium")

// A call's length: "45 s", "3 min", "1 h 12 min".
// When a run started, said plainly. The clock here moves a minute at a time, so a run newer than
// its last tick would read as started in the future.
fn runStarted(since: number, now: number): string = now - since < 60000 ? "just started" : `started ${lengthOf((now - since) / 1000)} ago`
fn lengthOf(seconds: number): string = seconds < 60 ? `${round(max(0, seconds))} s` : seconds < 3600 ? `${round(seconds / 60)} min` : `${floor(seconds / 3600)} h ${round((seconds % 3600) / 60)} min`

// How a call ended, in Bassim's words; a bad ending is drawn red (badEnding).
fn endingOf(kind: string): string = kind == "you" ? "You hung up" : kind == "hex" ? "hex hung up" : kind == "dropped" ? "The call dropped" : kind == "expired" ? "The call ran out of time" : kind == "no-connect" ? "Couldn't connect" : kind == "no-answer" ? "No answer" : kind == "busy" ? "Busy" : ""
fn badEnding(kind: string): bool = kind == "dropped" or kind == "no-connect" or kind == "expired"

keyframes markSpin
  to rotate="360deg"

// A state's mark, in a square of `size`, as the drawings have them: a question an amber disc with
// ?; something only Bassim can do an empty box; hex's pick mint with ✦, and what hex decided a mint ✦
// on its wash; working a turning blue half ring; done a mint-checked box; failed red with a warning
// triangle. Feed, Ideas and Goals add theirs: something hex found (a lens), something it watches (a
// clock), an idea (a bulb) and a goal not started (a dashed box). Otherwise read a dot; paused,
// stopped, pending (dashed) and idle (a ring) in grey.
component Mark
  inject
    still: bool
  props
    state: string
    size: number
  derive square = size - 2
  derive dot = round(size * 0.4)
  derive glyph = round(size * 0.55)
  view
    box width=size height=size flex-shrink=0 display="flex" align-items="center" justify-content="center" aria-hidden=true
      if state == "working" or state == "running"
        svg width=square height=square viewBox="0 0 20 20" animation=(still ? "none" : "markSpin 1.1s linear infinite")
          circle cx=10 cy=10 r=8.75 fill="none" stroke="hex.progress.wash" stroke-width=2.5
          circle cx=10 cy=10 r=8.75 fill="none" stroke="hex.progress" stroke-width=2.5 stroke-dasharray="27.5 55"
      else if state == "needs"
        box width=square height=square border-radius=round(square * 0.3) border="1.75px solid -exact-tertiary-label" box-sizing="border-box"
      else if state == "done"
        box width=square height=square border-radius=round(square * 0.3) border="1.75px solid hex.accent" background-color="hex.accent.wash" box-sizing="border-box" display="flex" align-items="center" justify-content="center"
          image "symbol:icon.done" width=round(size * 0.5) height=round(size * 0.5) object-fit="contain" color="hex.accent"
      else if state == "decided"
        box width=size height=size border-radius=(size / 2) background-color="hex.accent.wash" display="flex" align-items="center" justify-content="center"
          image "symbol:icon.pick" width=round(size * 0.6) height=round(size * 0.6) object-fit="contain" color="hex.accent"
      else if state == "asks"
        box width=size height=size border-radius=(size / 2) background-color="hex.ask.fill" display="flex" align-items="center" justify-content="center"
          image "symbol:icon.ask" width=glyph height=glyph object-fit="contain" color="hex.ask.ink"
      else if state == "pick"
        box width=size height=size border-radius=(size / 2) background-color=tintOf(state) display="flex" align-items="center" justify-content="center"
          image symbolOf(state) width=glyph height=glyph object-fit="contain" color="-exact-background"
      else if state == "failed"
        box width=size height=size border-radius=(size / 2) background-color="hex.danger.wash" display="flex" align-items="center" justify-content="center"
          image "symbol:icon.stuck" width=glyph height=glyph object-fit="contain" color="hex.danger"
      else if state == "paused"
        box width=size height=size border-radius=(size / 2) background-color=washOf(state) display="flex" align-items="center" justify-content="center"
          image symbolOf(state) width=glyph height=glyph object-fit="contain" color="-exact-secondary-label"
      else if state == "found" or state == "watch" or state == "idea"
        box width=size height=size border-radius=(size / 2) background-color="-exact-tertiary-fill" display="flex" align-items="center" justify-content="center"
          image (state == "found" ? "symbol:icon.found" : state == "watch" ? "symbol:icon.watch" : "symbol:icon.ideas") width=glyph height=glyph object-fit="contain" color="-exact-label"
      else if state == "read"
        box width=dot height=dot border-radius=(dot / 2) background-color="-exact-tertiary-label"
      else if state == "stopped"
        box width=dot height=dot border-radius=2 background-color="-exact-tertiary-label"
      else if state == "pending"
        box width=(square - 2) height=(square - 2) border-radius=(square / 2) border="1.5px dashed -exact-tertiary-label"
      else if state == "unstarted"
        box width=square height=square border-radius=round(square * 0.3) border="1.5px dashed -exact-tertiary-label"
      else
        box width=dot height=dot border-radius=(dot / 2) border="1.5px solid -exact-tertiary-label"

// A section of a list by state: its colour's dot on its wash, its name in that colour, how many
// ("–" until hex has answered), and, where it opens the whole list (`opens`), a chevron and `press`.
component StageHead
  inject
    haptics: bool
  props
    state: string
    label: string
    n: number
    known: bool
    opens: bool
    pad: string
    id: string
    press: action
  view
    if opens
      button press=press class=RowTap align-items="center" gap=10 padding=pad aria-label=`${label}, ${n}, show all` -exact-press-haptic=(haptics ? "selection" : "none") testId=id
        StageLine(state=state, label=label, n=n, known=known, opens=true)
    else
      row gap=10 align-items="center" padding=pad role="heading" aria-level=2 aria-label=`${label}, ${n}` testId=id
        StageLine(state=state, label=label, n=n, known=known, opens=false)

component StageLine
  props
    state: string
    label: string
    n: number
    known: bool
    opens: bool
  view
    box width=22 height=22 border-radius=11 background-color=washOf(state) display="flex" align-items="center" justify-content="center" flex-shrink=0
      box width=8 height=8 border-radius=4 background-color=tintOf(state)
    text label font="-exact-headline" color=tintOf(state) flex=1
    text (known ? `${n}` : "–") font="-exact-subheadline" font-variant-numeric="tabular-nums" color="-exact-tertiary-label"
    if opens
      image "symbol:sf/chevron.right" width=12 height=12 object-fit="contain" color="-exact-tertiary-label" aria-hidden=true

// "Show N more" under the first few of a list: the rows' mark column holds a grid of six dots.
component ShowMore
  inject
    haptics: bool
  props
    n: number
    shown: bool
    pad: string
    id: string
    press: action
  view
    button press=press class=RowTap align-items="center" gap=10 padding=pad aria-expanded=shown -exact-press-haptic=(haptics ? "selection" : "none") testId=id
      column width=22 gap=3 align-items="center" flex-shrink=0 aria-hidden=true
        for r in [0, 1] key=r
          row gap=3
            for c in [0, 1, 2] key=c
              box width=3 height=3 border-radius=1.5 background-color="-exact-tertiary-label"
      text (shown ? "Show fewer" : `Show ${n} more`) font="-exact-subheadline" color="-exact-tertiary-label" flex=1

// The one row every list draws (Home, Tasks, what hex decided): its mark, a title in full-strength
// type, a count when there's more than one, when, and a grey line under it (red when it's a
// failure). It opens with `href` (a pushed page, a native list's row and its press) or, with no
// href, `press` (a page beside, a sheet).
// A question's line is in full-strength type, as Bassim has to read it. `pips` is a blue pip per
// agent working in it. selected marks the row whose page is open beside the list, in a soft fill.
component Row
  inject
    haptics: bool
  props
    mark: string
    title: string
    line: string
    lines: number
    failed: bool
    stamp: string
    n: number
    pips: number
    selected: bool
    href: string
    label: string
    id: string
    press: action
  view
    if href != ""
      link href=href class=RowTap gap=10 border-radius=14 background-color=(selected ? "-exact-quaternary-fill" : "transparent") aria-current=selected -exact-press-haptic=(haptics ? "selection" : "none") aria-label=label testId=id
        RowLines(mark=mark, title=title, line=line, lines=lines, failed=failed, stamp=stamp, n=n, pips=pips)
    else
      button press=press class=RowTap gap=10 border-radius=14 background-color=(selected ? "-exact-quaternary-fill" : "transparent") aria-current=selected -exact-press-haptic=(haptics ? "selection" : "none") aria-label=label testId=id
        RowLines(mark=mark, title=title, line=line, lines=lines, failed=failed, stamp=stamp, n=n, pips=pips)

component RowLines
  props
    mark: string
    title: string
    line: string
    lines: number
    failed: bool
    stamp: string
    n: number
    pips: number
  view
    box padding-top=1 flex-shrink=0
      Mark(state=mark, size=22)
    column flex=1 min-width=0 gap=2
      row gap=8 align-items="baseline"
        text title font="-exact-headline" color="-exact-label" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" flex-shrink=1 min-width=0
        if n > 1
          Chip(n=n, state=mark, loading=false)
        if pips > 0
          row gap=3 align-self="center" flex-shrink=0 aria-label=`${pips} ${pips == 1 ? "agent" : "agents"}`
            for i in range(min(pips, 4)) key=i
              box width=5 height=5 border-radius=2.5 background-color="hex.progress"
            if pips > 4
              text `${pips}` font-size=12 line-height="16px" font-weight=600 font-variant-numeric="tabular-nums" color="hex.progress" margin-left=2
        box flex=1
        text stamp font="-exact-footnote" font-variant-numeric="tabular-nums" color="-exact-tertiary-label" white-space="nowrap"
      if line != "" and line != title
        text line font="-exact-subheadline" color=(failed ? "hex.danger" : mark == "asks" ? "-exact-label" : "-exact-secondary-label") line-clamp=lines

// What a list says when it has nothing to show: empty, still loading, or can't reach hex. Every
// screen says it the same way, in the rows' column.
component Note
  props
    kind: string
    text: string
    pad: string
    id: string
  view
    row gap=10 align-items="center" justify-content=(kind == "empty" ? "flex-start" : "center") padding=pad aria-live="polite" testId=id
      if kind == "loading"
        progress aria-label=text
      else if kind == "failed"
        image "symbol:icon.offline" width=15 height=15 object-fit="contain" color="-exact-secondary-label" aria-hidden=true
      text text font="-exact-subheadline" color="-exact-secondary-label"

// hex writes Markdown. Prose draws it as reading text: paragraphs, bullets, headings, quotes and code,
// with a paragraph's lead in bold kept bold and the marks themselves (**, `, a link's address) gone.
// plainOf is the same words on one line, for a preview.
shape ProseLine
  kind: string
  lead: string
  text: string
  space: bool

fn pieceOf(xs: string[], i: number): string = match xs.at(i) { case some(x) => x, case none => "" }
fn dropLastOpen(s: string): string = s.split("[").length > 1 ? `${s.split("[").slice(0, -1).join("[")}${pieceOf(s.split("["), s.split("[").length - 1)}` : s
fn afterParen(s: string): string = s.indexOf(")") >= 0 ? s.slice(s.indexOf(")") + 1) : s
fn unlinkPiece(xs: string[], i: number): string = i < xs.length - 1 ? dropLastOpen(i == 0 ? pieceOf(xs, i) : afterParen(pieceOf(xs, i))) : (i == 0 ? pieceOf(xs, i) : afterParen(pieceOf(xs, i)))
fn unlinked(s: string): string = s.indexOf("](") < 0 ? s : range(s.split("](").length).map(i => unlinkPiece(s.split("]("), i)).join("")
fn inlineOf(s: string): string = unlinked(s).replaceAll("**", "").replaceAll("`", "")
fn isFence(l: string): bool = l.trim().startsWith("```")
fn inCode(lines: string[], i: number): bool = lines.slice(0, i).filter(l => isFence(l)).length % 2 == 1
fn bulletOf(t: string): bool = t.startsWith("- ") or t.startsWith("* ") or t.startsWith("+ ") or t.startsWith("• ")
fn proseKind(lines: string[], i: number): string = isFence(pieceOf(lines, i)) ? "fence" : inCode(lines, i) ? "code" : pieceOf(lines, i).trim() == "" ? "gap" : bulletOf(pieceOf(lines, i).trim()) ? "item" : pieceOf(lines, i).trim().startsWith("#") ? "head" : pieceOf(lines, i).trim().startsWith(">") ? "quote" : "p"
fn proseBody(t: string, kind: string): string = kind == "item" ? t.slice(2) : kind == "head" ? t.split(" ").slice(1).join(" ") : kind == "quote" ? t.slice(1).trim() : t
// A line that opens in bold: its bold lead, then the rest.
fn leadOf(t: string): string = t.startsWith("**") and t.split("**").length >= 3 ? inlineOf(pieceOf(t.split("**"), 1)) : ""
fn restOf(t: string): string = t.startsWith("**") and t.split("**").length >= 3 ? inlineOf(t.split("**").slice(2).join("**")) : inlineOf(t)
fn proseLine(lines: string[], i: number): ProseLine = ProseLine(kind=proseKind(lines, i), lead=(proseKind(lines, i) == "code" ? "" : leadOf(proseBody(pieceOf(lines, i).trim(), proseKind(lines, i)))), text=(proseKind(lines, i) == "code" ? pieceOf(lines, i) : restOf(proseBody(pieceOf(lines, i).trim(), proseKind(lines, i)))), space=(i > 0 and (proseKind(lines, i - 1) == "gap" or proseKind(lines, i - 1) == "fence")))
fn proseOf(text: string): ProseLine[] = range(text.split("\n").length).map(i => proseLine(text.split("\n"), i)).filter(l => l.kind != "gap" and l.kind != "fence")
fn plainOf(text: string): string = proseOf(text).map(l => l.lead != "" ? `${l.lead}${l.text}` : l.text).join(" ")

component Prose
  props
    text: string
    font: string
    color: string
  view
    column gap=4 min-width=0
      for l, i in proseOf(text) key=`${i}`
        if l.kind == "code"
          text l.text font-family="ui-monospace" font="-exact-footnote" color="-exact-secondary-label" white-space="pre-wrap" padding-left=10 user-select="text"
        else if l.kind == "item"
          row gap=8 align-items="flex-start" margin-top=(l.space and i > 0 ? 6 : 0)
            text "•" font=font color=color
            text font=font color=color flex=1 min-width=0 user-select="text" overflow-wrap="break-word"
              text l.lead font-weight=600
              text l.text
        else
          text font=font color=(l.kind == "quote" ? "-exact-secondary-label" : color) font-weight=(l.kind == "head" ? 600 : 400) margin-top=(l.space and i > 0 ? 8 : 0) padding-left=(l.kind == "quote" ? 10 : 0) user-select="text" overflow-wrap="break-word"
            text l.lead font-weight=600
            text l.text

// A count in its state's ink on its wash ("–" while loading).
component Chip
  props
    n: number
    state: string
    loading: bool
  view
    text (loading ? "–" : `${n}`) font="-exact-caption1" font-weight=600 font-variant-numeric="tabular-nums" padding="1px 7px" border-radius=999 color=tintOf(state) background-color=washOf(state)

// A place's brand tile; an unlinked one is a ghost outline.
component PlaceTile
  props
    place: Place
    size: number
  view
    box width=size height=size border-radius=(size * 0.28) flex-shrink=0 position="relative" background-color=(place.link == "" ? "transparent" : appTint(place.app)) border=(place.link == "" ? "1px solid -exact-separator" : "none")
      image appSymbol(place.app) position="absolute" inset=0 margin="auto" width=(size * 0.48) height=(size * 0.48) object-fit="contain" color=(place.link == "" ? "-exact-secondary-label" : "ink.on-tile") aria-hidden=true

// One of a few things to pick from, with a line under it (a persona, a voice).
shape Option
  id: string
  label: string
  detail: string

// hex's faces. Opal has palettes of its own; Mana keeps its own colour; the rest take the colour picked.
fn personas(): Option[] = [Option(id="obsidian", label="Obsidian", detail="Shifting silver"), Option(id="mana", label="Mana", detail="Soft blue light"), Option(id="opal", label="Opal", detail="Flowing color"), Option(id="halo", label="Halo", detail="A ring of light"), Option(id="glint", label="Glint", detail="A pair of stars"), Option(id="command", label="Command", detail="A simple slash")]
fn paletteColor(id: string): string = id == "2" ? "#E5484D" : id == "3" ? "#F07B3F" : id == "4" ? "#E8C547" : id == "5" ? "#46B96C" : id == "6" ? "#2FB5AD" : id == "7" ? "#4562DA" : id == "8" ? "#9B4DD6" : id == "9" ? "#DE4FA6" : ""

// hex's own pages, switched at the foot of its column as Muse's are: Now, Feed, Ideas, Goals, each
// an icon over its name in one glass capsule, the current one on a pill of its own, Feed with a
// dot when something is new. What sits beside it (Call) comes in as its children, in the same
// glass group so the two read as one bar. Room places it and says which is current.
shape HexTab
  id: string
  label: string
  icon: string

fn hexTabs(): HexTab[] = [HexTab(id="now", label="Now", icon="symbol:icon.now"), HexTab(id="feed", label="Feed", icon="symbol:icon.feed"), HexTab(id="ideas", label="Ideas", icon="symbol:icon.ideas"), HexTab(id="goals", label="Goals", icon="symbol:icon.goals")]

style TabTap
  appearance="none" display="flex" flex-direction="column" align-items="center" justify-content="center" gap=2 width=54 height=48 border-radius=24 position="relative"
  :active
    -exact-press-scale=0.92

// Not a tablist: iOS draws a tablist of symbol-over-label tabs as a native tab bar, 91pt tall in
// its own glass oval around this pill.
component HexTabs
  inject
    haptics: bool
    still: bool
  props
    // The pages that are built, so a tab never leads to an empty list.
    pages: string[]
    current: string
    fresh: bool
    pick: action
  slot
  view
    row gap=12 align-items="center" justify-content="center" testId="hex-tabs"
      row backgroundMaterial="glass" border-radius=28 height=56 padding=4 box-sizing="border-box" gap=0 align-items="center" aria-label="hex's pages" flex-shrink=0
        for t in hexTabs().filter(t => pages.filter(p => p == t.id).length > 0) key=t.id
          button press=pick(t.id) class=TabTap background-color=(current == t.id ? "-exact-tertiary-fill" : "transparent") transition=springOf(still, "background-color") aria-current=(current == t.id) aria-label=(t.id == "feed" and fresh ? "Feed, new" : t.label) -exact-press-haptic=(haptics ? "selection" : "none") testId=`hex-tab-${t.id}`
            image t.icon width=22 height=22 object-fit="contain" color=(current == t.id ? "-exact-label" : "-exact-secondary-label") aria-hidden=true
            // In points: a bare 12 is twelve times the font, a 120pt line that pushed the icon out of the capsule.
            text t.label font-size=10 line-height="12px" font-weight=(current == t.id ? 600 : 500) color=(current == t.id ? "-exact-label" : "-exact-secondary-label") white-space="nowrap"
            if t.id == "feed" and fresh
              box position="absolute" top=6 right=9 width=7 height=7 border-radius=4 background-color="-exact-label" aria-hidden=true
      children

// Under which day something happened, as Feed sorts it: This morning, This afternoon, This
// evening, Yesterday, then the weekday this week, then the date.
fn dayWordOf(at: number, now: number, offset: number): string = dayOf(at, offset) == dayOf(now, offset) ? (((at + offset * 60000) % 86400000) < 43200000 ? "This morning" : ((at + offset * 60000) % 86400000) < 64800000 ? "This afternoon" : "This evening") : dayOf(at, offset) == dayOf(now, offset) - 1 ? "Yesterday" : whenOf(at, now, offset)

// The small grey head over a list on Feed, Ideas and Goals (a day, "hex found something",
// "Watching"), with how many on the right where that's worth saying (n < 0: none).
component Head
  props
    label: string
    n: number
    pad: string
    id: string
  view
    row gap=12 align-items="baseline" padding=pad role="heading" aria-level=2 aria-label=(n < 0 ? label : `${label}, ${n}`) testId=id
      text label font="-exact-subheadline" font-weight=600 color="-exact-secondary-label" flex=1
      if n >= 0
        text `${n}` font="-exact-subheadline" font-variant-numeric="tabular-nums" color="-exact-secondary-label"

// The thin line between what came since Bassim last looked and what he's seen.
component Earlier
  props
    pad: string
  view
    row gap=12 align-items="center" padding=pad role="separator" aria-label="Earlier" testId="earlier"
      box flex=1 height=0 border-top="0.5px solid -exact-separator"
      text "Earlier" font="-exact-footnote" color="-exact-tertiary-label"
      box flex=1 height=0 border-top="0.5px solid -exact-separator"

// One story (a Feed entry, an idea): its mark, the news in bold (two lines at most), then said in
// full in reading text, or in grey quotes when they're Bassim's own words. Its pictures come in as
// children. Under it the topic and time in grey, and on the right what it offers: "Discuss" (a
// call that opens on it), "Undo" (what hex decided), or nothing. A tap anywhere else opens it.
component Story
  inject
    haptics: bool
  props
    mark: string
    title: string
    body: string
    quoted: bool
    meta: string
    // discuss | undo | ""
    offer: string
    selected: bool
    id: string
    open: action
    act: action
  slot
  view
    column gap=0 border-radius=14 background-color=(selected ? "-exact-tertiary-fill" : "transparent") testId=id
      // The whole entry opens it, its pictures and its topic and time too; only Discuss or Undo
      // are targets of their own, so no part of an entry is dead under a thumb.
      button press=open class=RowTap padding="10px 10px 0" aria-current=selected -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`${title}. ${body}` testId=`${id}-open`
        box padding-top=1 flex-shrink=0
          Mark(state=mark, size=22)
        column flex=1 min-width=0 gap=4
          text title font="-exact-headline" color="-exact-label" line-clamp=2 overflow-wrap="anywhere"
          if body != ""
            text (quoted ? `“${body}”` : body) font="-exact-body" color=(quoted ? "-exact-secondary-label" : "-exact-label") overflow-wrap="anywhere"
          column gap=8 testId=`${id}-slot`
            children
      // Up under the words: its line keeps a thumb's height, but its text sits right below them.
      row gap=12 align-items="center" padding="0 10px 0 0" margin-top=-9
        button press=open class=Tap flex=1 min-width=0 min-height=44 display="flex" align-items="center" padding="0 0 4px 44px" text-align="left" aria-hidden=true testId=`${id}-meta`
          text meta font="-exact-footnote" color="-exact-secondary-label" flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        if offer == "discuss"
          Discuss(title=title, id=`${id}-discuss`, press=act)
        else if offer == "undo"
          button press=act class=PillTap -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`Undo, put ${title} back on your list` testId=`${id}-undo`
            box class=PillFace
              text "Undo" font="-exact-subheadline" font-weight=600

// "Discuss": a call that opens on this. A pill of its own, a thumb's target apart from the row.
component Discuss
  inject
    haptics: bool
  props
    title: string
    id: string
    press: action
  view
    button press=press class=PillTap -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`Discuss ${title} with hex` testId=id
      box class=PillFace padding="0 14px" height=28 box-sizing="border-box" gap=6
        image "symbol:waveform" width=15 height=15 object-fit="contain" color="-exact-label" aria-hidden=true
        text "Discuss" font="-exact-subheadline" font-weight=600 color="-exact-label"

// A project's goals as one bar, a segment each, coloured by where each stands (reached full
// strength, working blue, waiting on Bassim amber, not started grey), then "1 of 4" reached. Every
// project's bar is the same width, split evenly among its goals, so bars line up down the list.
fn segmentInk(state: string): string = state == "done" ? "-exact-label" : state == "working" or state == "running" ? "hex.progress" : state == "needs" or state == "asks" ? "hex.ask" : state == "failed" ? "hex.danger" : "-exact-tertiary-fill"

// Past eight goals a segment each turns to mush, so the bar shows shares without gaps: one run per
// state, as wide as its share. Goals passes the states sorted, so each run is one kind.
fn shareKinds(): string[] = ["done", "working", "running", "needs", "asks", "failed", "unstarted"]
fn shareOf(states: string[], kind: string): number = kind == "unstarted" ? states.filter(s => not ["done", "working", "running", "needs", "asks", "failed"].includes(s)).length : states.filter(s => s == kind).length

// Only reached goals are full strength; the rest are their colour faint, so one working goal
// doesn't read as a full bar. The count keeps one width, so bars end in a line.
component GoalsBar
  props
    states: string[]
  derive reached = states.filter(s => s == "done").length
  view
    row gap=8 align-items="center" flex-shrink=0 aria-label=`${reached} of ${states.length} reached`
      if states.length > 8
        row width="4.25rem" height=5 border-radius=3 overflow="hidden" aria-hidden=true
          for k in shareKinds() key=k
            if shareOf(states, k) > 0
              box flex=shareOf(states, k) height=5 background-color=segmentInk(k) opacity=(k == "done" or k == "unstarted" ? 1 : 0.45)
      else
        row gap=3 width="4.25rem" aria-hidden=true
          for s, i in states key=i
            box flex=1 min-width=2 height=5 border-radius=3 background-color=segmentInk(s) opacity=(s == "done" or segmentInk(s) == "-exact-tertiary-fill" ? 1 : 0.45)
      text `${reached} of ${states.length}` font="-exact-subheadline" font-variant-numeric="tabular-nums" color="-exact-secondary-label" white-space="nowrap" min-width="4rem" text-align="right"

// A project over its goals: a chevron that turns as it opens in place, its name, and its bar.
component GoalProject
  inject
    haptics: bool
    still: bool
  props
    name: string
    states: string[]
    open: bool
    id: string
    toggle: action
  view
    button press=toggle class=RowTap align-items="center" aria-expanded=open aria-label=`${name}, ${open ? "open" : "shut"}` -exact-press-haptic=(haptics ? "selection" : "none") testId=id
      box width=22 display="flex" justify-content="center" flex-shrink=0 aria-hidden=true
        image "symbol:icon.open" width=14 height=14 object-fit="contain" color="-exact-secondary-label" rotate=(open ? "0deg" : "-90deg") transition=springOf(still, "rotate")
      text name font="-exact-headline" color="-exact-label" flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
      GoalsBar(states=states)
