// One of hex's picks (§9.6), flat as every question: the question, what it's about, why hex picks
// what it does, every answer as the same row with what it means, and where the question came from.
// Choosing one sets it on hex's picks; nothing is sent until Bassim answers them all there.
use Viewport, Asks, Words from "./shapes.contract"
use Room, Chrome from "./room.contract"
use PickBody from "./picks.contract"

component Pick
  props
    entry: Entry
    viewport: Viewport
    room: Room
    needsYou: number
    working: number
    now: number
    offset: number
    asks: Asks
    picked: string[]
    words: Words
    wordsAsk: string
    showWords: action
    pick: action
    open: action
    openTasks: action
    back: action
  derive found = asks.asks.filter(a => a.id == entry.params.id)
  derive two = room.columns == 2
  // Open like a book it keeps to the left of the fold.
  derive inner = two ? "0 20px" : `0 ${max(room.width - room.clear.x - room.clear.width, 0) + 20}px 0 ${room.clear.x + 20}px`
  action choose(label: string)
    pick(entry.params.id, label)
    back()
  view
    column navigationKey=`${entry.id}` navigationBar="none" -exact-safe-area="none" position="absolute" inset=0 background-color="-exact-background" testId="pick"
      Chrome(room=room, on="pick", needsYou=needsYou, working=working, open=open, openTasks=openTasks, back=back)
      scroll id="pick" position="absolute" top=room.below bottom=0 left=(two ? room.first.x : 0) width=(two ? room.first.width : room.width) padding-bottom=(room.foot + 24) box-sizing="border-box" mask-image="linear-gradient(to bottom, transparent 0, #000 12px, #000 100%)"
        column padding=inner gap=10
          if found.length == 0
            text "This question is answered" font="-exact-body" color="-exact-secondary-label" padding="24px 0" testId="pick-answered"
          for a in found key=a.id
            PickBody(ask=a, width=((two ? room.first.width : room.clear.width) - 40), now=now, offset=offset, picked=picked, words=words, wordsAsk=wordsAsk, choose=choose)
