// One of hex's picks (§9.6), flat as every question: the question, what it's about, why hex picks
// what it does, every answer as the same row with what it means, and where the question came from.
// Choosing one sets it on hex's picks; nothing is sent until Bassim answers them all there.
use Viewport, Asks, Words, Media from "./shapes.contract"
use whenOf from "./parts.contract"
use Pictures from "./media.contract"
use pickOf, choiceOf from "./picks.contract"
use AnswerRow from "./ask.contract"

component Pick
  props
    entry: Entry
    viewport: Viewport
    now: number
    offset: number
    asks: Asks
    picked: string[]
    words: Words
    wordsAsk: string
    showWords: action
    pick: action
    open: action
    back: action
  derive found = asks.asks.filter(a => a.id == entry.params.id)
  action choose(label: string)
    pick(entry.params.id, label)
    back()
  view
    column navigationKey=`${entry.id}` navigationScroll="pick" position="absolute" inset=0 testId="pick"
      header display="flex" align-items="center"
        text "Question" role="heading" aria-level=2
      list id="pick" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
        if found.length == 0
          section
            text "This question is answered" color="-exact-secondary-label" testId="pick-answered"
        for a in found key=a.id
          section background-color="transparent"
            column gap=8 padding="6px 0 4px"
              text a.question font="-exact-title3" font-weight=600
              if a.context != ""
                text a.context font="-exact-body" color="-exact-label" user-select="text"
              if a.why != ""
                column gap=2
                  text `✦ Why hex picks ${pickOf(a)}` font="-exact-subheadline" font-weight=600 color="hex.accent"
                  text a.why font="-exact-subheadline" color="-exact-secondary-label" user-select="text"
              // Its answers' screenshots, else hex's pictures, at their own shapes.
              if a.options.filter(o => o.shot >= 0).length > 0 or a.pictures.length > 0
                Pictures(media=(a.options.filter(o => o.shot >= 0).length > 0 ? a.options.filter(o => o.shot >= 0).map(o => Media(id=`/asks/${encodeURIComponent(a.id)}/shots/${o.shot}`, kind="photo", aspect=o.aspect)) : a.pictures.map(p => Media(id=p.id, kind="photo", aspect=p.aspect))), width=(min(viewport.width, 700) - 72), height=300)
              column border-top="0.5px solid -exact-separator" margin-top=4 role="radiogroup" aria-label="Your answer"
                for o in a.options key=o.label
                  AnswerRow(label=o.label, detail=o.detail, pick=o.pick, chosen=(choiceOf(picked, a) == o.label), role="radio", disabled=false, id=`pick-option-${o.label}`, press=choose(o.label))
                AnswerRow(label="Decide later", detail="Stays in Needs you, unanswered.", pick=false, chosen=(choiceOf(picked, a) == ""), role="radio", disabled=false, id="pick-later", press=choose(""))
              text "Sent when you tap Answer on hex’s picks" font="-exact-footnote" color="-exact-secondary-label"
          section background-color="transparent"
            header
              text "From the thread"
            text (wordsAsk == a.id and words.place != "" ? `${words.place} · ${whenOf(words.at, now, offset)}` : `${a.topic} · ${whenOf(a.at, now, offset)}`) font="-exact-footnote" color="-exact-secondary-label"
            if wordsAsk == a.id and words.text != ""
              text words.text markup="markdown" font="-exact-subheadline" user-select="text"
            for l in a.links key=l.url
              link href=l.url
                text l.label flex=1
                image "symbol:sf/arrow.up.right" width=11 height=11 object-fit="contain" color="-exact-tertiary-label"
            for p in a.places.filter(p => p.link != "").slice(0, 2) key=p.link
              link href=p.link
                text `Open ${p.place}` flex=1
                image "symbol:sf/arrow.up.right" width=11 height=11 object-fit="contain" color="-exact-tertiary-label"
