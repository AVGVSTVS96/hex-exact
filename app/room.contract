// Room: where the app sits in its window, worked out once at the root from the window's size and
// what covers it (the status icons and cameras, the hinge, the home indicator). Every screen takes
// `room`; none reads the fold or a width itself.
//
// The Duo gives its status icons either a column down one side (folded upright, open like a book)
// or a band along the top (on its side), and the icons in it come as occlusions. Where the shell
// draws the bars (shell/Shell/Frame.swift: hex's pages as the system's tabs, Calls, Tasks,
// Settings and Back as its bar buttons), iOS puts them in that column folded and along the top and
// foot open, and reports what they take as safe area, so the page stops at them and there's no
// chrome row of the app's own. Without them (a binary from before) the app draws its chrome row
// beside the icons, never under them: inside the band when the band has room clear of the icons,
// else just under it, its trailing end at the column's edge.
use Viewport, Pose, Rect from "./shapes.contract"
use Tap from "./parts.contract"

shape Span
  x: number
  width: number

// The chrome row: Back, then Calls, Tasks and Settings in one capsule ending at `end`; `start` is
// where its free space begins on the leading side, `top` the row's top.
shape Bar
  top: number
  start: number
  end: number

// hex's tabs (Now, Feed, Ideas, Goals) and Call: one row at the foot of hex's column (`x`, `width`),
// the pair centred in it; `top` is the row's top. How they look is System's (parts.contract HexTabs).
shape Foot
  x: number
  width: number
  top: number

shape Room
  width: number
  height: number
  // The rectangle nothing covers.
  clear: Rect
  // One column, or two side by side: `first` is hex's (or a list's), `second` the page it opens.
  // With one, `second` is empty.
  columns: number
  first: Span
  second: Span
  bar: Bar
  // Where a column's content starts: hex's under the chrome row, the second's under the status
  // icons too when they're above it.
  below: number
  secondBelow: number
  // Where hex's column may start while nothing of the chrome row sits over it (no update notice,
  // and two columns with the capsule over the second, or one column wider than tall with the
  // capsule at its end): at the row's own top.
  firstTop: number
  // Where a page beside hex's column may start, its heading on the chrome row left of the capsule
  // as drawn (two columns, the capsule over the second; else secondBelow), and where that heading
  // ends; what follows the heading starts at secondBelow.
  secondTop: number
  secondHeadEnd: number
  // How far fixed controls at the foot stand off the window's bottom edge.
  foot: number
  // Where hex's tabs and Call sit; a list in hex's column ends above `tabs.top`.
  tabs: Foot
  // Where a row heading hex's column right under the chrome ends, clear of the status icons beside
  // it, and how far down those icons reach.
  headEnd: number
  headBottom: number
  // Where a control docked at the foot ends, clear of a camera in the window's bottom corner (the
  // Duo folded on its side has one there).
  footEnd: number
  // The shell draws the bars, so the app draws no chrome row or tabs of its own.
  native: bool
  // What covers the window's top (the status icons, the cameras): pages scroll under them, so
  // the app lays the page's background over them.
  covers: Rect[]
  // Where a hinge across the window starts (open like a laptop), so nothing fixed sits on it; the
  // window's height when there's none.
  across: number

// A chrome row is 44 tall; the capsule of three is 140 wide.
fn barHeight(): number = 44
fn capsuleWidth(): number = 140
// The row of tabs and Call is as tall as Call.
fn callSize(): number = 64

fn clearOf(v: Viewport): Rect = Rect(x=v.safeAreaLeft, y=v.safeAreaTop, width=v.width - v.safeAreaLeft - v.safeAreaRight, height=v.height - v.safeAreaTop - v.safeAreaBottom)
// The status icons and cameras near the top of the window. iOS needn't count them in the safe area
// (the Duo's cover screen reports none on its right, its icons and camera standing in a column
// there), so the pose's occlusions place the row; one taller than half the window is a side
// column the safe area already keeps.
fn topCovers(v: Viewport, p: Pose): Rect[] = p.occlusions.filter(o => o.y < v.height / 3 and o.height < v.height / 2)
fn barTop(v: Viewport): number = v.safeAreaTop + 8
// Those beside the row: it stops 10 short of the nearest on each side.
fn rowCovers(v: Viewport, p: Pose): Rect[] = topCovers(v, p).filter(o => o.y < barTop(v) + barHeight() and o.y + o.height > barTop(v))
fn barEnd(v: Viewport, p: Pose): number = min(v.width - v.safeAreaRight - (v.safeAreaRight > 0 ? 8 : 16), match sortBy(rowCovers(v, p).filter(o => o.x + o.width / 2 > v.width / 2), o => o.x).at(0) { case some(o) => o.x - 10, case none => v.width })
fn barStart(v: Viewport, p: Pose): number = max(v.safeAreaLeft + 16, match sortBy(rowCovers(v, p).filter(o => o.x + o.width / 2 <= v.width / 2), o => o.x + o.width, "desc").at(0) { case some(o) => o.x + o.width + 10, case none => 0 })
fn barOf(v: Viewport, p: Pose): Bar = Bar(top=barTop(v), start=barStart(v, p), end=barEnd(v, p))
// Under the row; and for a column that has the icons above it, under them too, as a page's own
// header has buttons at its trailing end.
fn belowOf(v: Viewport, p: Pose): number = p.bars ? max(v.safeAreaTop, 16) + 8 : barTop(v) + barHeight() + 10
fn belowAt(v: Viewport, p: Pose, column: Span): number = max(belowOf(v, p), match sortBy(topCovers(v, p).filter(o => o.x < column.x + column.width and o.x + o.width > column.x), o => o.y + o.height, "desc").at(0) { case some(o) => o.y + o.height + 8, case none => 0 })

// Two columns only when both read well: each at least 300 wide. They part at the hinge when the
// window has one down its middle, else at the middle of the window, where a book's fold lies.
fn acrossOf(v: Viewport, p: Pose): number = v.verticalViewportSegments == 2 ? match v.segments.at(0) { case some(s) => s.y + s.height, case none => v.height } : p.fold.width >= v.width / 2 and p.fold.height < v.height / 4 ? p.fold.y : v.height
fn twoOf(v: Viewport): bool = clearOf(v).width >= 600
fn foldOf(v: Viewport, p: Pose): Span = v.horizontalViewportSegments == 2 ? match v.segments.at(0) { case some(s) => Span(x=s.x + s.width, width=match v.segments.at(1) { case some(t) => max(t.x - s.x - s.width, 0), case none => 0 }), case none => Span(x=v.width / 2, width=0) } : p.fold.height >= v.height / 2 and p.fold.width < v.width / 4 ? Span(x=p.fold.x, width=p.fold.width) : Span(x=v.width / 2, width=0)
fn firstOf(v: Viewport, p: Pose): Span = twoOf(v) ? Span(x=clearOf(v).x, width=foldOf(v, p).x - clearOf(v).x) : Span(x=clearOf(v).x, width=clearOf(v).width)
fn secondOf(v: Viewport, p: Pose): Span = twoOf(v) ? Span(x=foldOf(v, p).x + foldOf(v, p).width, width=clearOf(v).x + clearOf(v).width - foldOf(v, p).x - foldOf(v, p).width) : Span(x=v.width, width=0)

// The status icons beside the band under the chrome row, in hex's column.
// One column wider than tall: hex's column starts on the chrome row, left of the capsule.
fn sideOf(v: Viewport): bool = not twoOf(v) and v.width > v.height
fn headCovers(v: Viewport, p: Pose): Rect[] = topCovers(v, p).filter(o => o.y < belowOf(v, p) + 80 and o.y + o.height > belowOf(v, p) and o.x + o.width / 2 > v.width / 2 and o.x < firstOf(v, p).x + firstOf(v, p).width)
fn headEndOf(v: Viewport, p: Pose): number = min(match sortBy(headCovers(v, p), o => o.x).at(0) { case some(o) => o.x - 10, case none => firstOf(v, p).x + firstOf(v, p).width }, sideOf(v) and not p.bars ? barEnd(v, p) - capsuleWidth() - 10 : v.width)
fn headBottomOf(v: Viewport, p: Pose): number = match sortBy(headCovers(v, p), o => o.y + o.height, "desc").at(0) { case some(o) => o.y + o.height, case none => 0 }
// What covers the window's foot on its trailing half: a docked control there ends 10 short of it.
fn footCovers(v: Viewport, p: Pose): Rect[] = p.occlusions.filter(o => o.y + o.height > v.height - max(v.safeAreaBottom, 12) - 8 - callSize() and o.y > v.height / 2 and o.x + o.width / 2 > v.width / 2)
fn footEndOf(v: Viewport, p: Pose): number = min(clearOf(v).x + clearOf(v).width, match sortBy(footCovers(v, p), o => o.x).at(0) { case some(o) => o.x - 10, case none => v.width })

// With two columns and the capsule over the second, a page beside hex's column heads on the
// chrome row, left of the capsule.
fn besideHigh(v: Viewport, p: Pose): bool = not p.bars and twoOf(v) and barEnd(v, p) - capsuleWidth() >= secondOf(v, p).x + 120
// The viewport as the room sees it: with the shell's bars, its safe area is UIKit's, which takes in
// the bars' column; Exact's viewport reports the window's, without it.
fn framedOf(v: Viewport, p: Pose): Viewport = p.bars ? Viewport(width=v.width, height=v.height, devicePosture=v.devicePosture, horizontalViewportSegments=v.horizontalViewportSegments, verticalViewportSegments=v.verticalViewportSegments, segments=v.segments, safeAreaTop=max(v.safeAreaTop, p.inset.top), safeAreaBottom=max(v.safeAreaBottom, p.inset.bottom), safeAreaLeft=max(v.safeAreaLeft, p.inset.left), safeAreaRight=max(v.safeAreaRight, p.inset.right), keyboardHeight=v.keyboardHeight, prefersReducedMotion=v.prefersReducedMotion) : v
fn roomOf(v: Viewport, p: Pose): Room = roomIn(framedOf(v, p), p)
fn belowIn(v: Viewport, p: Pose, column: Span): number = belowAt(framedOf(v, p), p, column)
fn roomIn(v: Viewport, p: Pose): Room = Room(width=v.width, height=v.height, clear=clearOf(v), columns=(twoOf(v) ? 2 : 1), first=firstOf(v, p), second=secondOf(v, p), bar=barOf(v, p), below=belowOf(v, p), secondBelow=belowAt(v, p, secondOf(v, p)), foot=max(v.safeAreaBottom, 12), tabs=Foot(x=firstOf(v, p).x, width=firstOf(v, p).width, top=v.height - max(v.safeAreaBottom, 12) - 8 - callSize()), firstTop=(p.bars ? belowOf(v, p) : ((twoOf(v) and barEnd(v, p) - capsuleWidth() >= firstOf(v, p).x + firstOf(v, p).width) or sideOf(v) ? barTop(v) : belowOf(v, p))), secondTop=(besideHigh(v, p) ? barTop(v) : belowAt(v, p, secondOf(v, p))), secondHeadEnd=(besideHigh(v, p) ? barEnd(v, p) - capsuleWidth() - 12 : clearOf(v).x + clearOf(v).width), headEnd=headEndOf(v, p), headBottom=headBottomOf(v, p), footEnd=footEndOf(v, p), native=p.bars, covers=topCovers(v, p), across=acrossOf(v, p))

// Where the capsule starts, and so where Back and the free space on its leading side end.
fn capsuleX(room: Room): number = room.bar.end - capsuleWidth()

// The chrome: Calls, Tasks (a dot when something needs Bassim) and Settings in one capsule at the
// row's trailing end, beside the status icons; on a page over Home, Back to its left. It keeps one
// place on every page.
component Chrome
  inject
    haptics: bool
  props
    room: Room
    // The page that's open: "" on Home, else calls | tasks | settings | another page's name.
    on: string
    needsYou: number
    working: number
    open: action
    openTasks: action
    back: action
  view
    row position="absolute" top=room.bar.top left=(capsuleX(room) - (on == "" ? 0 : 54)) height=barHeight() gap=10 align-items="center" display=(room.native ? "none" : "flex") z-index=4 testId="chrome"
      if on != ""
        button press=back class=Tap width=44 height=44 border-radius=22 backgroundMaterial="glass" display="flex" align-items="center" justify-content="center" aria-label="Back" -exact-press-haptic=(haptics ? "selection" : "none") testId="chrome-back"
          image "symbol:sf/chevron.left" width=18 height=18 object-fit="contain" color="-exact-label"
      row backgroundMaterial="glass" border-radius=22 width=capsuleWidth() height=barHeight() align-items="center" justify-content="space-around" padding="0 4px" box-sizing="border-box" position="relative" testId="toolbar"
        button press=open(path("calls")) class=Tap width=44 height=44 border-radius=22 background-color=(on == "calls" ? "-exact-tertiary-fill" : "transparent") display="flex" align-items="center" justify-content="center" aria-label="Calls" aria-current=(on == "calls") -exact-press-haptic=(haptics ? "selection" : "none") testId="open-calls"
          image "symbol:sf/clock.arrow.circlepath" width=20 height=20 object-fit="contain" color="-exact-label"
        button press=openTasks("") class=Tap width=44 height=44 border-radius=22 background-color=(on == "tasks" ? "-exact-tertiary-fill" : "transparent") display="flex" align-items="center" justify-content="center" aria-label=`Tasks, ${needsYou} need you, ${working} working` aria-current=(on == "tasks") -exact-press-haptic=(haptics ? "selection" : "none") testId="open-tasks"
          image "symbol:list" width=20 height=20 object-fit="contain" color="-exact-label"
        button press=open(path("settings")) class=Tap width=44 height=44 border-radius=22 background-color=(on == "settings" ? "-exact-tertiary-fill" : "transparent") display="flex" align-items="center" justify-content="center" aria-label="Voice and appearance settings" aria-current=(on == "settings") -exact-press-haptic=(haptics ? "selection" : "none") testId="open-settings"
          image "symbol:adjust" width=20 height=20 object-fit="contain" color="-exact-label"
        if needsYou > 0 and on != "tasks"
          box position="absolute" top=8 left=78 width=10 height=10 border-radius=5 background-color="hex.ask" aria-hidden=true testId="needs-dot"

