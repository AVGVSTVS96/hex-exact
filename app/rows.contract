// The rows of Tasks (§9.1): a topic's row in the list, and each entry's row in search and on a
// topic's page. Every row swipes as the stable app's do: from the left to do the obvious thing (take
// hex's pick, act, mark read), from the right to say "Not needed" or open where it lives.
use Ask, Place, TaskRow, Track from "./shapes.contract"
use Mark, Chip, PlaceTile, Row, PillTap, RowTap, whenOf, appName, appTint, appSymbol, PillFace, plainOf from "./parts.contract"
use Item, Topic, problemOf, pageOf from "./inbox.contract"
use Said, unreached, failedWords from "./said.contract"

fn askOf(asks: Ask[], id: string): option<Ask> = asks.filter(a => a.id == id).at(0)
fn pickOf(a: Ask): string = match a.options.filter(o => o.pick).at(0) { case some(o) => o.label, case none => "" }
// Answers short enough to take right from the row.
fn inline(a: Ask): bool = a.options.length > 0 and a.options.length <= 3 and not a.multiple and a.options.filter(o => o.label.length > 16).length == 0
fn tileLabel(p: Place): string = p.place != "" ? p.place : appName(p.app)
// The tile's link to open: its own, or a call's page in the app.
fn tileHref(p: Place): string = p.call != "" ? `/calls/${encodeURIComponent(p.call)}` : p.link

fn newestOf(t: Topic): Item = match sortBy(t.entries, e => e.at, "desc").at(0) { case some(e) => e, case none => Item(kind="", id="", topic="", app="", stage="", rank=0, at=0, page="", mark="", title="", line="", meta="", action="", sent=false, words="", tiles=[]) }
// A topic's mark, from its newest entry: a question, a thread that waits on Bassim, a failure, work
// going on, done, or quiet.
fn topicMark(t: Topic): string = newestOf(t).stage == "needs" ? (newestOf(t).kind == "task" or newestOf(t).kind == "fresh" ? "asks" : newestOf(t).mark) : problemOf(newestOf(t).title) != "" ? "failed" : newestOf(t).stage == "working" ? "working" : newestOf(t).stage == "done" ? "done" : "pending"
// Its last day, hour by hour, oldest first: amber where it waited on Bassim, blue where hex worked in it.
fn hourInk(track: Track[], now: number, h: number): string = track.filter(x => floor((now - x.at) / 3600000) == 23 - h and x.state == "needs").length > 0 ? "hex.ask" : track.filter(x => floor((now - x.at) / 3600000) == 23 - h and x.state == "working").length > 0 ? "hex.progress" : ""
fn dayTrack(track: Track[], now: number): string[] = range(24).map(h => hourInk(track, now, h))

// A topic in the list: its mark, name, the questions in it and the agents on it, when, its newest
// headline on one line, and while hex works in it, its last day hour by hour.
component ProjectRow
  inject
    haptics: bool
  props
    topic: Topic
    threads: TaskRow[]
    now: number
    offset: number
    selected: bool
    select: action
  derive newest = newestOf(topic)
  derive problem = problemOf(newest.title)
  derive headline = problem != "" ? problem : newest.title
  derive mark = topicMark(topic)
  derive own = threads.filter(t => t.name == topic.name)
  derive questions = topic.entries.filter(e => e.kind == "ask").length
  derive working = newest.stage == "working"
  derive agents = working ? sum(own.map(t => t.agents.filter(a => a.state == "working").length)) : 0
  derive hours = working ? dayTrack(own.map(t => t.track).flat(), now) : [""].slice(0, 0)
  view
    button press=select class=RowTap gap=10 border-radius=14 background-color=(selected ? "-exact-quaternary-fill" : "transparent") aria-current=selected -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`${topic.name}${questions > 0 ? `, ${questions} ${questions == 1 ? "question" : "questions"}` : ""}${agents > 0 ? `, ${agents} ${agents == 1 ? "agent" : "agents"}` : ""}: ${headline}` testId=`topic-${topic.name}`
      box padding-top=1 flex-shrink=0
        Mark(state=mark, size=22)
      column flex=1 min-width=0 gap=2
        row gap=8 align-items="baseline"
          text topic.name font="-exact-headline" color="-exact-label" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" flex-shrink=1 min-width=0
          if questions > 0 and (mark != "asks" or questions > 1)
            row gap=2 align-self="center" align-items="center" height=18 padding="0 6px 0 5px" border-radius=9 background-color="hex.ask.wash" flex-shrink=0 aria-hidden=true
              image "symbol:icon.ask" width=9 height=9 object-fit="contain" color="hex.ask"
              text `${questions}` font-size=12 line-height="16px" font-weight=600 font-variant-numeric="tabular-nums" color="hex.ask"
          if agents > 0
            text `${agents} ${agents == 1 ? "agent" : "agents"}` font="-exact-footnote" color="hex.progress" white-space="nowrap" flex-shrink=0 aria-hidden=true
          box flex=1
          text whenOf(newest.at, now, offset) font="-exact-footnote" font-variant-numeric="tabular-nums" color="-exact-tertiary-label" white-space="nowrap"
        if headline != ""
          text headline font="-exact-subheadline" color=(problem != "" ? "hex.danger" : mark == "asks" ? "-exact-label" : "-exact-secondary-label") white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        if hours.length > 0
          row gap=1 height=6 margin-top=5 border-radius=2 overflow="hidden" align-self="flex-start" aria-hidden=true
            for c, i in hours key=i
              box width=2 height=6 background-color=(c == "" ? "-exact-tertiary-fill" : c)

// A topic's head over its rows in search: tap to open the topic.
component TopicHead
  props
    topic: Topic
    select: action
  view
    link href="" press=select display="flex" flex-direction="row" align-items="center" gap=8 padding="12px 10px 4px" testId=`head-${topic.name}`
      text topic.name font="-exact-footnote" font-weight=600 color="-exact-secondary-label" flex=1 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
      Chip(n=topic.entries.length, state="", loading=false)

// One entry: an ask, a thread, a stuck run, a fresh result or a finished thing.
component EntryRow
  inject
    haptics: bool
  props
    entry: Item
    asks: Ask[]
    said: Said[]
    why: string
    now: number
    offset: number
    answer: action
    dismiss: action
    undo: action
    again: action
    act: action
    markRead: action
    openPage: action
  derive ask = askOf(asks, entry.id)
  derive word = match said.filter(s => s.id == entry.id).at(-1) { case some(s) => s, case none => Said(id="", verb="", label="", status="", detail="", missed=0, question="", topic="", task="") }
  derive folded = entry.kind == "ask" and word.id != "" and word.verb != "note" and word.status != "failed"
  derive pick = match ask { case some(a) => pickOf(a), case none => "" }
  derive opens = entry.tiles.filter(t => t.link != "" or t.call != "")
  derive lead = entry.kind == "ask" ? pick : entry.kind == "stuck" and not entry.sent ? entry.action : entry.kind == "fresh" and not entry.sent ? "Read" : ""
  action leading
    if entry.kind == "ask"
      answer(entry.id, pick)
    else if entry.kind == "stuck"
      act(entry.id)
    else
      markRead(entry.id)
  view
    if folded
      Folded(said=word, question=entry.title, topic=entry.topic, pad="10px 16px", undo=undo, again=again)
    else
      scroll swipeContent=`${entry.id}-row` swipeLeading=(lead != "" ? `${entry.id}-lead` : "") swipeTrailing=`${entry.kind == "ask" ? `${entry.id}-away ` : ""}${range(opens.length).map(i => `${entry.id}-tile-${i}`).join(" ")}` display="flex" overflow-x="scroll" overflow-y="hidden" scrollbar-width="none" scroll-snap-type="x mandatory" padding-right=0 testId=`entry-${entry.id}`
        if lead != ""
          button id=`${entry.id}-lead` press=leading accent-color="hex.accent.solid" flex-shrink=0 scroll-snap-align="start" -exact-press-haptic=(haptics ? "selection" : "none") testId=`lead-${entry.id}`
            image "symbol:checkmark"
            text lead
        row id=`${entry.id}-row` width="100%" flex-shrink=0 scroll-snap-align="start" box-sizing="border-box" gap=10 align-items="flex-start" padding="8px 16px" press=openPage(entry.page != "" ? entry.page : `topic:${entry.topic}`)
          Mark(state=entry.mark, size=22)
          column flex=1 min-width=0 gap=3
            row gap=10 align-items="baseline"
              text plainOf(entry.title) font="-exact-callout" color="-exact-label" line-clamp=2 flex=1 min-width=0
              row gap=5 align-items="center" flex-shrink=0
                if entry.meta != ""
                  text match entry.meta.split(" ").at(0) { case some(n) => n, case none => "" } font="-exact-footnote" font-weight=600 font-variant-numeric="tabular-nums" color="hex.progress" aria-label=entry.meta
                text whenOf(entry.at, now, offset) font="-exact-footnote" color="-exact-tertiary-label" white-space="nowrap" font-variant-numeric="tabular-nums"
                match entry.tiles.at(0)
                  case some(t)
                    image appSymbol(t.app) width=11 height=11 object-fit="contain" color="-exact-tertiary-label" aria-label=tileLabel(t)
                  case none
                    box width=0
            if why != ""
              // The words found, in bold and full strength, in the stretch they were found in.
              text font="-exact-subheadline" color="-exact-secondary-label" line-clamp=2
                for p, i in plainOf(why.replaceAll("**", "¦")).split("¦") key=i
                  text p font-weight=(i % 2 == 1 ? 600 : 400) color=(i % 2 == 1 ? "-exact-label" : "-exact-secondary-label")
            if (entry.kind == "stuck" or entry.kind == "finished") and entry.line != "" and why == ""
              text entry.line font="-exact-subheadline" color="-exact-secondary-label" line-clamp=2
            match ask
              case some(a)
                if inline(a)
                  row gap=8 flex-wrap="wrap" padding-top=2
                    for o in a.options key=o.label
                      button press=answer(a.id, o.label) class=PillTap -exact-press-haptic=(haptics ? "selection" : "none") aria-label=(o.pick ? `${o.label}, hex’s pick` : o.label) testId=`inline-${a.id}-${o.label}`
                        box class=PillFace gap=5 height=32 padding="0 13px" box-sizing="border-box" background-color=(o.pick ? "hex.accent.wash" : "-exact-tertiary-fill")
                          if o.pick
                            image "symbol:icon.pick" width=11 height=11 object-fit="contain" color="hex.accent"
                          text o.label font="-exact-subheadline" font-weight=600 color=(o.pick ? "hex.accent" : "-exact-label")
              case none
                if entry.action != ""
                  row padding-top=2
                    button press=leading disabled=entry.sent class=PillTap -exact-press-haptic=(haptics ? "selection" : "none") testId=`act-${entry.id}`
                      box class=PillFace height=32 padding="0 13px" box-sizing="border-box"
                        text (entry.kind == "stuck" and entry.sent ? "Sent to hex" : entry.action) font="-exact-subheadline" font-weight=600
                else if entry.kind == "stuck" and entry.sent
                  text "Sent to hex" font="-exact-footnote" color="-exact-secondary-label"
            if word.status == "failed"
              text failedWords(word) font="-exact-footnote" color="hex.danger"
        if entry.kind == "ask"
          button id=`${entry.id}-away` press=dismiss(entry.id) destructive=true flex-shrink=0 scroll-snap-align="start" testId=`away-${entry.id}`
            image "symbol:sf/hand.raised.slash"
            text "Not needed"
        for t, i in opens key=`${t.app}${i}`
          link id=`${entry.id}-tile-${i}` href=tileHref(t) accent-color=appTint(t.app) flex-shrink=0 scroll-snap-align="start" testId=`tile-${entry.id}-${i}`
            image appSymbol(t.app)
            text tileLabel(t)

// An ask put away here: the question, quiet, over what was said → where it went, and Undo. On its
// way it is dimmed with a turning ring; a place out of reach says so in amber, with Send again.
component Folded
  inject
    haptics: bool
  props
    said: Said
    question: string
    topic: string
    // Its padding, as the list's rows have it.
    pad: string
    undo: action
    again: action
  derive where = said.detail != "" ? said.detail : said.topic != "" ? said.topic : topic
  view
    row gap=10 align-items="center" padding=pad testId=`folded-${said.id}`
      box align-self="flex-start" padding-top=1 flex-shrink=0
        Mark(state="done", size=22)
      column flex=1 min-width=0 gap=1
        text (said.question != "" ? said.question : question) font="-exact-subheadline" color="-exact-secondary-label" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        row gap=6 align-items="center" opacity=(said.status == "sending" ? 0.6 : 1) aria-label=`${said.label}, ${said.status == "sending" ? "sending to" : "sent to"} ${where}`
          text font="-exact-headline" color="-exact-label" line-clamp=2 min-width=0 flex-shrink=1
            text said.label
            text " → " font-weight=400 color="-exact-tertiary-label"
            text where
          if said.status == "sending"
            progress width=14 height=14 flex-shrink=0 aria-label="Sending"
        if said.missed > 0
          row gap=8 align-items="center" flex-wrap="wrap" margin-top=4
            text unreached(said.missed) font="-exact-footnote" color="hex.ask"
            button press=again(said.id) class=PillTap min-height=32 testId=`again-${said.id}`
              box class=PillFace padding="4px 10px"
                text "Send again" font="-exact-footnote" font-weight=600 color="-exact-label"
      button press=undo(said.id) class=PillTap -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`Undo ${said.label}` testId=`undo-${said.id}`
        box class=PillFace
          text "Undo" font="-exact-subheadline" font-weight=600 color="-exact-label"

// What hex took off Bassim's list to decide itself: its topic, the question, and Undo, which puts it
// back on his list. A tap opens the thread hex decides it in.
component DecidedRow
  inject
    haptics: bool
  props
    ask: Ask
    said: Said[]
    href: string
    split: bool
    selected: bool
    select: action
    undo: action
  derive word = match said.filter(s => s.id == ask.id and s.status == "failed").at(-1) { case some(s) => s, case none => Said(id="", verb="", label="", status="", detail="", missed=0, question="", topic="", task="") }
  view
    row gap=10 align-items="center" testId=`decided-${ask.id}`
      if split
        button press=select class=RowTap flex=1 min-width=0 width="auto" padding="8px 10px" margin="0 0 0 -10px" background-color=(selected ? "-exact-tertiary-fill" : "transparent") aria-current=selected -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`hex decided, ${ask.topic}: ${ask.question}` testId=`decided-open-${ask.id}`
          DecidedLines(ask=ask, word=word)
      else
        link href=href display="flex" flex-direction="row" gap=12 align-items="flex-start" flex=1 min-width=0 padding="8px 0" -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`hex decided, ${ask.topic}: ${ask.question}` testId=`decided-open-${ask.id}`
          DecidedLines(ask=ask, word=word)
      button press=undo(ask.id) class=PillTap -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`Undo, put “${ask.question}” back on your list` testId=`decided-undo-${ask.id}`
        box class=PillFace padding="5px 12px"
          text "Undo" font="-exact-subheadline" font-weight=600

component DecidedLines
  props
    ask: Ask
    word: Said
  view
    Mark(state="decided", size=22)
    column flex=1 min-width=0 gap=2
      text ask.topic font="-exact-headline" line-clamp=1
      text ask.question font="-exact-subheadline" color="-exact-secondary-label" line-clamp=2
      if ask.took != ""
        text `✦ ${ask.took}` font="-exact-subheadline" font-weight=600 color="hex.accent" line-clamp=1
      if word.id != ""
        text failedWords(word) font="-exact-footnote" color="hex.danger"
