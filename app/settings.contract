// Voice and appearance (§10, first page): how hex looks, how much it reacts, its voice, and the
// call's sounds and haptics, each saying what it does. A page like Calls, under the chrome; with two
// columns hex's face and its colours on the first and the settings on the second.
use Settings, Counts from "./shapes.contract"
use Option, personas, paletteColor, Tap, PillTap, Head from "./parts.contract"
use Room, Chrome from "./room.contract"
use PageTitle from "./calls.contract"

shape Swatch
  id: string
  label: string
  color: string

fn colors(): Swatch[] = [Swatch(id="#FFFFFF", label="White", color="#FFFFFF"), Swatch(id="#FFB3C7", label="Rose", color="#FFB3C7"), Swatch(id="#FFCDA8", label="Peach", color="#FFCDA8"), Swatch(id="#FFEDA6", label="Lemon", color="#FFEDA6"), Swatch(id="#D5F2B6", label="Lime", color="#D5F2B6"), Swatch(id="#C4F3E5", label="Mint", color="#C4F3E5"), Swatch(id="#A9CCFF", label="Sky", color="#A9CCFF"), Swatch(id="#CDB8FF", label="Lilac", color="#CDB8FF")]
fn palettes(): Swatch[] = ["original", "2", "3", "4", "5", "6", "7", "8", "9"].map(p => Swatch(id=p, label=(p == "original" ? "Original" : p == "2" ? "Red" : p == "3" ? "Orange" : p == "4" ? "Yellow" : p == "5" ? "Green" : p == "6" ? "Teal" : p == "7" ? "Blue" : p == "8" ? "Purple" : "Pink"), color=paletteColor(p)))
fn voiceName(id: string): string = id == "" ? "Marin" : `${id.slice(0, 1).toUpperCase()}${id.slice(1)}`

component SettingsScreen
  inject
    haptics: bool
  props
    entry: Entry
    room: Room
    settings: Settings
    counts: Counts
    voice: string
    persona: string
    personaColor: string
    opalPalette: string
    reaction: string
    sounds: bool
    still: bool
    docked: bool
    setPersona: action
    setPersonaColor: action
    setOpalPalette: action
    setReaction: action
    setSounds: action
    setHaptics: action
    preview: action
    open: action
    openTasks: action
    back: action
  derive two = room.columns == 2
  derive faceWidth = two ? room.first.width : room.clear.width
  derive rowsLeft = two ? room.second.x : room.clear.x
  derive rowsWidth = two ? room.second.width : room.clear.width
  derive pagerWidth = min(faceWidth - 40, 420)
  derive voiceLine = `${voiceName(voice)}${match settings.personalities.filter(p => p.id == settings.personality and p.id != "default").at(0) { case some(p) => ` · ${p.label}`, case none => "" }}`
  derive chosenColor = personaColor == "" ? "#FFFFFF" : personaColor
  derive faces = personas().map(o => Option(o, detail=`${o.detail} · swipe for other faces`))
  action pickPersona(p: string)
    if haptics
      haptic("selection")
    setPersona(p)
  action pickSwatch(id: string)
    if haptics
      haptic("selection")
    if persona == "opal"
      setOpalPalette(id)
    else
      setPersonaColor(id)
  // Each pick plays a short phrase on the orb, so its amount shows.
  state spoken = 0
  action pickReaction(r: string)
    if haptics
      haptic("selection")
    setReaction(r)
    spoken = spoken + 1
  view
    column navigationKey=`${entry.id}` navigationBar="none" -exact-safe-area="none" position="absolute" inset=0 background-color="-exact-background" testId="settings"
      Chrome(room=room, on="settings", needsYou=counts.yours, working=counts.working, open=open, openTasks=openTasks, back=back)
      if two
        column position="absolute" top=room.below bottom=0 left=room.first.x width=room.first.width testId="settings-persona-pane"
          PageTitle(text="Voice and appearance", room=room, left=20, id="settings-title")
          column flex=1 align-items="center" justify-content="center" gap=18 padding-bottom=(room.foot + 24)
            Face(persona=persona, tint=chosenColor, palette=opalPalette, reaction=reaction, still=still, spoken=spoken, size=200)
            Pager(options=faces, value=persona, pick=pickPersona, replay=pickPersona, width=pagerWidth, locked=false, note="", label="Persona", testKey="persona")
            Swatches(persona=persona, colors=colors(), palettes=palettes(), chosen=(persona == "opal" ? opalPalette : chosenColor), pick=pickSwatch)
      scroll id="settings" position="absolute" top=(two ? room.secondBelow : room.below) bottom=0 left=rowsLeft width=rowsWidth padding-bottom=(room.foot + (docked ? 88 : 24)) box-sizing="border-box" mask-image="linear-gradient(to bottom, transparent 0, #000 12px, #000 100%)" testId="settings-scroll"
        if not two
          PageTitle(text="Voice and appearance", room=room, left=20, id="settings-title")
          column align-items="center" gap=14 padding="16px 0 8px" testId="settings-persona"
            Face(persona=persona, tint=chosenColor, palette=opalPalette, reaction=reaction, still=still, spoken=spoken, size=150)
            Pager(options=faces, value=persona, pick=pickPersona, replay=pickPersona, width=pagerWidth, locked=false, note="", label="Persona", testKey="persona")
            Swatches(persona=persona, colors=colors(), palettes=palettes(), chosen=(persona == "opal" ? opalPalette : chosenColor), pick=pickSwatch)
        column padding="8px 20px 0"
          Setting(icon="symbol:microphone", title="Reacts to you", line="How much hex’s face moves when you talk", stack=(rowsWidth < 460), last=false, id="setting-reaction")
            row role="radiogroup" aria-label="How much the orb reacts to your voice" width=208 flex-shrink=0 testId="reaction"
              for r in [Option(id="off", label="Off", detail=""), Option(id="subtle", label="Subtle", detail=""), Option(id="lively", label="Lively", detail="")] key=r.id
                button role="radio" aria-checked=(reaction == r.id) press=pickReaction(r.id) flex=1 min-height=36 testId=`reaction-${r.id}`
                  text r.label
          row gap=4 align-items="center" min-height=64 testId="setting-voice"
            link href=path("voice") class=Tap flex=1 min-width=0 display="flex" flex-direction="row" gap=14 align-items="center" padding="10px 0" aria-label=`Voice, ${voiceLine}. Change the voice and how it talks` testId="open-voice"
              SettingLines(icon="symbol:waveform", title="Voice", line=`${voiceLine} · tap ▶ to hear it`)
            button press=preview(voice) class=PillTap -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`Hear ${voiceName(voice)}` testId="hear-voice"
              box width=40 height=40 border-radius=20 background-color="-exact-tertiary-fill" display="flex" align-items="center" justify-content="center"
                image "symbol:sf/play.fill" width=14 height=14 object-fit="contain" color="-exact-label"
            link href=path("voice") class=Tap width=32 height=44 display="flex" align-items="center" justify-content="flex-end" aria-label="Change the voice" testId="open-voice-chevron"
              image "symbol:sf/chevron.right" width=12 height=12 object-fit="contain" color="-exact-tertiary-label"
          Head(label="Calls", n=-1, pad="24px 0 4px", id="settings-calls-head")
          Setting(icon="symbol:speaker", title="Call sounds", line="A tone when a call starts and ends", stack=false, last=false, id="setting-sounds")
            input type="checkbox" role="switch" accent-color="ink.switch" checked=sounds change=setSounds aria-label="Call sounds" testId="sounds"
          Setting(icon="symbol:sf/hand.tap", title="Haptics", line="A light tap when you pick something", stack=false, last=true, id="setting-haptics")
            input type="checkbox" role="switch" accent-color="ink.switch" checked=haptics change=setHaptics aria-label="Haptics" testId="haptics"

// hex's face as it will look on Home, changing the moment a persona or colour is picked.
component Face
  props
    persona: string
    tint: string
    palette: string
    reaction: string
    still: bool
    spoken: number
    size: number
  view
    hex-orb state="idle" silenced="false" persona=persona tint=tint palette=(palette == "original" ? "" : palette) reaction=reaction still=(still ? "true" : "false") speak=`${spoken}` width=size height=size role="img" aria-label=`hex as ${persona}` testId="settings-orb"

// One setting: its icon, its name, what it does in a grey line, and its control (children) on the
// right, or under the words where the column is narrow.
component Setting
  props
    icon: string
    title: string
    line: string
    stack: bool
    last: bool
    id: string
  slot
  view
    column border-bottom=(last ? "none" : "0.5px solid -exact-separator") testId=id
      row gap=14 align-items="center" min-height=64 padding="10px 0" flex-wrap="nowrap"
        SettingLines(icon=icon, title=title, line=line)
        if not stack
          children
      if stack
        row padding="0 0 12px 42px"
          children

component SettingLines
  props
    icon: string
    title: string
    line: string
  view
    image icon width=22 height=22 object-fit="contain" color="-exact-secondary-label" flex-shrink=0 aria-hidden=true
    column flex=1 min-width=0 gap=2
      text title font="-exact-body" color="-exact-label"
      text line font="-exact-subheadline" color="-exact-secondary-label"

// The colours the orb can take: Opal's palettes, or the colour the other faces take. Mana keeps its own.
component Swatches
  props
    persona: string
    colors: Swatch[]
    palettes: Swatch[]
    chosen: string
    pick: action
  derive set = persona == "opal" ? palettes : colors
  derive custom = persona != "opal" and chosen != "" and colors.filter(c => c.id == chosen).length == 0
  view
    column gap=8 align-items="center" testId="swatches"
      row role="radiogroup" appearance="none" aria-label=(persona == "opal" ? "Opal colors" : persona == "mana" ? "Mana keeps its own color" : "Persona color") gap=6 justify-content="center" flex-wrap="wrap" opacity=(persona == "mana" ? 0.35 : 1)
        for s in set key=s.id
          button role="radio" aria-checked=(chosen == s.id) press=pick(s.id) disabled=(persona == "mana") class=Tap width=36 height=36 border-radius=18 border=(chosen == s.id and persona != "mana" ? "2px solid -exact-label" : "2px solid transparent") display="flex" align-items="center" justify-content="center" aria-label=s.label testId=`swatch-${s.label}`
            box width=26 height=26 border-radius=13 background-color=(persona == "mana" ? "-exact-tertiary-fill" : s.color == "" ? "transparent" : s.color) background-image=(persona != "mana" and s.color == "" ? "linear-gradient(135deg, #2FB5AD, #9B4DD6 50%, #F07B3F)" : "none") border="0.5px solid -exact-separator"
        // The persona's own colour, past the presets (not Opal's palettes; Mana keeps its own).
        if persona != "opal" and persona != "mana"
          box width=36 height=36 border-radius=18 border=(custom ? "2px solid -exact-label" : "2px solid transparent") display="flex" align-items="center" justify-content="center" testId="swatch-custom"
            hex-color hue=chosen custom=(custom ? "true" : "false") change=pick width=28 height=28 aria-label=(custom ? "Custom color, selected" : "Custom color") testId="custom-color"
      if persona == "mana"
        text "Mana keeps its own color" font="-exact-footnote" color="-exact-secondary-label" testId="mana-note"

// Swipe between a few things, one a page, each named with a line under it; tap one to hear it again.
// The dots say where you are.
component Pager
  props
    options: Option[]
    value: string
    pick: action
    replay: action
    width: number
    locked: bool
    note: string
    label: string
    testKey: string
  state x = 0
  derive index = max(0, options.map(o => o.id).indexOf(value))
  action moved(left: number, top: number)
    x = left
  action settled
    match options.at(round(x / width))
      case some(o)
        if o.id != value
          pick(o.id)
      case none
        x = x
  view
    column align-items="center" gap=10 width=width aria-label=label testId=`pager-${testKey}`
      if locked
        column width=width align-items="center" gap=2 padding="6px 0" testId=`pager-${testKey}-locked`
          text (match options.at(index) { case some(o) => o.label, case none => "" }) font="-exact-title2" font-weight=600
          text note font="-exact-subheadline" color="-exact-secondary-label" text-align="center"
      else
        scroll display="flex" flex-direction="row" width=width overflow-x="scroll" overflow-y="hidden" scroll-snap-type="x mandatory" scrollbar-width="none" scrollLeft=(index * width) scroll=moved scrollend=settled testId=`pager-${testKey}-scroll`
          for o in options key=o.id
            button press=replay(o.id) class=Tap width=width flex-shrink=0 scroll-snap-align="center" display="flex" flex-direction="column" align-items="center" gap=2 padding="6px 0" aria-label=`${o.label}, ${o.detail}` aria-current=(o.id == value) testId=`${testKey}-${o.id}`
              text o.label font="-exact-title2" font-weight=600 color="-exact-label"
              text o.detail font="-exact-subheadline" color="-exact-secondary-label" text-align="center" white-space="nowrap"
        row gap=6 justify-content="center" aria-hidden=true
          for o in options key=o.id
            box width=6 height=6 border-radius=3 background-color="-exact-label" opacity=(o.id == value ? 0.9 : 0.2)
