// Steps (§9.5): how hex is going about a task. Its plan, the agents it started, and every step of
// the run, newest first, grouped into turns that each end where hex said something. A tap opens a
// step's detail and result, or an agent's result and its own steps.
use Viewport, Counts, TaskPage, Step, Agent from "./shapes.contract"
use Mark, Head, Note, ShowMore, RowTap, whenOf, appName, lengthOf, Tap, Prose from "./parts.contract"
use Room, Chrome from "./room.contract"
use PageHead from "./task.contract"

fn kindSymbol(kind: string): string = kind == "think" ? "symbol:sf/brain" : kind == "say" ? "symbol:sf/text.bubble" : kind == "plan" ? "symbol:sf/list.number" : kind == "run" ? "symbol:sf/terminal" : kind == "read" ? "symbol:sf/doc.text" : kind == "edit" ? "symbol:sf/pencil" : kind == "search" ? "symbol:search" : kind == "web" ? "symbol:sf/globe" : kind == "agent" ? "symbol:sf/person.2" : "symbol:sf/wrench.and.screwdriver"

// One turn: the steps up to and including something hex said.
shape Turn
  n: number
  title: string
  steps: Step[]
  start: number
  end: number

fn says(steps: Step[]): number = steps.filter(s => s.kind == "say").length
fn turnIndex(asc: Step[], i: number): number = says(asc.slice(0, i))
fn turnsOf(steps: Step[], running: bool, now: number, offset: number): Turn[] = range(says(sortBy(steps, s => s.at)) + 1).map(n => turnOf(sortBy(steps, s => s.at), n, says(sortBy(steps, s => s.at)), running, now, offset)).filter(t => t.steps.length > 0).slice(0, 40)
fn blankStep(): Step = Step(id="", at=0, ended=0, kind="", text="", state="", detail="", result="", agent="")
fn stepAt(asc: Step[], i: number): Step = match asc.at(i) { case some(s) => s, case none => blankStep() }
fn turnSteps(asc: Step[], n: number): Step[] = range(asc.length).filter(i => turnIndex(asc, i) == n).map(i => stepAt(asc, i))
fn turnOf(asc: Step[], n: number, last: number, running: bool, now: number, offset: number): Turn = Turn(n=n, title=(n == last ? (running ? "Now" : "Since its last message") : match turnSteps(asc, n).at(-1) { case some(s) => `Said ${whenOf(s.at, now, offset)}`, case none => "" }), steps=sortBy(turnSteps(asc, n), s => s.at, "desc"), start=0, end=0)
fn spanOf(steps: Step[]): number = steps.length == 0 ? 0 : (max(match steps.at(0) { case some(s) => max(s.ended, s.at), case none => 0 }, 0) - match steps.at(-1) { case some(s) => s.at, case none => 0 }) / 1000
fn stepTime(s: Step, now: number, offset: number): string = s.ended > s.at ? lengthOf((s.ended - s.at) / 1000) : whenOf(s.at, now, offset)

// An agent stopped and started again under the same name: the earlier tries fold under the last.
fn retried(agents: Agent[], a: Agent): bool = a.state == "stopped" and agents.filter(b => b.label == a.label and b.since > a.since).length > 0

component Steps
  inject
    haptics: bool
  props
    entry: Entry
    room: Room
    clearTop: number
    counts: Counts
    callOn: bool
    viewport: Viewport
    now: number
    offset: number
    task: TaskPage
    loading: bool
    failed: bool
    open: action
    openTasks: action
    back: action
  // With two columns, the task page this belongs to, on the left of the fold.
  slot
  state opened = [""].slice(0, 0)
  state showTries = false
  derive done = task.plan.filter(p => p.state == "done").length
  derive turns = sortBy(turnsOf(task.steps, task.running, now, offset), t => t.n, "desc")
  derive agents = task.agents.filter(a => not retried(task.agents, a))
  derive tries = task.agents.filter(a => retried(task.agents, a))
  derive agentWords = ["working", "done", "failed", "stopped"].filter(s => task.agents.filter(a => a.state == s).length > 0).map(s => `${task.agents.filter(a => a.state == s).length} ${s}`).join(" · ")
  derive subtitle = `${task.place != "" ? task.place : task.name}${task.plan.length > 0 ? ` · ${done} of ${task.plan.length} done` : task.running ? ` · working for ${lengthOf((now - task.since) / 1000)}` : ""}`
  derive two = room.columns == 2
  derive foot = callOn ? room.foot + 64 + 12 : room.foot
  action flip(id: string)
    opened = opened.includes(id) ? opened.filter(o => o != id) : opened.concat([id])
    if haptics
      haptic("selection")
  action flipTries
    showTries = not showTries
  view
    column navigationKey=`${entry.id}` navigationBar="none" -exact-safe-area="none" navigationScroll="steps" position="absolute" inset=0 background-color="-exact-background" testId="steps"
      Chrome(room=room, on="steps", needsYou=counts.yours, working=counts.working, open=open, openTasks=openTasks, back=back)
      if two
        column position="absolute" top=room.firstTop bottom=0 left=room.first.x width=room.first.width testId="steps-task"
          children
      column position="absolute" top=(two ? room.secondBelow : room.below) bottom=0 left=(two ? room.second.x : room.clear.x) width=(two ? room.second.width : room.clear.width)
        PageHead(room=room, clearTop=(two ? 0 : clearTop), pane=two, title="Steps", line=subtitle, id="steps-head")
        scroll id="steps" flex=1 min-height=0 overflow-y="auto"
          column padding="0 10px" padding-bottom=(foot + 24)
            if task.id == "" and loading
              Note(kind="loading", text="Loading steps", pad="24px 10px", id="steps-loading")
            if task.id == "" and failed
              Note(kind="failed", text="These steps aren't there any more.", pad="24px 10px", id="steps-gone")
            // The plan: each item with where it stands, a mark of 22 in full-strength type.
            for p, i in task.plan key=`${i}${p.text}`
              row gap=12 align-items="flex-start" padding="9px 10px" testId=`plan-${i}`
                box padding-top=1 flex-shrink=0
                  Mark(state=(p.state == "done" ? "done" : p.state == "working" or p.state == "in_progress" ? "working" : "unstarted"), size=22)
                text p.text flex=1 font="-exact-headline" color=(p.state == "done" or p.state == "working" or p.state == "in_progress" ? "-exact-label" : "-exact-secondary-label")
            // The agents hex started: a tile, its name and "agent", how it stands; it opens in place.
            if task.agents.length > 0
              Head(label=`Agents · ${agentWords}`, n=-1, pad="18px 10px 4px", id="head-agents")
              for a in agents key=a.id
                AgentRow(agent=a, now=now, offset=offset, open=opened.includes(a.id), flip=flip)
              if tries.length > 0
                ShowMore(n=tries.length, shown=showTries, pad="2px 10px", id="agent-tries", press=flipTries)
                if showTries
                  for a in tries key=a.id
                    AgentRow(agent=a, now=now, offset=offset, open=opened.includes(a.id), flip=flip)
            if task.id != "" and task.steps.length == 0
              Note(kind="empty", text=(task.running ? "Steps show while it works" : "No steps yet"), pad="24px 10px", id="steps-empty")
            // Every step of the run, newest first, by turn: a dot on a line, its words in grey, when.
            for t in turns key=`${t.n}`
              button press=flip(`turn${t.n}`) class=RowTap align-items="center" padding="18px 10px 4px" aria-expanded=(not opened.includes(`turn${t.n}`)) testId=`turn-${t.n}`
                text t.title font="-exact-subheadline" font-weight=600 color="-exact-secondary-label" flex=1
                text `${t.steps.length} ${t.steps.length == 1 ? "step" : "steps"}${spanOf(t.steps) >= 1 ? ` · ${lengthOf(spanOf(t.steps))}` : ""}` font="-exact-footnote" color="-exact-tertiary-label"
                image "symbol:icon.open" width=12 height=12 object-fit="contain" color="-exact-tertiary-label" rotate=(opened.includes(`turn${t.n}`) ? "-90deg" : "0deg") aria-hidden=true
              if not opened.includes(`turn${t.n}`)
                column border-left="1.5px solid -exact-separator" margin-left=21
                  for s in t.steps key=s.id
                    StepRow(step=s, now=now, offset=offset, open=opened.includes(s.id), flip=flip)

// One step: a dot on the run's line, what it did in grey, when. One with more to it has a chevron
// that points right, and down once its detail and result are open in place.
component StepRow
  inject
    haptics: bool
  props
    step: Step
    now: number
    offset: number
    open: bool
    flip: action
  derive more = step.detail != "" or step.result != "" or step.text.length > 90
  view
    column gap=6 padding="0 0 0 10px" testId=`step-${step.id}`
      button press=flip(step.id) disabled=(not more) class=RowTap align-items="flex-start" padding="7px 0" aria-expanded=(more ? open : false) -exact-press-haptic=(haptics and more ? "selection" : "none") testId=`step-open-${step.id}`
        box width=7 height=7 border-radius=4 margin-left=-14 margin-top=7 flex-shrink=0 background-color=(step.state == "failed" ? "hex.danger" : step.state == "running" ? "hex.progress" : "-exact-tertiary-label") aria-hidden=true
        box width=14 padding-top=3 flex-shrink=0 aria-hidden=true
          if more
            image "symbol:icon.open" width=11 height=11 object-fit="contain" color="-exact-secondary-label" rotate=(open ? "0deg" : "-90deg")
        text step.text font="-exact-subheadline" line-clamp=(open ? 0 : 2) flex=1 min-width=0 color=(step.state == "failed" ? "hex.danger" : open ? "-exact-label" : "-exact-secondary-label")
        text (step.state == "running" ? "now" : stepTime(step, now, offset)) font="-exact-caption1" color="-exact-tertiary-label" white-space="nowrap" font-variant-numeric="tabular-nums" padding-top=2
      if open and (step.detail != "" or step.result != "")
        column gap=6 margin="0 0 6px 14px" padding="10px 12px" border-radius=14 background-color="-exact-secondary-background"
          if step.detail != ""
            text step.detail font-family="ui-monospace" font="-exact-caption1" color="-exact-secondary-label" user-select="text"
          if step.result != ""
            Prose(text=step.result, font="-exact-subheadline", color=(step.state == "failed" ? "hex.danger" : "-exact-label"))

// An agent hex started: a tile, its name and "agent", how it stands on the right; a tap opens its
// result and its own steps in place.
component AgentRow
  inject
    haptics: bool
  props
    agent: Agent
    now: number
    offset: number
    open: bool
    flip: action
  view
    column gap=4
      button press=flip(agent.id) class=RowTap align-items="center" aria-expanded=open -exact-press-haptic=(haptics ? "selection" : "none") testId=`agent-${agent.id}`
        box width=30 height=30 border-radius=8 background-color="-exact-tertiary-fill" display="flex" align-items="center" justify-content="center" flex-shrink=0 aria-hidden=true
          image "symbol:sf/person.2" width=16 height=16 object-fit="contain" color="-exact-label"
        column flex=1 min-width=0 gap=1
          text `${agent.label} · agent` font="-exact-headline" color="-exact-label" line-clamp=1
          if agent.state == "working" and agent.line != ""
            text agent.line font="-exact-footnote" color="-exact-secondary-label" line-clamp=1
        text (agent.state == "working" ? "working" : agent.state == "failed" ? "failed" : agent.ended > 0 ? `done in ${lengthOf((agent.ended - agent.since) / 1000)}` : agent.state) font="-exact-footnote" color=(agent.state == "working" ? "hex.progress" : agent.state == "failed" ? "hex.danger" : "-exact-secondary-label") white-space="nowrap"
        image "symbol:icon.open" width=12 height=12 object-fit="contain" color="-exact-tertiary-label" rotate=(open ? "0deg" : "-90deg") aria-hidden=true
      if open
        column gap=8 padding="0 0 8px 52px"
          if agent.result != ""
            box padding="10px 12px" border-radius=14 background-color="-exact-secondary-background"
              Prose(text=agent.result, font="-exact-subheadline", color=(agent.state == "failed" ? "hex.danger" : "-exact-label"))
          for s in sortBy(agent.steps, s => s.at, "desc").slice(0, 30) key=s.id
            row gap=8 align-items="baseline"
              box width=6 height=6 border-radius=3 background-color="-exact-tertiary-label" flex-shrink=0 aria-hidden=true
              text s.text font="-exact-footnote" color="-exact-secondary-label" line-clamp=2 flex=1
          if agent.link != ""
            link href=agent.link class=RowTap align-items="center" padding="6px 0" testId=`agent-open-${agent.id}`
              text (agent.via == "t3" or agent.link.startsWith("t3code:") ? "Open in T3 Code" : "Open") font="-exact-subheadline" font-weight=600 color="-exact-label" flex=1
              image "symbol:sf/arrow.up.right" width=12 height=12 object-fit="contain" color="-exact-tertiary-label"
