// A task's page (§9.2, 9.7, 9.8): what it needs from Bassim, what it's doing now, what it did, its
// pinned post, its messages, every place it lives, its week and its history. The same route opens
// a topic with only questions (`topic:<name>`) and a finished thing (`done:<id>`).
use Viewport, Counts, TaskPage, Chat, Asks, Tasks, TaskRow, Ask, Place, Words, Track, Agent, Finished, PinSection, Media from "./shapes.contract"
use Mark, PlaceTile, Row, Head, Note, Discuss, ShowMore, RowTap, PillTap, PillFace, Composer, whenOf, appName, lengthOf, Tap, inlineOf, plainOf from "./parts.contract"
use Room, Chrome from "./room.contract"
use Said, failedWords from "./said.contract"
use Item, Topic, entriesOf, isPart, asksOf, stateWord from "./inbox.contract"
use EntryRow from "./rows.contract"
use AskCard, DecidedCard, ReplyComposer from "./ask.contract"

// A working stretch of a thread's week, as fractions of the lane (log-like: the last hour is a
// fifth of it, the week before three days ago another).
shape Span
  start: number
  end: number

fn hoursAgo(at: number, now: number): number = max(0, (now - at) / 3600000)
fn laneX(h: number): number = h <= 1 ? 1 - 0.2 * h : h <= 6 ? 0.8 - 0.2 * (h - 1) / 5 : h <= 24 ? 0.6 - 0.2 * (h - 6) / 18 : h <= 72 ? 0.4 - 0.2 * (h - 24) / 48 : h <= 168 ? 0.2 - 0.2 * (h - 72) / 96 : 0
fn trackAt(track: Track[], i: number, now: number): number = match track.at(i) { case some(t) => t.at, case none => now }
fn spansOf(track: Track[], now: number): Span[] = range(track.length).filter(i => match track.at(i) { case some(t) => t.state == "working", case none => false }).map(i => Span(start=laneX(hoursAgo(trackAt(track, i, now), now)), end=laneX(hoursAgo(trackAt(track, i + 1, now), now))))
fn failsOf(track: Track[], now: number): number[] = track.filter(t => t.state == "failed").map(t => laneX(hoursAgo(t.at, now)))
fn blankSaid(): Said = Said(id="", verb="", label="", status="", detail="", missed=0, question="", topic="", task="")
fn draftOf(drafts: string[], key: string): string = match drafts.filter(l => l.startsWith(`${key}\t`)).at(0) { case some(l) => l.slice(key.length + 1), case none => "" }
// A question's draft, or the one left on an earlier id of it (hex asks again under a new id).
fn askDraft(drafts: string[], a: Ask): string = match [a.id].concat(a.was).map(id => draftOf(drafts, `ask:${id}`)).filter(d => d.trim() != "").at(0) { case some(d) => d, case none => "" }
fn kindWord(kind: string): string = kind == "think" ? "Thought" : kind == "say" ? "Said" : kind == "run" ? "Ran" : kind == "read" ? "Read" : kind == "edit" ? "Edited" : kind == "search" ? "Searched" : kind == "web" ? "Looked up" : kind == "agent" ? "Agent" : kind == "plan" ? "Planned" : "Used a tool"
// "(Asked Siri) words" from Bassim is an event: its label and its words.
fn eventOf(text: string): string = text.startsWith("(") and text.indexOf(") ") > 1 ? text.slice(1, text.indexOf(") ")) : ""

component TaskScreen
  props
    entry: Entry
    room: Room
    clearTop: number
    counts: Counts
    callOn: bool
    viewport: Viewport
    now: number
    offset: number
    task: TaskPage
    chat: Chat
    asks: Asks
    tasks: Tasks
    said: Said[]
    drafts: string[]
    words: Words
    wordsAsk: string
    loading: bool
    failed: bool
    inCall: bool
    open: action
    openTasks: action
    openTask: action
    answer: action
    answerMany: action
    note: action
    dismiss: action
    undo: action
    again: action
    act: action
    markRead: action
    showWords: action
    keepDraft: action
    talk: action
    message: action
    answering: string
    attached: Media[]
    attachedTo: string
    addError: string
    // Apps a link out didn't open in (not on this iPhone), and the open that hears it.
    missing: string[]
    openOut: action
    attach: action
    detach: action
    back: action
  view
    column navigationKey=`${entry.id}` navigationBar="none" -exact-safe-area="none" navigationScroll="task-page" interactive-widget="resizes-content" position="absolute" inset=0 background-color="-exact-background" testId="task"
      Chrome(room=room, on="task", needsYou=counts.yours, working=counts.working, open=open, openTasks=openTasks, back=back)
      column position="absolute" top=room.below bottom=0 left=room.clear.x width=room.clear.width
        TaskBody(id=entry.params.id, pane=false, room=room, clearTop=clearTop, foot=(callOn ? room.foot + 64 + 12 : room.foot), entry=entry, viewport=viewport, now=now, offset=offset, task=task, chat=chat, asks=asks, tasks=tasks, said=said, drafts=drafts, words=words, wordsAsk=wordsAsk, loading=loading, failed=failed, inCall=inCall, open=open, openTask=openTask, answer=answer, answerMany=answerMany, note=note, dismiss=dismiss, undo=undo, again=again, act=act, markRead=markRead, showWords=showWords, keepDraft=keepDraft, talk=talk, message=message, answering=answering, attached=attached, attachedTo=attachedTo, addError=addError, missing=missing, openOut=openOut, attach=attach, detach=detach, back=back)

// A page's head: its title (two lines at most) and where it stands, clear of the status icons beside
// it, then what it offers (its children: a way out to where it lives, a call about it). Whatever
// follows starts below the icons.
component PageHead
  props
    room: Room
    // Where the column is clear of the status icons (0: it already is, as beside hex's column).
    clearTop: number
    pane: bool
    title: string
    line: string
    id: string
  slot
  derive inset = pane or room.columns == 2 ? 20 : max(20, room.clear.x + room.clear.width - room.bar.end)
  view
    column flex-shrink=0 gap=4 padding-left=20 padding-right=inset padding-top=(pane ? 6 : 0) padding-bottom=10 min-height=(pane ? 0 : max(0, clearTop - room.below)) box-sizing="border-box" testId=id
      text title role="heading" aria-level=1 font="-exact-title1" font-weight=700 color="-exact-label" line-clamp=2
      if line != ""
        text line font="-exact-subheadline" color="-exact-secondary-label" line-clamp=2
      row gap=8 flex-wrap="wrap" align-items="center" margin-left=-4
        children

// A row that goes further in the app: its words and a chevron pointing right.
component Further
  inject
    haptics: bool
  props
    label: string
    line: string
    id: string
    press: action
  view
    button press=press class=RowTap align-items="center" -exact-press-haptic=(haptics ? "selection" : "none") aria-label=(line != "" ? `${label}, ${line}` : label) testId=id
      column flex=1 min-width=0 gap=2
        text label font="-exact-headline" color="-exact-label"
        if line != ""
          text line font="-exact-subheadline" color="-exact-secondary-label" line-clamp=1
      image "symbol:forward-chevron" width=13 height=13 object-fit="contain" color="-exact-tertiary-label" aria-hidden=true

// One line of what happened, with its mark and when.
component Happened
  props
    mark: string
    text: string
    stamp: string
    failed: bool
  view
    row gap=12 align-items="flex-start" padding="7px 10px"
      box padding-top=1 flex-shrink=0
        Mark(state=mark, size=22)
      text text font="-exact-body" color=(failed ? "hex.danger" : "-exact-label") line-clamp=3 flex=1 min-width=0
      text stamp font="-exact-caption1" font-variant-numeric="tabular-nums" color="-exact-tertiary-label" white-space="nowrap" padding-top=3

// The page itself: a route's (TaskScreen), or a page beside a list (Tasks, Home) with two columns.
component TaskBody
  inject
    haptics: bool
  props
    id: string
    pane: bool
    room: Room
    clearTop: number
    // How far the page's foot stands off the window's bottom (the call docked there, the home indicator).
    foot: number
    // The route this shows on (a pane beside the list shows on the list's).
    entry: Entry
    viewport: Viewport
    now: number
    offset: number
    task: TaskPage
    chat: Chat
    asks: Asks
    tasks: Tasks
    said: Said[]
    drafts: string[]
    words: Words
    wordsAsk: string
    loading: bool
    failed: bool
    inCall: bool
    open: action
    openTask: action
    answer: action
    answerMany: action
    note: action
    dismiss: action
    undo: action
    again: action
    act: action
    markRead: action
    showWords: action
    keepDraft: action
    talk: action
    message: action
    answering: string
    attached: Media[]
    attachedTo: string
    addError: string
    // Apps a link out didn't open in (not on this iPhone), and the open that hears it.
    missing: string[]
    openOut: action
    attach: action
    detach: action
    back: action
  state replying = ""
  state allPlaces = false
  derive topicName = id.startsWith("topic:") ? id.slice(6) : ""
  derive doneId = id.startsWith("done:") ? id.slice(5) : ""
  derive kind = topicName != "" ? "topic" : doneId != "" ? "done" : "task"
  // The thread as the list knows it, until the page's own answer comes.
  derive row = match tasks.tasks.filter(t => t.id == id).at(0) { case some(t) => t, case none => TaskRow(id=task.id, app=task.app, thread=task.thread, name=task.name, where=task.where, place=task.place, state=task.state, running=task.running, line=task.line, since=task.since, at=task.at, link=task.link, track=task.track, agents=task.agents) }
  derive known = task.id == id
  derive title = kind == "topic" ? topicName : kind == "done" ? finished.title : (row.place != "" ? row.place : row.name)
  derive parent = isPart(row) ? row.name : ""
  derive pageAsks = kind == "topic" ? asks.asks.filter(a => a.topic == topicName) : asksOf(row, asks.asks)
  derive pageDecided = kind == "topic" ? asks.decided.filter(a => a.topic == topicName) : kind == "task" ? asksOf(row, asks.decided) : asks.decided.slice(0, 0)
  derive waiting = pageAsks.filter(a => said.filter(s => s.id == a.id and s.verb != "note" and s.status != "failed").length == 0).length
  derive siblings = sortBy(tasks.tasks.filter(t => t.name == row.name and t.id != row.id), t => t.at, "desc")
  derive places = [row].concat(siblings)
  derive working = siblings.filter(t => t.state == "working")
  derive busyAgents = task.agents.filter(a => a.state == "working")
  derive subtitle = kind == "topic" ? (waiting > 0 ? `${waiting} need you` : `${topicEntries.length} here`) : kind == "done" ? `Done · ${whenOf(finished.at, now, offset)}` : `${parent != "" ? `${parent} · ` : ""}${row.state == "needs" ? `Waiting on you since ${whenOf(row.since, now, offset)}` : row.state == "working" ? `Working · started ${lengthOf((now - row.since) / 1000)} ago` : row.state == "done" ? `Done ${whenOf(row.at, now, offset)}` : stateWord(row.state)}${waiting > 0 ? ` · ${waiting} need you` : ""}`
  derive finished = match tasks.finished.filter(f => f.id == doneId).at(0) { case some(f) => f, case none => Finished(id="", title="", topic="", app="", proof="", at=0, run="", link="", said="", links=[]) }
  derive topicEntries = entriesOf(tasks, asks, now).filter(e => e.topic == topicName and e.kind != "ask")
  // The reply box docked at the foot: for the question Bassim picked, else the first still open, else
  // the first on the page, so answering doesn't swap it away.
  derive replyAsk = replying != "" ? pageAsks.filter(a => a.id == replying) : pageAsks.filter(a => said.filter(s => s.id == a.id and s.verb != "note" and s.status != "failed").length == 0).concat(pageAsks).slice(0, 1)
  derive weekly = places.filter(t => t.track.length > 0)
  // The door out to where this lives: the thread's own place, the finished item's, or a topic's
  // first question's.
  derive door = kind == "task" ? match places.filter(t => t.place == row.place and t.link != "").at(0) { case some(t) => Place(app=t.app, place=t.place, task=t.id, call="", link=t.link), case none => Place(app="", place="", task="", call="", link="") } : kind == "done" ? Place(app=finished.app, place="", task="", call="", link=finished.link) : match pageAsks.map(a => a.places).flat().filter(p => p.link != "").at(0) { case some(p) => p, case none => Place(app="", place="", task="", call="", link="") }
  derive width = pane ? room.second.width : room.clear.width
  // A composer docked at the foot: the page scrolls to its top edge and fades over the 24 above it.
  derive docked = replyAsk.length == 0 and kind == "task" and chat.sends
  action reply(askId: string)
    replying = askId
  action closeReply
    replying = ""
  action morePlaces
    allPlaces = not allPlaces
  action toSteps
    open(path("steps", id))
  action toMessages
    open(path("thread", id))
  action toProject
    openTask(finished.run)
  view
    column flex=1 min-height=0 height="100%"
      PageHead(room=room, clearTop=clearTop, pane=pane, title=title, line=subtitle, id=(pane ? "pane-head" : "task-head"))
        if door.link != ""
          button press=openOut(door.link, door.app) class=PillTap -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`Open in ${appName(door.app)}` testId=(pane ? "pane-door" : "task-door-bar")
            box class=PillFace gap=8 padding="5px 12px 5px 6px"
              PlaceTile(place=door, size=22)
              text appName(door.app) font="-exact-subheadline" font-weight=600 color="-exact-label"
        if kind != "done"
          Discuss(title=title, id=(pane ? "pane-talk" : "task-talk"), press=talk(kind == "task" ? id : "asks"))
        if missing.includes(door.app)
          text `${appName(door.app)} isn’t on this iPhone` font="-exact-footnote" color="hex.danger" padding-left=4 width="100%" testId="door-missing"
      scroll id=(pane ? "task-pane" : "task-page") testId=(pane ? "task-pane" : "task-page") flex=1 min-height=0 overflow-y="auto" margin-bottom=(docked ? foot + 8 + 44 + 6 : 0) mask-image=(docked or replyAsk.length > 0 ? "linear-gradient(to top, transparent 0, #000 24px)" : "none")
        column padding="0 10px" padding-bottom=(docked or replyAsk.length > 0 ? 30 : foot + 24) gap=0
          if kind == "done"
            Happened(mark="done", text=finished.title, stamp="", failed=false)
            if finished.said != ""
              Head(label="Proof", n=-1, pad="18px 10px 4px", id="head-proof")
              text finished.said font="-exact-body" user-select="text" padding="2px 10px"
              for l in finished.links key=l.url
                link href=l.url class=RowTap align-items="center" testId=`proof-${l.label}`
                  text l.label font="-exact-body" color="-exact-label" flex=1
                  image "symbol:sf/arrow.up.right" width=12 height=12 object-fit="contain" color="-exact-tertiary-label"
            if finished.run != ""
              Further(label=finished.topic, line="The project it was for", id="done-project", press=toProject)
          else
            if kind == "task" and loading and not known and row.id == ""
              Note(kind="loading", text="Loading", pad="24px 10px", id="task-loading")
            if kind == "task" and failed and not known and row.id == ""
              Note(kind="failed", text="hex didn't answer, so this can't open yet.", pad="24px 10px", id="task-offline")
            for a, i in pageAsks key=a.id
              // An open question swipes to Not needed, as a row in the list does.
              if said.filter(s => s.id == a.id and s.verb != "note" and s.status != "failed").length > 0
                AskCard(ask=a, n=(i + 1), of=pageAsks.length, now=now, offset=offset, said=match said.filter(s => s.id == a.id).at(-1) { case some(s) => s, case none => blankSaid() }, draft=askDraft(drafts, a), words=(wordsAsk == a.id ? words : Words(place="", at=0, text="")), wordsOpen=(wordsAsk == a.id), showWords=showWords, answer=answer, answerMany=answerMany, dismiss=dismiss, undo=undo, again=again, reply=reply, open=open, width=(width - 40))
              else
                scroll swipeContent=`${a.id}-card` swipeTrailing=`${a.id}-card-away` display="flex" overflow-x="scroll" overflow-y="hidden" scrollbar-width="none" scroll-snap-type="x mandatory" testId=`ask-swipe-${a.id}`
                  box id=`${a.id}-card` width="100%" flex-shrink=0 scroll-snap-align="start" box-sizing="border-box"
                    AskCard(ask=a, n=(i + 1), of=pageAsks.length, now=now, offset=offset, said=match said.filter(s => s.id == a.id).at(-1) { case some(s) => s, case none => blankSaid() }, draft=askDraft(drafts, a), words=(wordsAsk == a.id ? words : Words(place="", at=0, text="")), wordsOpen=(wordsAsk == a.id), showWords=showWords, answer=answer, answerMany=answerMany, dismiss=dismiss, undo=undo, again=again, reply=reply, open=open, width=(width - 40))
                  button id=`${a.id}-card-away` press=dismiss(a.id) destructive=true flex-shrink=0 scroll-snap-align="start" testId=`card-away-${a.id}`
                    image "symbol:sf/hand.raised.slash"
                    text "Not needed"
            if kind == "topic" and topicEntries.length > 0
              for e in topicEntries key=e.id
                EntryRow(entry=e, asks=asks.asks, said=said, why="", now=now, offset=offset, answer=answer, dismiss=dismiss, undo=undo, again=again, act=act, markRead=markRead, openPage=openTask)
            if kind == "task" and task.needs != "" and pageAsks.length == 0
              Head(label="Needs you", n=-1, pad="18px 10px 4px", id="head-needs")
              Happened(mark="needs", text=task.needs, stamp=whenOf(row.since, now, offset), failed=false)
            if kind == "task" and (row.state == "working" or working.length > 0 or busyAgents.length > 0)
              Head(label="Now", n=-1, pad="18px 10px 4px", id="head-now")
              if row.state == "working"
                Happened(mark="working", text=(row.line != "" ? row.line : "Working"), stamp=lengthOf((now - row.since) / 1000), failed=false)
              for t in working key=t.id
                Row(mark="working", title=t.place, line=t.line, lines=2, failed=false, stamp=whenOf(t.at, now, offset), n=0, selected=false, href="", label=`${t.place}, working: ${t.line}`, id=`working-${t.id}`, press=openTask(t.id))
            if kind == "task" and (task.steps.length > 0 or task.agents.length > 0)
              Further(label="Steps", line=(task.agents.length > 0 ? `${task.agents.length} ${task.agents.length == 1 ? "agent" : "agents"} · ${task.agents.slice(0, 3).map(a => a.label).join(", ")}` : match sortBy(task.steps, s => s.at, "desc").at(0) { case some(s) => `${kindWord(s.kind)}: ${s.text}`, case none => "" }), id="task-steps", press=toSteps)
            if kind == "task"
              for p, i in task.pins key=`${p.title}${i}`
                Pinned(section=p, first=(i == 0))
            if kind == "task" and chat.turns.length > 0
              Head(label="Messages", n=chat.total, pad="18px 10px 4px", id="head-messages")
              for t in chat.turns.slice(-2) key=t.id
                row justify-content=(t.source == "me" ? "flex-end" : "flex-start") padding="3px 10px"
                  text plainOf(eventOf(t.text) != "" ? t.text.slice(eventOf(t.text).length + 3) : t.text) font="-exact-body" line-clamp=4 max-width=(t.source == "me" ? "85%" : "100%") padding=(t.source == "me" ? "8px 14px" : "0") border-radius=18 background-color=(t.source == "me" ? "-exact-tertiary-fill" : "transparent")
              Further(label="All messages", line="", id="task-messages", press=toMessages)
            if kind == "task" and weekly.length > 0
              Head(label="This week", n=-1, pad="18px 10px 6px", id="head-week")
              column gap=6 padding="4px 10px"
                for t in weekly.slice(0, 6) key=t.id
                  row gap=8 align-items="center"
                    text (t.place != "" ? t.place : t.name) font="-exact-caption1" color="-exact-secondary-label" width="5.5rem" flex-shrink=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                    svg flex=1 height=12 viewBox="0 0 1000 12" preserveAspectRatio="none" aria-hidden=true
                      rect x=0 y=5 width=1000 height=2 rx=1 fill="-exact-quaternary-fill"
                      for s, j in spansOf(t.track, now) key=`${j}`
                        rect x=(s.start * 1000) y=2 width=max(6, (s.end - s.start) * 1000) height=8 rx=4 fill="hex.progress"
                      for x, j in failsOf(t.track, now) key=`f${j}`
                        rect x=(x * 1000 - 2) y=0 width=4 height=12 rx=2 fill="hex.danger"
                row padding-left="6.0rem"
                  for l, j in ["1w", "3d", "1d", "6h", "1h", "now"] key=l
                    text l font="-exact-caption2" color="-exact-tertiary-label" flex=(j == 5 ? 0 : 1) font-variant-numeric="tabular-nums"
            if kind == "task" and task.lately.length > 0
              Head(label="Lately", n=-1, pad="18px 10px 4px", id="head-lately")
              for l, i in task.lately.slice(0, 8) key=`${l.at}${i}`
                Happened(mark=l.state, text=l.text, stamp=whenOf(l.at, now, offset), failed=(l.state == "failed"))
            if pageDecided.length > 0
              Head(label="hex decided", n=-1, pad="18px 10px 4px", id="head-decided")
              for a in pageDecided key=a.id
                DecidedCard(ask=a, now=now, offset=offset, failed=match said.filter(s => s.id == a.id and s.status == "failed").at(-1) { case some(s) => failedWords(s), case none => "" }, undo=undo)
            if kind == "task" and siblings.length > 0
              Head(label="Other threads", n=siblings.length, pad="18px 10px 4px", id="head-threads")
              for t in siblings.slice(0, allPlaces ? siblings.length : 4) key=t.id
                button press=openTask(t.id) class=RowTap align-items="center" -exact-press-haptic=(haptics ? "selection" : "none") testId=`place-${t.id}`
                  PlaceTile(place=Place(app=t.app, place=t.place, task=t.id, call="", link=t.link), size=26)
                  column flex=1 min-width=0 gap=1
                    text (t.place != "" ? t.place : t.name) font="-exact-body" color="-exact-label" line-clamp=1
                    text `${appName(t.app)} · ${whenOf(t.at, now, offset)} · ${stateWord(t.state)}` font="-exact-footnote" color="-exact-secondary-label"
                  image "symbol:forward-chevron" width=13 height=13 object-fit="contain" color="-exact-tertiary-label" aria-hidden=true
              if siblings.length > 4
                ShowMore(n=(siblings.length - 4), shown=allPlaces, pad="2px 10px", id="more-places", press=morePlaces)
      if replyAsk.length > 0
        for a in replyAsk key=a.id
          ReplyComposer(ask=a, draft=askDraft(drafts, a), keep=keepDraft, dismissed=closeReply, note=note, answer=answer, attached=(attachedTo == `ask:${a.id}` ? attached : attached.slice(0, 0)), addError=(attachedTo == `ask:${a.id}` ? addError : ""), attach=attach, detach=detach, foot=foot, answered=(said.filter(s => s.id == a.id and s.verb != "note" and s.status != "failed").length > 0), end=max(16, room.clear.x + room.clear.width - room.footEnd))
      else if docked
        button press=open(`${path("thread", id)}#compose`) class=Tap position="absolute" left=16 right=max(16, room.clear.x + room.clear.width - room.footEnd) bottom=(foot + 8) display="flex" aria-label=`Message ${title}` testId="task-compose"
          row class=Composer flex=1 align-items="center" padding="0 16px"
              text (draftOf(drafts, `thread:${id}`) != "" ? draftOf(drafts, `thread:${id}`) : `Message ${title}`) font="-exact-body" color=(draftOf(drafts, `thread:${id}`) != "" ? "-exact-label" : "-exact-tertiary-label") line-clamp=1 flex=1 text-align="left"

// A section of the pinned post: its mark and title, its items with their own marks, links that
// open, code in a box. Done sections start folded to "Title · N".
component Pinned
  inject
    haptics: bool
  props
    section: PinSection
    first: bool
  state flipped = false
  derive folded = section.folded != flipped
  action fold
    flipped = not flipped
    if haptics
      haptic("selection")
  view
    column gap=0
      if section.folded
        button press=fold class=RowTap align-items="center" aria-expanded=(not folded) testId=`pin-fold-${section.title}`
          Mark(state=section.mark, size=22)
          text `${section.title} · ${section.lines.length}` flex=1 font="-exact-headline" color="-exact-secondary-label"
          image "symbol:icon.open" width=13 height=13 object-fit="contain" color="-exact-tertiary-label" rotate=(folded ? "-90deg" : "0deg")
      else
        Head(label=(section.title != "" ? section.title : first ? "Pinned" : ""), n=-1, pad="18px 10px 4px", id=`pin-${section.title}`)
      if not folded
        for l, i in section.lines key=`${i}`
          if l.kind == "code"
            text l.text font-family="ui-monospace" font="-exact-footnote" margin="4px 10px" padding="8px 10px" border-radius=10 background-color="-exact-tertiary-fill" white-space="pre-wrap" user-select="text"
          else if l.url != ""
            link href=l.url class=RowTap align-items="flex-start" padding="6px 10px"
              if l.kind == "item"
                Mark(state=l.mark, size=20)
              text inlineOf(l.text) font="-exact-body" color="-exact-label" flex=1
              image "symbol:sf/arrow.up.right" width=11 height=11 object-fit="contain" color="-exact-tertiary-label" margin-top=5
          else
            row gap=12 align-items="flex-start" padding="6px 10px"
              if l.kind == "item"
                Mark(state=l.mark, size=20)
              text inlineOf(l.text) font="-exact-body" color="-exact-label" flex=1 user-select="text"
