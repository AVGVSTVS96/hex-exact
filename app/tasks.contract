// Tasks (§9.1): everything hex is doing and everything that waits on Bassim, in tabs: All, Needs
// you, Working, Done, Quiet. Each topic is one row; search finds any question, thread or result by
// every word. On a phone it's a sheet over the call, so the call stays in reach.
use Viewport, Tasks, Asks, Counts from "./shapes.contract"
use Mark, Chip, whenOf from "./parts.contract"
use Said from "./said.contract"
use Item, Topic, entriesOf, stageTopics, topicsOf, wordsOf, matches, whyOf, pageOf, homeOf, picksOf, stageWord from "./inbox.contract"
use ProjectRow, TopicHead, EntryRow from "./rows.contract"

shape TabItem
  id: string
  label: string

fn emptyWords(tab: string): string = tab == "needs" ? "Nothing waits on you" : tab == "working" ? "Nothing is working" : tab == "done" ? "Nothing done in the last day" : tab == "quiet" ? "Nothing is quiet" : "Nothing from hex yet"

component TasksList
  props
    entry: Entry
    viewport: Viewport
    now: number
    offset: number
    tab: string
    pickTab: action
    tasks: Tasks
    asks: Asks
    counts: Counts
    said: Said[]
    loading: bool
    failed: bool
    inCall: bool
    open: action
    openTask: action
    answer: action
    answerMany: action
    dismiss: action
    undo: action
    again: action
    act: action
    markRead: action
    talk: action
    answering: string
    // Wide (the Duo opened like a book, a big window): the list on the left, a page beside it.
    split: bool
    beside: string
    select: action
    back: action
  slot
  state query = ""
  derive tabs = [TabItem(id="all", label="All"), TabItem(id="needs", label="Needs you"), TabItem(id="working", label="Working"), TabItem(id="done", label="Done"), TabItem(id="quiet", label="Quiet")]
  derive entries = entriesOf(tasks, asks, now)
  // An ask put away here leaves the counts at once, and its row folds where it was.
  derive away = said.filter(s => s.verb != "note" and s.status != "failed").map(s => s.id)
  derive waiting = entries.filter(e => not away.includes(e.id))
  derive countOf = [waiting.length, waiting.filter(e => e.stage == "needs").length, waiting.filter(e => e.stage == "working").length, waiting.filter(e => e.stage == "done").length, waiting.filter(e => e.stage == "quiet").length]
  derive words = wordsOf(query)
  derive searching = words.length > 0
  derive topics = searching ? topicsOf(entries.filter(e => matches(e, words))) : stageTopics(entries, tab)
  derive picks = picksOf(asks.asks, said)
  derive asking = asks.asks.filter(a => not away.includes(a.id)).length
  derive known = tasks.version > 0 or asks.version > 0
  derive needsTab = tab == "needs" and not searching
  derive book = viewport.horizontalViewportSegments == 2
  derive listWidth = book ? "env(viewport-segment-width 0 0)" : "25rem"
  action search(v: string)
    query = v
  action openPage(page: string)
    if split
      select(homeOf(page, tasks.tasks))
    else
      open(path("task", homeOf(page, tasks.tasks)))
  action goThrough
    haptic("selection")
    talk("asks")
  view
    column navigationKey=`${entry.id}` navigationPresentation=(viewport.width < 700 ? "modal" : "push") navigationDetent=(inCall ? "medium large" : "large") navigationInitialDetent="large" navigationScroll="tasks-list" position="absolute" inset=0 testId="tasks"
      header display="flex" flex-wrap="wrap" align-items="center" gap=8
        button id="back" press=back aria-label="Close" testId="tasks-close"
          image "symbol:close"
        text "Tasks" role="heading" aria-level=1 flex=1
        input type="search" value=query input=search placeholder="Tasks, topics, questions" aria-label="Search Tasks" testId="tasks-search" width="100%"
      row flex=1 min-height=0 align-items="stretch"
        list id="tasks-list" appearance="auto" listStyle="plain" flex=(split ? "none" : 1) width=(split ? listWidth : "auto") min-height=0
          section
            if not searching
              row role="tablist" aria-label="Stages" gap=6 padding="2px 16px 8px" overflow-x="auto" scrollbar-width="none"
                for t, i in tabs key=t.id
                  button press=pickTab(t.id) appearance="none" padding="6px 12px" border-radius=999 background-color=(tab == t.id ? "-exact-label" : "-exact-tertiary-fill") display="flex" flex-direction="row" gap=6 align-items="center" flex-shrink=0 role="tab" aria-selected=(tab == t.id) aria-label=`${t.label}, ${match countOf.at(i) { case some(n) => n, case none => 0 }}` -exact-press-haptic="selection" transition="background-color 160ms ease" testId=`tab-${t.id}`
                    text t.label font="-exact-subheadline" font-weight=600 color=(tab == t.id ? "-exact-background" : "-exact-label") white-space="nowrap"
                    if t.id != "all"
                      text (not known ? "–" : `${match countOf.at(i) { case some(n) => n, case none => 0 }}`) font="-exact-subheadline" font-weight=600 font-variant-numeric="tabular-nums" color=(t.id == "needs" ? "hex.accent" : tab == t.id ? "-exact-background" : "-exact-secondary-label") opacity=(tab == t.id and t.id != "needs" ? 0.7 : 1)
            if failed and known
              text "Last from hex · waiting for an update" font="-exact-caption1" color="-exact-tertiary-label" padding="4px 16px" testId="tasks-behind"
            if needsTab and picks.length > 1
              link href=path("picks") -exact-press-haptic="selection" testId="open-picks"
                Mark(state="pick", size=22)
                text `hex picked for ${picks.length} questions` flex=1 font="-exact-body"
                text "Take them" font="-exact-subheadline" color="hex.accent"
            for t, i in topics key=(tab == "done" or searching ? `${t.name}·${match t.entries.at(0) { case some(e) => e.id, case none => "" }}` : t.name)
              if not searching and tab == "all" and (i == 0 or match topics.at(i - 1) { case some(p) => match p.entries.at(0) { case some(e) => e.stage, case none => "" } != match t.entries.at(0) { case some(e) => e.stage, case none => "" }, case none => true })
                text stageWord(match t.entries.at(0) { case some(e) => e.stage, case none => "" }) font="-exact-footnote" font-weight=600 color="-exact-secondary-label" text-transform="uppercase" letter-spacing=0.4 padding=(i == 0 ? "4px 16px 2px" : "18px 16px 2px")
              if searching
                TopicHead(topic=t, href=path("task", homeOf(pageOf(t), tasks.tasks)), split=split, select=select(homeOf(pageOf(t), tasks.tasks)))
                for e in t.entries key=e.id
                  EntryRow(entry=e, asks=asks.asks, said=said, why=whyOf(e, words), now=now, offset=offset, answer=answer, dismiss=dismiss, undo=undo, again=again, act=act, markRead=markRead, openPage=openPage)
              else
                ProjectRow(topic=t, now=now, offset=offset, href=path("task", homeOf(pageOf(t), tasks.tasks)), split=split, selected=(split and beside == homeOf(pageOf(t), tasks.tasks)), select=select(homeOf(pageOf(t), tasks.tasks)))
            if needsTab and asks.check.at > 0
              link href=path("check") -exact-press-haptic="selection" testId="open-check"
                Mark(state="done", size=22)
                column flex=1 min-width=0 gap=2
                  text `Checked ${whenOf(asks.check.at, now, offset)}` font="-exact-body"
                  text [asks.check.fixed > 0 ? `fixed ${asks.check.fixed}` : "", asks.check.flagged > 0 ? `flagged ${asks.check.flagged}` : ""].filter(s => s != "").join(" · ") font="-exact-subheadline" color="-exact-secondary-label"
            if known and topics.length == 0
              text (searching ? "Nothing matches" : emptyWords(tab)) color="-exact-secondary-label" text-align="center" padding="48px 16px" testId="tasks-empty"
            if failed and not known
              text "Can't reach hex. Trying again…" color="-exact-secondary-label" text-align="center" padding="48px 16px" testId="tasks-offline"
            if loading and not known and not failed
              progress aria-label="Loading tasks" margin="48px auto"
            if needsTab and asking > 0
              box height=72
        if split
          column position="absolute" top=0 bottom=0 right=0 left=(book ? "env(viewport-segment-left 1 0)" : "25rem") border-left=(book ? "none" : "0.5px solid -exact-separator") testId="tasks-beside"
            if beside == ""
              text (known ? "Pick a project" : "") color="-exact-secondary-label" margin="auto"
            else
              children
      if needsTab and asking > 0
        button press=goThrough appearance="auto" buttonStyle="glass" position="absolute" left=16 right=16 bottom=(max(viewport.safeAreaBottom, 12) + 4) max-width="26rem" margin="0 auto" display="flex" flex-direction="row" gap=8 align-items="center" justify-content="center" padding="14px 20px" border-radius=999 testId="go-through"
          image "symbol:messages"
          text "Go through them with hex"
