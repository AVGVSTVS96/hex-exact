// A task's messages (§9.4): the thread as Bassim and hex wrote it, opening at the newest, and a
// composer that becomes Stop while hex is working and nothing is typed. What Bassim sends shows at
// once, dimmed until hex has it; one that didn't go says why, and a tap tries again.
use Viewport, Counts, TaskPage, Chat, Media, Place from "./shapes.contract"
use Mark, PlaceTile, Discuss, Note, appName, whenOf, lengthOf, Tap, PillTap, PillFace, Composer, ComposerField, Send, Prose from "./parts.contract"
use Room, Chrome from "./room.contract"
use PageHead from "./task.contract"
use Sending from "./said.contract"
use Album, AddMedia, Waiting from "./media.contract"

// One line of the transcript: a turn, a message hex holds (waiting), one on its way from here
// (sending), or a note at its top or foot (earlier, empty, working).
shape Line
  id: string
  kind: string
  source: string
  text: string
  media: Media[]
  status: string
  error: string
  key: string

fn eventLabel(text: string): string = text.startsWith("(") and text.indexOf(") ") > 1 ? text.slice(1, text.indexOf(") ")) : ""
fn eventWords(text: string): string = eventLabel(text) != "" ? text.slice(eventLabel(text).length + 3) : text
// What a turn of Bassim's says it was, as the stable app words it: a voice message is just his words,
// a Siri turn "Asked Siri" without hex's instruction to itself.
fn eventShown(label: string): string = label == "" or label.toLowerCase() == "voice message" ? "" : label.startsWith("asked Siri") ? "Asked Siri" : `${label.slice(0, 1).toUpperCase()}${label.slice(1)}`
fn draftOf(drafts: string[], key: string): string = match drafts.filter(l => l.startsWith(`${key}\t`)).at(0) { case some(l) => l.slice(key.length + 1), case none => "" }
// A refusal hex gave can't be fixed by trying again; a lost connection can.
fn retries(error: string): bool = error == "" or error.startsWith("Cannot reach hex")

component Thread
  inject
    haptics: bool
  props
    entry: Entry
    room: Room
    clearTop: number
    counts: Counts
    callOn: bool
    viewport: Viewport
    now: number
    offset: number
    task: TaskPage
    chat: Chat
    sends: Sending[]
    drafts: string[]
    loading: bool
    failed: bool
    sending: bool
    message: action
    resend: action
    stop: action
    keepDraft: action
    // Photos and videos waiting to go with the next message (root `attached` while it's this thread's).
    attached: Media[]
    // Why the last photo or video added here, or the last Stop, didn't go.
    addError: string
    stopError: string
    attach: action
    detach: action
    talk: action
    // Apps a link out didn't open in, and the open that hears it.
    missing: string[]
    openOut: action
    inCall: bool
    open: action
    openTasks: action
    back: action
  // With two columns, the task page this belongs to, on the left of the fold.
  slot
  state typed = ""
  state started = false
  derive key = `thread:${task.id}`
  derive draft = started ? typed : draftOf(drafts, key)
  derive title = task.place != "" ? task.place : task.name != "" ? task.name : "Messages"
  derive empty = draft.trim() == "" and attached.length == 0
  derive stopping = empty and task.running
  // Sent from here and not yet in the thread: hex echoes a send's key at the end of a waiting key.
  derive mine = sends.filter(s => s.task == task.id and chat.waiting.map(w => w.key).filter(k => k.endsWith(`:${s.key}`) or k == s.key).length == 0 and not (s.status == "sent" and chat.turns.slice(-6).filter(t => t.source == "me" and t.text == s.text and t.media.length == s.media.length).length > 0))
  derive subtitle = task.running ? `Working · started ${lengthOf((now - task.since) / 1000)} ago` : `${appName(task.app)}${task.at > 0 ? ` · ${whenOf(task.at, now, offset)}` : ""}`
  // The composer's foot: over the home indicator, or the call docked there, or just above the keyboard.
  derive two = room.columns == 2
  derive foot = viewport.keyboardHeight > 0 ? 8 : callOn ? room.foot + 64 + 12 : room.foot + 4
  derive noMedia = [Media(id="", kind="", aspect=0)].slice(0, 0)
  derive lines = (chat.total > chat.turns.length ? [Line(id="earlier", kind="earlier", source="", text="", media=noMedia, status="", error="", key="")] : []).concat(chat.turns.map(t => Line(id=`t${t.id}`, kind="turn", source=t.source, text=t.text, media=t.media, status="", error="", key=""))).concat(chat.waiting.map(w => Line(id=`w${w.key}`, kind="waiting", source="me", text=w.text, media=noMedia, status="", error="", key=w.key))).concat(mine.map(m => Line(id=`s${m.key}`, kind="sending", source="me", text=m.text, media=m.media, status=m.status, error=m.error, key=m.key))).concat(task.running ? [Line(id="working", kind="working", source="", text=task.line, media=noMedia, status="", error="", key="")] : [])
  action edit(v: string)
    typed = v
    started = true
    keepDraft(key, v)
  action add(source: string)
    attach(key, source)
  action submit
    if not empty
      message(task.id, draft.trim())
      typed = ""
      started = true
      if haptics
        haptic("selection")
    else if task.running
      stop(task.id)
      if haptics
        haptic("impact-medium")
  view
    column navigationKey=`${entry.id}` navigationBar="none" -exact-safe-area="none" navigationScroll="thread" interactive-widget="resizes-content" position="absolute" inset=0 background-color="-exact-background" testId="thread"
      Chrome(room=room, on="thread", needsYou=counts.yours, working=counts.working, open=open, openTasks=openTasks, back=back)
      if two
        column position="absolute" top=room.firstTop bottom=0 left=room.first.x width=room.first.width testId="thread-task"
          children
      column position="absolute" top=(two ? room.secondBelow : room.below) bottom=0 left=(two ? room.second.x : room.clear.x) width=(two ? room.second.width : room.clear.width)
        PageHead(room=room, clearTop=(two ? 0 : clearTop), pane=two, title=title, line=(missing.includes(task.app) ? `${appName(task.app)} isn’t on this iPhone` : subtitle), id="thread-head")
          if task.link != ""
            button press=openOut(task.link, task.app) class=PillTap -exact-press-haptic=(haptics ? "selection" : "none") aria-label=`Open in ${appName(task.app)}` testId="thread-door"
              box class=PillFace gap=8 padding="5px 12px 5px 6px"
                PlaceTile(place=Place(app=task.app, place=task.place, task=task.id, call="", link=task.link), size=22)
                text appName(task.app) font="-exact-subheadline" font-weight=600 color="-exact-label"
          Discuss(title=title, id="thread-talk", press=talk(task.id))
        if loading and chat.turns.length == 0
          Note(kind="loading", text="Loading messages", pad="24px 20px", id="thread-loading")
        if not loading and chat.turns.length == 0 and mine.length == 0
          Note(kind=(failed ? "failed" : "empty"), text=(failed ? "hex didn't answer, so these can't show yet." : "Nothing said here yet"), pad="48px 20px", id="thread-empty")
        list id="thread" appearance="none" virtualized=true scroll-start="end" scrollFollowEnd=true flex=1 min-height=0 padding-bottom=20 scroll-padding-bottom=20 mask-image=(chat.sends ? "linear-gradient(to top, transparent 0, #000 24px)" : "none")
          for l in lines key=l.id
            column padding="5px 16px" gap=4 align-items=(l.source == "me" ? "flex-end" : "stretch") testId=`line-${l.id}`
              if l.kind == "earlier"
                text `Earlier messages are in ${appName(task.app)}` font="-exact-footnote" color="-exact-tertiary-label" text-align="center" padding="8px 0"
              else if l.kind == "working"
                link href=path("steps", task.id) padding="6px 0" display="flex" flex-direction="row" gap=8 align-items="center" testId="thread-working"
                  Mark(state="working", size=16)
                  text l.text font="-exact-footnote" color="-exact-secondary-label" line-clamp=1 flex=1
                  text `${lengthOf((now - task.since) / 1000)} · Steps ›` font="-exact-footnote" color="-exact-tertiary-label" white-space="nowrap" font-variant-numeric="tabular-nums"
              else
                if l.source == "me" and eventShown(eventLabel(l.text)) != ""
                  text eventShown(eventLabel(l.text)) font="-exact-caption1" color="-exact-tertiary-label" padding="0 4px"
                if l.media.length > 0
                  Album(media=l.media, width=min(viewport.width * 0.6, 260))
                if l.text != "" and l.source == "me"
                  text eventWords(l.text) max-width="82%" padding="8px 14px" border-radius=18 background-color="-exact-tertiary-fill" color="-exact-label" opacity=(l.kind == "turn" ? 1 : l.kind == "waiting" ? 0.6 : 0.45) user-select="text" white-space="pre-wrap" overflow-wrap="break-word"
                else if l.text != ""
                  Prose(text=l.text, font="-exact-body", color="-exact-label")
                if l.kind == "sending" and l.status == "failed" and retries(l.error)
                  button press=resend(l.key) class=Tap testId=`resend-${l.key}`
                    text "Not sent · Tap to try again" font="-exact-caption1" color="hex.danger"
                else if l.kind == "sending" and l.status == "failed"
                  text l.error font="-exact-caption1" color="hex.danger" max-width="82%" text-align="right"
                else if l.kind == "sending"
                  text "Sending" font="-exact-caption1" color="-exact-tertiary-label"
        if chat.sends
          box padding="0 12px"
            Waiting(media=attached, error=addError, remove=detach)
            if stopError != ""
              text stopError font="-exact-footnote" color="hex.danger" padding="4px 4px 0" testId="thread-stop-error"
          row gap=8 align-items="flex-end" margin="6px 12px 0" margin-right=max(12, room.clear.x + room.clear.width - room.footEnd) margin-bottom=foot
            AddMedia(menu="thread-add", label="Add a photo or video", glass=false, size=40, disabled=(attached.length >= 4), add=add)
            row class=Composer flex=1 min-width=0
              textarea id="composer" class=ComposerField value=draft input=edit autofocus=(fragment(entry) == "compose") rows=1 field-sizing="content" max-height=140 placeholder=`Message ${title}` aria-label="Message" testId="composer"
              button press=submit disabled=(empty and not task.running) class=Send retainFocus=true aria-label=(stopping ? "Stop" : "Send") testId="send"
                image (stopping ? "symbol:stop-fill" : "symbol:send") width=16 height=16 object-fit="contain" color=(empty and not task.running ? "-exact-tertiary-label" : "-exact-background")
