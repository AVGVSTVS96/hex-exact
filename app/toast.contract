// The update toast (§11): a new build of hex Exact is out. Install hands it to hangar, which
// installs it and opens the new build (ending the call first); without hangar, the install link
// installs it. "Not now" hides it until the build after. It sits in Home's free chrome row, beside
// the capsule and on hex's side, never over hex or a control; it waits there while a page is open.
use Build from "./shapes.contract"
use Tap from "./parts.contract"
use Room, capsuleX from "./room.contract"

component UpdateToast
  inject
    haptics: bool
  props
    build: Build
    skipped: number
    visible: bool
    live: bool
    place: string
    room: Room
    skip: action
    end: action
  // ready | installing | failed. The root rebuilds the toast when the app comes back to the front,
  // so an install that didn't happen is offered again.
  state step = "ready"
  // Where the open went: hangar first, then the install link.
  state via = ""
  derive shown = build.running > 0 and build.latest > build.running and build.latest != skipped and build.install != ""
  // The free stretch of the chrome row: from its start to the capsule, and with two columns no
  // further than hex's.
  derive spanEnd = min(capsuleX(room), room.columns == 2 ? room.first.x + room.first.width : capsuleX(room)) - 10
  action install
    if step != "installing"
      step = "installing"
      if haptics
        haptic("impact-medium")
      if live
        end()
      via = "hangar"
      openURL("hangar://update/com.shahidy.hexexact", "update-install")
  action heard(how: string)
    if how == "failed" and via == "hangar"
      via = "link"
      openURL(build.install, "update-install")
    else if how == "failed"
      step = "failed"
  view
    if shown and place == "home"
      row position="absolute" top=room.bar.top left=room.bar.start width=(spanEnd - room.bar.start) height=44 justify-content="flex-start" z-index=3 pointer-events="none" testId="update-toast"
        row pointer-events="auto" backgroundMaterial="glass" border-radius=22 height=44 max-width="100%" align-items="center"
          button id="update-install" press=install change=heard class=Tap height=44 min-width=0 padding=(step == "installing" ? "0 14px" : "0 4px 0 14px") display="flex" flex-direction="row" align-items="center" gap=8 aria-label=(step == "installing" ? `Installing build ${build.latest}; hex Exact closes and opens again in it` : `${live ? "End the call and install" : "Install"} the new hex Exact, build ${build.latest}`) testId="update-install"
            if step == "installing"
              progress width=16 height=16 aria-label="Installing"
              text "Installing" font="-exact-subheadline" font-weight=600 color="-exact-label" white-space="nowrap"
            else
              text (step == "failed" ? "Didn't start" : "Update ready") font="-exact-subheadline" color="-exact-label" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
              text (step == "failed" ? "Try again" : live ? "End & install" : "Install") font="-exact-subheadline" font-weight=600 color="AccentColor" white-space="nowrap"
          if step != "installing"
            button press=skip(build.latest) class=Tap width=36 height=44 flex-shrink=0 display="flex" align-items="center" justify-content="center" aria-label="Not now" testId="update-dismiss"
              image "symbol:close" width=11 height=11 object-fit="contain" color="-exact-secondary-label" aria-hidden=true
