// Voice (§10, second page): which of hex's voices answers (swipe to hear each), its personality and
// pace, and Bassim's own words on how it should talk. Kept on hex, so every call hears them, phone
// calls too. The voice can't change mid-call.
use Settings, Counts from "./shapes.contract"
use Option, Tap from "./parts.contract"
use Pager, Setting from "./settings.contract"
use Room, Chrome from "./room.contract"
use PageTitle from "./calls.contract"

// The Live API's voices, Marin first, each with its accent where it has one.
fn voices(): Option[] = [Option(id="marin", label="Marin", detail=""), Option(id="alloy", label="Alloy", detail=""), Option(id="ash", label="Ash", detail=""), Option(id="ballad", label="Ballad", detail=""), Option(id="beacon", label="Beacon", detail="Filipino English"), Option(id="bossa", label="Bossa", detail="Brazilian Portuguese"), Option(id="cedar", label="Cedar", detail=""), Option(id="cinder", label="Cinder", detail="Southern U.S. English"), Option(id="coral", label="Coral", detail=""), Option(id="delta", label="Delta", detail="Southern U.S. English"), Option(id="echo", label="Echo", detail=""), Option(id="gleam", label="Gleam", detail="North American English"), Option(id="meridian", label="Meridian", detail="North American English"), Option(id="quartz", label="Quartz", detail="Australian English"), Option(id="ripple", label="Ripple", detail="Australian English"), Option(id="sage", label="Sage", detail=""), Option(id="shimmer", label="Shimmer", detail=""), Option(id="stone", label="Stone", detail="Irish English"), Option(id="tempo", label="Tempo", detail="Brazilian Portuguese"), Option(id="verse", label="Verse", detail=""), Option(id="vesper", label="Vesper", detail="British English"), Option(id="willow", label="Willow", detail="Irish English")].map(v => Option(v, detail=(v.detail == "" ? "Swipe to hear each voice" : v.detail)))

component VoicePage
  inject
    haptics: bool
  props
    entry: Entry
    room: Room
    settings: Settings
    counts: Counts
    voice: string
    inCall: bool
    docked: bool
    loading: bool
    failed: bool
    unsaved: bool
    // Plays a voice's sample (the shell's, so the silent switch doesn't hush it).
    preview: action
    set: action
    open: action
    openTasks: action
    back: action
  derive two = room.columns == 2
  derive rowsLeft = two ? room.second.x : room.clear.x
  derive rowsWidth = two ? room.second.width : room.clear.width
  derive pagerWidth = min((two ? room.first.width : room.clear.width) - 40, 420)
  derive chosen = voice
  derive locked = inCall or (loading and settings.voice == "")
  derive note = inCall ? "End the call to change voices." : "Loading your voice…"
  // What Bassim just picked shows at once; hex's answer follows.
  state pickedPace = ""
  state pickedPersonality = ""
  derive personality = pickedPersonality != "" ? pickedPersonality : settings.personality != "" ? settings.personality : "default"
  derive pace = pickedPace != "" ? pickedPace : settings.pace != "" ? settings.pace : "normal"
  action choose(id: string)
    if haptics
      haptic("selection")
    set("voice", id)
    preview(id)
  action hear(id: string)
    if id == chosen
      preview(id)
    else
      choose(id)
  action pickPace(p: string)
    if haptics
      haptic("selection")
    pickedPace = p
    set("pace", p)
  action pickPersonality(p: string)
    if haptics
      haptic("selection")
    pickedPersonality = p
    set("personality", p)
  view
    column navigationKey=`${entry.id}` navigationBar="none" -exact-safe-area="none" position="absolute" inset=0 background-color="-exact-background" testId="voice"
      Chrome(room=room, on="settings", needsYou=counts.yours, working=counts.working, open=open, openTasks=openTasks, back=back)
      if two
        column position="absolute" top=room.below bottom=0 left=room.first.x width=room.first.width testId="voice-pane"
          PageTitle(text="Voice", room=room, left=20, id="voice-title")
          column flex=1 align-items="center" justify-content="center" gap=18 padding-bottom=(room.foot + 24)
            image "symbol:waveform" width=56 height=56 object-fit="contain" color="-exact-label" aria-hidden=true
            Pager(options=voices(), value=chosen, pick=choose, replay=hear, width=pagerWidth, locked=locked, note=note, label="Voice", testKey="voice")
      scroll id="voice" position="absolute" top=(two ? room.secondBelow : room.below) bottom=0 left=rowsLeft width=rowsWidth padding-bottom=(room.foot + (docked ? 88 : 24)) box-sizing="border-box" mask-image="linear-gradient(to bottom, transparent 0, #000 12px, #000 100%)" testId="voice-scroll"
        if not two
          PageTitle(text="Voice", room=room, left=20, id="voice-title")
          column align-items="center" gap=12 padding="20px 0 12px" testId="voice-carousel"
            image "symbol:waveform" width=34 height=34 object-fit="contain" color="-exact-label" aria-hidden=true
            Pager(options=voices(), value=chosen, pick=choose, replay=hear, width=pagerWidth, locked=locked, note=note, label="Voice", testKey="voice")
        column padding="8px 20px 0"
          Setting(icon="symbol:sf/person.wave.2", title="Personality", line="How hex comes across", stack=false, last=false, id="setting-personality")
            select value=personality change=pickPersonality disabled=(settings.personalities.length == 0) aria-label="How hex comes across on calls" testId="personality"
              for p in settings.personalities key=p.id
                option value=p.id
                  text p.label
          Setting(icon="symbol:sf/speedometer", title="Pace", line="How fast hex talks", stack=(rowsWidth < 460), last=false, id="setting-pace")
            row role="radiogroup" aria-label="How fast hex talks on calls" width=224 flex-shrink=0 testId="pace"
              for p in settings.paces key=p.id
                button role="radio" aria-checked=(pace == p.id) press=pickPace(p.id) flex=1 min-height=36 testId=`pace-${p.id}`
                  text p.label
          link href=path("words") class=Tap display="flex" flex-direction="row" gap=14 align-items="center" min-height=64 padding="10px 0" aria-label=(settings.words == "" ? "Your words: tell hex how to talk" : `Your words: ${settings.words}`) testId="open-words"
            image "symbol:sf/text.quote" width=22 height=22 object-fit="contain" color="-exact-secondary-label" flex-shrink=0 aria-hidden=true
            column flex=1 min-width=0 gap=2
              text "Your words" font="-exact-body" color="-exact-label"
              text (settings.words == "" ? "Tell hex how to talk, in your own words" : settings.words) font="-exact-subheadline" color="-exact-secondary-label" line-clamp=2
            image "symbol:sf/chevron.right" width=12 height=12 object-fit="contain" color="-exact-tertiary-label" flex-shrink=0 aria-hidden=true
          text (failed ? "Can't reach hex right now." : unsaved ? "hex didn't save that. Try again." : "For every call, phone calls too.") font="-exact-footnote" color=(failed or unsaved ? "hex.danger" : "-exact-secondary-label") padding="12px 0" testId="voice-note"
