// Your words (§10): a short note on how hex should talk, for every call. Saved with Done, and when
// the field lets go. A page like Voice, not a sheet: a sheet grows under the Duo's status icons
// when the keyboard is up, and its Done went under the battery.
use Counts from "./shapes.contract"
use Room, Chrome from "./room.contract"
use PageTitle from "./calls.contract"

component YourWords
  props
    entry: Entry
    room: Room
    counts: Counts
    words: string
    set: action
    open: action
    openTasks: action
    back: action
  state draft = ""
  state touched = false
  action edit(v: string)
    draft = v
    touched = true
  action save(value: string)
    if value.trim() != words
      set("words", value.trim())
  action done
    if touched
      save(draft)
    back()
  view
    column navigationKey=`${entry.id}` navigationBar="none" -exact-safe-area="none" interactive-widget="resizes-content" position="absolute" inset=0 background-color="-exact-background" testId="words"
      Chrome(room=room, on="settings", needsYou=counts.yours, working=counts.working, open=open, openTasks=openTasks, back=done)
      scroll position="absolute" top=(room.columns == 2 ? room.secondBelow : room.below) bottom=0 left=(room.columns == 2 ? room.second.x : room.clear.x) width=(room.columns == 2 ? room.second.width : room.clear.width) padding-bottom=(room.foot + 24) box-sizing="border-box"
        column min-height=(room.columns == 2 ? 0 : max(0, room.headBottom - room.below))
          PageTitle(text="Your words", room=room, left=20, id="words-title")
        text "How hex talks to you, on every call. Back keeps it." font="-exact-subheadline" color="-exact-secondary-label" padding="2px 20px 0"
        textarea value=(touched ? draft : words) input=edit change=save maxlength=600 placeholder="Short answers, no recaps. Talk like a friend." border="none" margin="12px 20px 0" width="calc(100% - 40px)" box-sizing="border-box" min-height=160 padding="12px 14px" border-radius=16 background-color="-exact-tertiary-fill" font="-exact-body" aria-label="Your words" testId="words-field"
