#!/usr/bin/env bash
# Runs on the Mac, from a copy of the repository at ~/Developer/hex-exact: builds the Exact screen
# as an embed (its static library, plan and assets), then the Swift shell around it, unsigned.
# Prints the built app's path. scripts/ship signs it and puts it on the install link; SIM=1 builds
# for the simulator instead (scripts/sim).
#   HEX_URL=… HEX_TOKEN=… EXACT_CHANNEL=<update origin> [SIM=1] scripts/build
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
. "$here/scripts/mac-env"
exact=${EXACT:-$HOME/Developer/exact}
# Xcode's output stays outside the repository, where Exact's deploy would read its package
# checkouts as submodules.
out=$HOME/Developer/hex-exact-build${SIM:+/sim}
mkdir -p "$out"
if [ -n "${SIM:-}" ]; then
  device=() sdk=iphonesimulator destination='generic/platform=iOS Simulator' trust=development products=Release-iphonesimulator
else
  device=(--device --unsigned) sdk=iphoneos destination=generic/platform=iOS trust=production products=Release-iphoneos
fi

cd "$here/app"
"$here/scripts/mac-app-json" app.json "$EXACT_CHANNEL"
# A build belongs to the update stream whose publisher receipt EXACT_UPDATE_RECEIPT names; without
# one it starts a new stream.
[ -n "${EXACT_UPDATE_RECEIPT:-}" ] || export EXACT_UPDATE_GENESIS=1
built=$(bun exact.mjs ios "${device[@]}" --embed --json 2>"$out/embed.log" | tail -1)
embed=$(jq -r .path <<<"$built")
[ -d "$embed" ] || { tail -20 "$out/embed.log" >&2; exit 1; }

cd "$here/shell"
bun "$here/scripts/module-glue.mjs" "$exact" build/modules
export EXACT_PACKAGE=$exact/host/apple EXACT_LIB_DIR=$embed EXACT_LIB=app_apple \
  EXACT_APP_COMPOSITION=updating EXACT_APPLE_LINK=none EXACT_UPDATE_TRUST=$trust
xcodegen generate --quiet
xcodebuild -project HexExact.xcodeproj -scheme HexExact -configuration Release \
  -sdk $sdk -destination "$destination" -derivedDataPath "$out" CODE_SIGNING_ALLOWED=NO ARCHS=arm64 \
  HEX_URL="$HEX_URL" HEX_TOKEN="$HEX_TOKEN" EXACT_LIB_DIR="$embed" EXACT_LIB=app_apple \
  build >"$out/build.log" 2>&1 || { rg -N 'error:' "$out/build.log" | sort -u | head -30 >&2; exit 1; }
echo "$out/Build/Products/$products/HexExact.app"
