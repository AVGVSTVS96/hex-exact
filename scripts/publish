#!/usr/bin/env bash
# Runs on the server: sends main's screen (the Exact plan and assets) to every installed hex Exact
# over the air, through Exact's own deploy. The Mac bakes and signs the update with the stream's
# key (~/.config/exact/keys/hexexact.pem there); the origin is the tailnet folder the app checks
# every minute while it's open. A change to app.ts or the shell needs scripts/ship instead.
#   scripts/publish
set -euo pipefail
# One Mac build or simulator run at a time: builders share its one folder and simulator.
mkdir -p ~/.local/share/hex-exact && exec 9>~/.local/share/hex-exact/mac.lock && flock 9
here=$(cd "$(dirname "$0")/.." && pwd)
mac=${HEX_EXACT_MAC:-mac}
link=${HEX_EXACT_LINK:-$HOME/.local/share/hex-exact/link}
url=${HEX_EXACT_URL:-https://$(tailscale status --json | jq -r '.Self.DNSName | rtrimstr(".")')/hex-exact}
"$here/scripts/hex-env" >/dev/null
rsync -a --exclude '/app/target' --exclude '/app/.exact' "$here/" "$mac:Developer/hex-exact/"
rsync -a "$link/updates/" "$mac:Developer/hex-exact-origin/"
ssh "$mac" ". Developer/hex-exact/scripts/mac-env && cd Developer/hex-exact/app && ../scripts/mac-app-json app.json '$url/updates' &&
  cd ~/Developer/exact && EXACT_APP_DIR=\$HOME/Developer/hex-exact/app bun scripts/deploy.mjs app --origin ~/Developer/hex-exact-origin --platform ios --dirty --yes" </dev/null 2>&1 |
  rg -v 'Compiling|Checking|UNCOMMITTED'
rsync -a "$mac:Developer/hex-exact-origin/" "$link/updates/"
