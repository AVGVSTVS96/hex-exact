#!/usr/bin/env bash
# Runs on the server: builds hex Exact for the simulator on the Mac, unless the last build was of
# the same app (BUILT=1 takes the last build as it is), installs it on one of its own iPhone Duo
# simulators ("hexexact Duo 1" and "2", whichever is free), and in each pose and
# appearance screenshots each screen and plays each flow.
#   scripts/sim [path|flow…]                   (default: / /calls /tasks /settings)
#   POSES="cover-up open-up" APPEARANCES="dark light" scripts/sim /tasks scripts/flows/answer.flow
# A path (`/`, `/tasks`, `/tasks/t/<id>`) is a fresh launch at that screen (hexexact://go/<path>),
# shot as <path>-<pose>-<appearance>.png; `call:<path>` starts the demo call first and shoots it
# DEMO_WAIT seconds in (12 unless set). A flow is a file of taps, swipes, types, folds and shots
# (scripts/uitests/Flows.swift lists its commands) that XCUITest plays: each `shoot <step>` lands in
# <flow>/<n>-<step>-<pose>-<appearance>.png, with what failed in <flow>/notes.txt, the
# accessibility tree at its end in <flow>/tree-<pose>-<appearance>.txt (testIds are its
# `identifier:`), and what it sent hex in <flow>/writes-<pose>-<appearance>.txt.
# The simulator's app talks to scripts/standin.mjs: reads reach hex, writes never do.
# Poses: cover-up (folded), cover-side, open-up (a book), open-side (a laptop); all four by default.
# Shots land in $SHOTS (~/hex/scratch/hex-exact/shots/<commit>/).
set -euo pipefail
# One simulator build at a time, in the Mac's one folder for them; each run then takes its own
# copy of the app and a free simulator, so the next build goes on while it plays. scripts/ship
# has a folder and a lock of its own, so a ship never waits on pictures.
locks=~/.local/share/hex-exact
mkdir -p "$locks" && exec 9>"$locks/sim-build.lock" && flock 9
here=$(cd "$(dirname "$0")/.." && pwd)
mac=${HEX_EXACT_MAC:-mac}
folder=Developer/hex-exact-sim
url=${HEX_EXACT_URL:-https://$(tailscale status --json | jq -r '.Self.DNSName | rtrimstr(".")')/hex-exact}
commit=$(git -C "$here" rev-parse --short HEAD)
shots=${SHOTS:-$HOME/hex/scratch/hex-exact/shots/$commit}
POSES=${POSES:-cover-up cover-side open-up open-side}
APPEARANCES=${APPEARANCES:-dark}
standin=http://127.0.0.1:47391
run=Developer/hex-exact-sim-build/runs/$(hostname -s)-$$
paths=() flows=()
for arg in "${@:-/ /calls /tasks /settings}"; do
  for one in $arg; do
    if [ -f "$one" ]; then flows+=("$(basename "$one" .flow)" "$(cat "$one")"); else paths+=("$one"); fi
  done
done
mkdir -p "$shots"

eval "$("$here/scripts/hex-env" | sed 's/^/export /')"
# The simulator's build reaches hex only through the stand-in.
sed -i "s|^export const HEX_URL = .*|export const HEX_URL = \"$standin\";|" "$here/app/hex.ts"
ssh -o ConnectTimeout=15 -o BatchMode=yes "$mac" true </dev/null || { echo "the Mac didn't answer" >&2; exit 1; }
# Its own simulators, so other apps' checks keep theirs.
simulator() {
  ssh "$mac" bash -s -- "$(printf %q "$1")" <<'MAC'
export DEVELOPER_DIR=/Applications/Xcode-beta.app/Contents/Developer
id=$(xcrun simctl list devices -j | /opt/homebrew/bin/jq -r --arg name "$1" '[.devices[][] | select(.name == $name)][0].udid // empty')
if [ -z "$id" ]; then
  runtime=$(xcrun simctl list runtimes -j | /opt/homebrew/bin/jq -r '[.runtimes[] | select(.name == "iOS 27.1")][0].identifier')
  id=$(xcrun simctl create "$1" "iPhone Duo" "$runtime")
fi
echo "$id"
MAC
}
# What the app is built from: a run that changes only flows, scripts or docs reuses the last build.
tree=$(cd "$here" && { git ls-files -co --exclude-standard app shell; echo app/hex.ts; } | sort -u | xargs sha1sum | sha1sum | cut -c1-40)
built=$(ssh "$mac" cat $folder-build/sim/tree 2>/dev/null </dev/null || true)
if [ -z "${BUILT:-}" ] && [ "$tree" != "$built" ]; then
  # The folder starts as a clone of the first one (Rust's target, which names its own path, left out).
  ssh "$mac" "[ -d $folder ] || { cp -cR Developer/hex-exact $folder && rm -rf $folder/app/target; }" </dev/null
  # The Mac's copy is exactly this tree (--delete), so another builder's files there don't join this build.
  rsync -a --delete --exclude .git --exclude /app/target --exclude /app/.exact --exclude /app/node_modules --exclude /shell/build --exclude /shell/HexExact.xcodeproj --exclude /scripts/uitests/Flows.xcodeproj "$here/" "$mac:$folder/"
  echo "building for the simulator on the Mac"
  ssh "$mac" "rm -f $folder-build/sim/tree && SIM=1 EXACT_SIM=$(simulator "hexexact Duo 1") HEX_URL='$standin' HEX_TOKEN='$HEX_TOKEN' EXACT_CHANNEL='$url/updates' $folder/scripts/build && echo $tree >$folder-build/sim/tree" </dev/null | tail -1
fi
# This run's own copy of the app and of the scripts that play it (APFS clones, so instant).
ssh "$mac" "rm -rf $run && mkdir -p $run && cp -cR $folder-build/sim/Build/Products/Release-iphonesimulator/HexExact.app $run/" </dev/null
rsync -a --exclude Flows.xcodeproj "$here/scripts/" "$mac:$run/scripts/"
flock -u 9
# The first free simulator; each has its own lock, stand-in port and folders on the Mac.
lane=
until [ -n "$lane" ]; do
  for n in 1 2; do
    exec 8>"$locks/sim-$n.lock"
    if flock -n 8; then lane=$n && break; fi
  done
  [ -n "$lane" ] || sleep 3
done
sim=$(simulator "hexexact Duo $lane")

# ssh joins its arguments into one command line, so each is quoted for the Mac's shell.
ssh "$mac" bash -s -- "$(printf "%q " "$run" "$lane" "$sim" "$POSES" "$APPEARANCES" "$HEX_URL" "$HEX_TOKEN" "${#paths[@]}" "${paths[@]}" "${flows[@]}")" <<'MAC'
set -euo pipefail
run=~/$1 lane=$2 id=$3 poses=$4 appearances=$5 hex_url=$6 hex_token=$7 npaths=$8
shift 8
paths=("${@:1:npaths}")
shift "$npaths"
flows=("$@")
. $run/scripts/mac-env
# The Duo simulator runs iOS 27.1, which Xcode-beta carries. Its boot takes a turn (the Mac's
# ~/.local/share/turn), so it may wait for room.
export DEVELOPER_DIR=/Applications/Xcode-beta.app/Contents/Developer PATH=/opt/homebrew/bin:$PATH
xcrun simctl boot "$id" 2>/dev/null || true
xcrun simctl bootstatus "$id" -b >/dev/null
app=$run/HexExact.app out=$run/shots tests=$HOME/Developer/hex-exact-sim-build/flows-$lane
rm -rf "$out" && mkdir -p "$out"
# The stand-in is plain http on this Mac, which App Transport Security lets through as local
# (PlistBuddy makes no dictionary on the way to a key, so the dictionary first). Without it the
# app shows "Can't reach hex" and every picture is of an empty app, so the run stops instead.
/usr/libexec/PlistBuddy -c 'Add :NSAppTransportSecurity dict' "$app/Info.plist" 2>/dev/null || true
/usr/libexec/PlistBuddy -c 'Add :NSAppTransportSecurity:NSAllowsLocalNetworking bool true' "$app/Info.plist" 2>/dev/null || true
[ "$(/usr/libexec/PlistBuddy -c 'Print :NSAppTransportSecurity:NSAllowsLocalNetworking' "$app/Info.plist")" = true ] ||
  { echo "the simulator's app can't reach the stand-in (no NSAllowsLocalNetworking), so no pictures" >&2; exit 1; }
# Both simulators' builds reach the one stand-in, kept running between runs and started afresh
# when its script changes. Writes from both land in one list, so a flow's list can hold the
# other simulator's when both play at once.
writes=$HOME/Developer/hex-exact-sim-build/writes.txt
kept=$HOME/Developer/hex-exact-sim-build/standin.mjs
if ! cmp -s "$kept" $run/scripts/standin.mjs || ! lsof -ti tcp:47391 -sTCP:LISTEN >/dev/null; then
  lsof -ti tcp:47391 -sTCP:LISTEN | xargs kill 2>/dev/null || true
  cp $run/scripts/standin.mjs "$kept"
  HEX_URL=$hex_url HEX_TOKEN=$hex_token PORT=47391 WRITES=$writes nohup node "$kept" >/dev/null 2>&1 &
  sleep 1
fi
curl -sf -m 10 -o /dev/null http://127.0.0.1:47391/asks ||
  { echo "the stand-in doesn't reach hex (http://127.0.0.1:47391/asks on the Mac), so no pictures" >&2; exit 1; }
trap 'xcrun simctl terminate "$id" com.shahidy.hexexact 2>/dev/null || true' EXIT
xcrun simctl status_bar "$id" override --time 9:41 --batteryLevel 100 --cellularBars 4 2>/dev/null || true
hub=~/Developer/hex-exact-sim-build/devicehub-sim
[ "$hub" -nt $run/scripts/devicehub.c ] || {
  xcrun -sdk iphonesimulator clang -arch arm64 -mios-simulator-version-min=27.0 -O2 -o "$hub" \
    $run/scripts/devicehub.c -framework IOKit -framework CoreFoundation
  codesign -f -s - "$hub" 2>/dev/null
}
hubdo() { xcrun simctl spawn "$id" "$hub" "$@" </dev/null; }
xcrun simctl terminate "$id" com.shahidy.hexexact 2>/dev/null || true
xcrun simctl install "$id" "$app"
if [ ${#flows[@]} -gt 0 ]; then
  (cd $run/scripts/uitests && xcodegen generate -q)
  xcodebuild build-for-testing -project $run/scripts/uitests/Flows.xcodeproj -scheme Flows \
    -destination "id=$id" -derivedDataPath "$tests" -quiet >"$tests.log" 2>&1 || {
    grep -E 'error:' "$tests.log" | sort -u >&2
    echo "the flows' UI tests didn't build" >&2
    exit 1
  }
fi

# A pose is <fold>-<up|side>: the hinge moves only when the fold changes, and a turn is sent twice,
# as the simulator can miss the first. `display` is the screen it lights, for screenshots.
hinge_at=
place() {
  case ${1%-*} in cover) hinge=0 display=1 ;; open) hinge=180 display=3 ;; *) hinge=${1%-*} display=3 ;; esac
  case ${1##*-} in up) orientation=portrait ;; side) orientation=landscape-right ;; esac
  if [ "$hinge" != "$hinge_at" ]; then
    hubdo hinge "$hinge" "${hinge_at:-$([ "$hinge" -gt 90 ] && echo 0 || echo 180)}"
    sleep 3
    hinge_at=$hinge
  fi
  hubdo orientation "$orientation"; sleep 1; hubdo orientation "$orientation"
}

# Plays one flow: each line XCUITest prints as it goes is acted on here, a shot or a pose, then
# answered through a file the test waits for.
play() {
  local name=$1 script=$2 pose=$3 appearance=$4 dir=$out/$1 step=0 answered=0 line shot at=$3 where
  mkdir -p "$dir"
  rm -rf "$tests/sync" "$tests/result.xcresult" "$tests/attachments" && mkdir -p "$tests/sync"
  local from=$(($( { wc -c <"$writes"; } 2>/dev/null || echo 0) + 1))
  # The loop reads from a process substitution, not a pipe, so the poses it moves to stay known here.
  while IFS= read -r line; do
    case $line in
      *"flow-shoot "* | *"flow-snap "*)
        step=$((step + 1)) shot=${line##*flow-s?o?? }
        # Each pose plays the flow, so a step it folded to names the pose it started from too.
        where=$at && [ "$at" = "$pose" ] || where=$at-from-$pose
        xcrun simctl io "$id" screenshot --display=$display "$dir/$(printf %02d $step)-$shot-$where-$appearance.png" >/dev/null 2>&1
        case $line in *flow-shoot*) touch "$tests/sync/$((answered += 1))" ;; esac
        ;;
      *"flow-pose "*)
        at=${line##*flow-pose }
        place "$at"
        touch "$tests/sync/$((answered += 1))"
        ;;
      *"flow-note "*) echo "$pose $appearance: ${line##*flow-note }" >>"$dir/notes.txt" ;;
      *error:* | *XCTAssert* | *" failed "*) echo "$pose $appearance: $line" >>"$dir/notes.txt" ;;
    esac
  done < <(TEST_RUNNER_FLOW=$script TEST_RUNNER_FLOW_SYNC=$tests/sync xcodebuild test-without-building \
    -project $run/scripts/uitests/Flows.xcodeproj -scheme Flows -destination "id=$id" \
    -derivedDataPath "$tests" -resultBundlePath "$tests/result.xcresult" -collect-test-diagnostics never 2>&1 |
    tee "$tests-$name-$pose-$appearance.log")
  tail -c +"$from" "$writes" >"$dir/writes-$pose-$appearance.txt" 2>/dev/null || true
  [ -d "$tests/result.xcresult" ] || return 0
  xcrun xcresulttool export attachments --path "$tests/result.xcresult" --output-path "$tests/attachments" >/dev/null 2>&1 || return 0
  jq -r '.[].attachments[] | select(.suggestedHumanReadableName | startswith("tree")) |
    "\(.exportedFileName) \(.suggestedHumanReadableName | sub("_[0-9]+_[0-9A-F-]+.*$"; ""))"' \
    "$tests/attachments/manifest.json" | while read -r exported tree; do
    cp "$tests/attachments/$exported" "$dir/$tree-$pose-$appearance.txt"
  done
}

for pose in $poses; do
  for appearance in $appearances; do
    place "$pose"
    xcrun simctl ui "$id" appearance "$appearance"
    for path in "${paths[@]}"; do
      # Each screen is a fresh launch handed its link, as `simctl openurl` stops at iOS's
      # "Open in" prompt.
      case $path in
        # The demo call, then the screen: its live state shot a few lines in.
        call:*) link="hexexact://demo${path#call:}" wait=${DEMO_WAIT:-12} ;;
        *) link="hexexact://go$path" wait=3 ;;
      esac
      xcrun simctl launch --terminate-running-process "$id" com.shahidy.hexexact -HexOpen "$link" >/dev/null
      sleep $((wait + 4))
      name=$(echo "${path#/}" | tr '/:?=&' '_____'); name=${name:-home}
      xcrun simctl io "$id" screenshot --display=$display "$out/$name-$pose-$appearance.png" >/dev/null 2>&1
      # A path with report=pose leaves the shell's pose beside its shot.
      case $path in *report=pose*) xcrun simctl spawn "$id" defaults read com.shahidy.hexexact HexPose >"$out/pose-$pose.json" 2>/dev/null || true ;; esac
    done
    for ((i = 0; i < ${#flows[@]}; i += 2)); do
      play "${flows[i]}" "${flows[i + 1]}" "$pose" "$appearance"
      # A flow that folded the Duo leaves it where the next one expects it.
      place "$pose"
    done
  done
done
MAC
rsync -a "$mac:$run/shots/" "$shots/" && ssh "$mac" rm -rf "$run" </dev/null
ls "$shots"
