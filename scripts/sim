#!/usr/bin/env bash
# Runs on the server: builds hex Exact for the simulator on the Mac (BUILT=1 reuses the last build),
# installs it on its own iPhone Duo simulator ("hexexact Duo"), and screenshots each screen in each
# pose and appearance. A screen is a path (`/`, `/tasks`, `/tasks/t/<id>`), opened through
# hexexact://go/<path>; `call:<path>` starts the demo call first (none yet: the shell needs a mic).
#   scripts/sim [path…]                        (default: / /calls /tasks /settings)
#   POSES="cover-up open-up open-side cover-side" APPEARANCES="dark light" scripts/sim /tasks
# Shots land in $SHOTS (~/hex/scratch/hex-exact/shots/<commit>/), named <path>-<pose>-<appearance>.png.
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
mac=${HEX_EXACT_MAC:-mac}
folder=Developer/hex-exact
url=${HEX_EXACT_URL:-https://$(tailscale status --json | jq -r '.Self.DNSName | rtrimstr(".")')/hex-exact}
commit=$(git -C "$here" rev-parse --short HEAD)
shots=${SHOTS:-$HOME/hex/scratch/hex-exact/shots/$commit}
POSES=${POSES:-cover-up open-up open-side}
APPEARANCES=${APPEARANCES:-dark}
paths=("$@")
[ ${#paths[@]} -gt 0 ] || paths=(/ /calls /tasks /settings)
mkdir -p "$shots"

eval "$("$here/scripts/hex-env" | sed 's/^/export /')"
ssh -o ConnectTimeout=15 -o BatchMode=yes "$mac" true </dev/null || { echo "the Mac didn't answer" >&2; exit 1; }
rsync -a --exclude .git --exclude '/app/target' --exclude '/app/.exact' --exclude '/shell/build' "$here/" "$mac:$folder/"
if [ -z "${BUILT:-}" ]; then
  echo "building for the simulator on the Mac"
  ssh "$mac" "SIM=1 HEX_URL='$HEX_URL' HEX_TOKEN='$HEX_TOKEN' EXACT_CHANNEL='$url/updates' $folder/scripts/build" </dev/null | tail -1
fi

ssh "$mac" bash -s -- "$folder" "$POSES" "$APPEARANCES" "${paths[@]}" <<'MAC'
set -euo pipefail
folder=$1 poses=$2 appearances=$3
shift 3
. ~/$folder/scripts/mac-env
# The Duo simulator runs iOS 27.1, which Xcode-beta carries.
export DEVELOPER_DIR=/Applications/Xcode-beta.app/Contents/Developer
app=$HOME/Developer/hex-exact-build/sim/Build/Products/Release-iphonesimulator/HexExact.app
out=$HOME/Developer/hex-exact-build/shots
rm -rf "$out" && mkdir -p "$out"
id=$(xcrun simctl list devices -j | jq -r '[.devices[][] | select(.name == "hexexact Duo")][0].udid // empty')
if [ -z "$id" ]; then
  runtime=$(xcrun simctl list runtimes -j | jq -r '[.runtimes[] | select(.name == "iOS 27.1")][0].identifier')
  id=$(xcrun simctl create "hexexact Duo" "iPhone Duo" "$runtime")
fi
xcrun simctl boot "$id" 2>/dev/null || true
xcrun simctl bootstatus "$id" -b >/dev/null
xcrun simctl status_bar "$id" override --time 9:41 --batteryLevel 100 --cellularBars 4 2>/dev/null || true
hub=~/$folder/scripts/devicehub-sim
[ "$hub" -nt ~/$folder/scripts/devicehub.c ] || {
  xcrun -sdk iphonesimulator clang -arch arm64 -mios-simulator-version-min=27.0 -O2 -o "$hub" \
    ~/$folder/scripts/devicehub.c -framework IOKit -framework CoreFoundation
  codesign -f -s - "$hub" 2>/dev/null
}
hubdo() { xcrun simctl spawn "$id" "$hub" "$@" </dev/null; }
xcrun simctl terminate "$id" com.shahidy.hexexact 2>/dev/null || true
xcrun simctl install "$id" "$app"
hinge_at=
for pose in $poses; do
  case ${pose%-*} in cover) hinge=0 display=1 ;; open) hinge=180 display=3 ;; *) hinge=${pose%-*} display=3 ;; esac
  case ${pose##*-} in up) orientation=portrait ;; side) orientation=landscape-right ;; esac
  if [ "$hinge" != "$hinge_at" ]; then
    hubdo hinge "$hinge" "${hinge_at:-$([ "$hinge" -gt 90 ] && echo 0 || echo 180)}"
    sleep 3
    hinge_at=$hinge
  fi
  hubdo orientation "$orientation"; sleep 1; hubdo orientation "$orientation"
  for appearance in $appearances; do
    xcrun simctl ui "$id" appearance "$appearance"
    xcrun simctl launch --terminate-running-process "$id" com.shahidy.hexexact >/dev/null
    sleep 4
    for path in "$@"; do
      xcrun simctl openurl "$id" "hexexact://go$path"
      sleep 3
      name=$(echo "${path#/}" | tr '/:' '__'); name=${name:-home}
      xcrun simctl io "$id" screenshot --display=$display "$out/$name-$pose-$appearance.png" >/dev/null 2>&1
    done
  done
done
xcrun simctl terminate "$id" com.shahidy.hexexact 2>/dev/null || true
MAC
rsync -a "$mac:Developer/hex-exact-build/shots/" "$shots/"
ls "$shots"
